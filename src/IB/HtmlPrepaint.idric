module IB.HtmlPrepaint

import Data.List
import Data.Text
import IB.Information
import IB.RecoveredInformation
import IB.Strand
import IB.Prepaint
import IB.Prepaint.Version1
import IB.HtmlLinks
import IB.SourceDecoding

-- Bounded by caller/admission; explicit conversion failures are returned.

-- A producer supplies this ONLY after checking the exact committed Arena range.
-- Claimed and reopened digest/length are independent inputs, not a hash of an
-- unverified String. Source admission and byte-level SHA-256 belong to Grease /
-- the canonical Arena reader; semantic extraction belongs here.
public export
record HtmlEvidence where
  constructor HtmlSourceEvidence
  source_key : String
  source_generation : String
  claimed_sha256 : String
  reopened_sha256 : String
  claimed_bytes : Integer
  reopened_bytes : Integer
  requested_url : String
  resolved_url : String
  mime_type : String
  charset : String
  http_status : String
  utf8_decoded : Bool
  fully_acquired : Bool

-- A browser serialization is its own immutable source. These observations
-- describe the UTF-8 DOM serialization, never a browser HTTP response body.
public export
record BrowserDomEvidence where
  constructor BrowserDomSourceEvidence
  source_key : Text
  source_generation : Text
  claimed_sha256 : Text
  reopened_sha256 : Text
  claimed_bytes : Integer
  reopened_bytes : Integer
  requested_url : Text
  resolved_url : Text
  parent_source_key : Text
  parent_source_generation : Text
  parent_source_sha256 : Text
  provider_package : Text
  provider_version : Text
  serialization : Text
  utf8_verified : Bool
  fully_serialized : Bool

public export
data HtmlSourceProvenance
  = OriginalIcuResponse HtmlEvidence
  | RenderedBrowserDom BrowserDomEvidence

-- Extraction and view preparation need source identity and provenance. HTTP
-- observations remain in their original receipt; DOM sources have no invented
-- HTTP status, MIME response, original network offsets or redirect chain.
public export
record HtmlSourceIdentity where
  constructor VerifiedHtmlSourceIdentity
  source_key : Text
  source_generation : Text
  claimed_sha256 : Text
  reopened_sha256 : Text
  requested_url : Text
  resolved_url : Text
  provenance : HtmlSourceProvenance

original_identity : HtmlEvidence → HtmlSourceIdentity
original_identity evidence = VerifiedHtmlSourceIdentity evidence.source_key
  evidence.source_generation evidence.claimed_sha256 evidence.reopened_sha256
  evidence.requested_url evidence.resolved_url (OriginalIcuResponse evidence)

dom_identity : BrowserDomEvidence → HtmlSourceIdentity
dom_identity evidence = VerifiedHtmlSourceIdentity evidence.source_key
  evidence.source_generation evidence.claimed_sha256 evidence.reopened_sha256
  evidence.requested_url evidence.resolved_url (RenderedBrowserDom evidence)

public export
record PendingImage where
  constructor NeedImageAcquisition
  image_url : String
  alternate : String
  caption : String
  image_source_key : String

public export
record HtmlPrepaintResult where
  constructor MadeHtmlPrepaint
  evidence : HtmlSourceIdentity
  recovered : RecoveredDocumentLog
  information : InformationView
  strand : Strand
  revision : PrepaintRevision
  wire : String
  pending_images : List PendingImage
  limitations : List String
  decoding : Maybe HtmlDecodedText

is_hex_character : Char → Bool
is_hex_character character =
  let number : Integer = cast (ord character) in
  (number >= 48 && number <= 57) || (number >= 97 && number <= 102)

is_digest : String → Bool
is_digest value =
  length (unpack value) == 64 && all is_hex_character (unpack value)

metadata_safe : String → Bool
metadata_safe value =
  value /= "" && length (unpack value) <= 256 &&
  not (elem '\t' (unpack value)) &&
  not (elem '\n' (unpack value)) &&
  not (elem '\r' (unpack value))

source_identity_reason : HtmlEvidence → Maybe String
source_identity_reason e =
  if not (metadata_safe e.source_key) || not (metadata_safe e.source_generation)
    then Just "bad-source-identity"
  else if not (is_digest e.claimed_sha256) || e.claimed_sha256 /= e.reopened_sha256
    then Just "missing-or-mismatched-sha256"
  else if e.claimed_bytes <= 0 || e.claimed_bytes > 4194304 ||
    e.claimed_bytes /= e.reopened_bytes
    then Just "bad-reopened-byte-count"
  else if e.mime_type /= "text/html" &&
    e.mime_type /= "text/html; charset=utf-8" &&
    e.mime_type /= "text/html; charset=UTF-8"
    then Just "unsupported-mime"
  else if e.http_status /= "200"
    then Just "unadmitted-http-status"
  else if not e.fully_acquired
    then Just "incomplete-or-stale-source"
  else if not (cheap_http_url e.requested_url) || not (cheap_http_url e.resolved_url)
    then Just "unverified-requested-or-resolved-url"
  else Nothing

public export
source_admission_reason : HtmlEvidence → Maybe String
source_admission_reason evidence =
  case source_identity_reason evidence of
    Just reason ⇒ Just reason
    Nothing ⇒
      if evidence.charset /= "utf-8" && evidence.charset /= "UTF-8"
        then Just "unsupported-charset"
      else if not evidence.utf8_decoded then Just "invalid-utf8"
      else Nothing

first_html_base : List DocumentEvent → Maybe String
first_html_base [] = Nothing
first_html_base (StartTag "base" tag :: events) =
  case attribute_value "href" tag of
    Nothing ⇒ first_html_base events
    Just value ⇒ Just (decode_html_entities value)
first_html_base (_ :: events) = first_html_base events

link_base : String → RecoveredDocumentLog → (String, List String)
link_base resolved log =
  case first_html_base (document_log_events log) of
    Nothing ⇒ (resolved, [])
    Just href ⇒
      case resolve_html_reference resolved href of
        Nothing ⇒ (resolved, ["unsupported-html-base"])
        Just value ⇒ (value, [])

heading_number : String → Maybe HeadingLevel
heading_number "h1" = heading_level 1
heading_number "h2" = heading_level 2
heading_number "h3" = heading_level 3
heading_number "h4" = heading_level 4
heading_number "h5" = heading_level 5
heading_number "h6" = heading_level 6
heading_number _ = Nothing

checked_link : String → String → String →
  (List InformationBlock, List String)
checked_link base label href =
  case resolve_html_reference base href of
    Nothing ⇒ ([IB.Strand.TextBlock label], ["unusable-link:" ++ href])
    Just url ⇒
      case link_reference url of
        Nothing ⇒ ([IB.Strand.TextBlock label], ["empty-link"])
        Just ref ⇒ ([IB.Strand.Link label ref], [])

request_image : HtmlSourceIdentity → String → String → String → String → List PendingImage
request_image evidence base address alternate caption =
  case resolve_html_reference base address of
    Nothing ⇒ []
    Just absolute_address ⇒
      [NeedImageAcquisition absolute_address alternate caption evidence.source_key]

image_limitations : String → List PendingImage → List String
image_limitations original [] = ["unsupported-image-reference:" ++ original]
image_limitations original (_ :: _) = ["image-requires-separate-admission:" ++ original]

image_navigation : String → String → String →
  (List InformationBlock, List String)
image_navigation base label "" = ([], [])
image_navigation base label target = checked_link base label target

map_item : HtmlSourceIdentity → String → InformationItem →
  (List InformationBlock, List PendingImage, List String)
map_item e base (IB.Information.Heading text) =
  ([IB.Strand.Heading Heading1 text], [], ["legacy-heading-level-unknown"])
map_item e base (HeadingAt name text) =
  case heading_number name of
    Nothing ⇒ ([IB.Strand.TextBlock text], [], ["invalid-heading-level"])
    Just level ⇒ ([IB.Strand.Heading level text], [], [])
map_item e base (IB.Information.TextBlock text) =
  ([IB.Strand.TextBlock text], [], [])
map_item e base (FigureCaption caption) =
  ([IB.Strand.TextBlock ("Figure caption: " ++ caption)], [],
   ["orphaned-figure-caption"])
map_item e base (IB.Information.Link text href) =
  let (blocks, notes) = checked_link base text href in
  (blocks, [], notes)
map_item e base (IB.Information.Form description action) =
  ([IB.Strand.TextBlock ("Form (submission unavailable): " ++ description)],
   [], ["form-submission-unavailable:" ++ action])
map_item e base (IB.Information.TableRow []) =
  ([], [], ["empty-table-row"])
map_item e base (IB.Information.TableRow (first :: cells)) =
  ([IB.Strand.TableRow (table_row first cells)], [], [])
map_item e base (IB.Information.Image url alt caption destination) =
  let text = if alt == "" then "Unretrieved image" else alt in
  let label = if caption == "" then text else text ++ " — " ++ caption in
  let pending = request_image e base url alt caption in
  let image_notes = image_limitations url pending in
  let (linked, link_notes) = image_navigation base label destination in
  (IB.Strand.TextBlock ("Image pending acquisition: " ++ label) :: linked,
   pending, image_notes ++ link_notes)

map_items : HtmlSourceIdentity → String → List InformationItem →
  (List InformationBlock, List PendingImage, List String)
map_items e base [] = ([], [], [])
map_items e base
  (IB.Information.Image source alt caption target :: FigureCaption figure_text :: rest) =
  let effective_caption = if figure_text == "" then caption else figure_text in
  let (blocks, images, notes) =
    map_item e base (IB.Information.Image source alt effective_caption target) in
  let (other_blocks, other_images, other_notes) = map_items e base rest in
  (blocks ++ other_blocks, images ++ other_images, notes ++ other_notes)
map_items e base (item :: rest) =
  let (block, images, notes) = map_item e base item in
  let (other_blocks, other_images, other_notes) = map_items e base rest in
  (block ++ other_blocks, images ++ other_images, notes ++ other_notes)

unsupported_event : DocumentEvent → List String
unsupported_event (StartTag name _) =
  if elem name ["script", "style", "template", "canvas", "video",
                "audio", "svg", "iframe", "object"]
    then ["excluded-or-unsupported-element:" ++ name] else []
unsupported_event _ = []

unsupported_events : List DocumentEvent → List String
unsupported_events [] = []
unsupported_events (event :: rest) =
  unsupported_event event ++ unsupported_events rest

source_reference_text : HtmlSourceIdentity → String
source_reference_text evidence =
  evidence.source_key ++ ";generation=" ++ evidence.source_generation ++
  ";sha256=" ++ evidence.claimed_sha256 ++ case evidence.provenance of
    OriginalIcuResponse _ ⇒ ""
    RenderedBrowserDom _ ⇒ ";representation=browser-rendered-dom"

make_html_strand : HtmlSourceIdentity → Maybe HtmlDecodedText → InformationView →
  List InformationBlock → Maybe Strand
make_html_strand evidence decoding view blocks = do
  let representation = case decoding of
        Nothing ⇒ ""
        Just decoded ⇒ ";decoder=" ++ decoder_identity ++ ";encoding=" ++ decoded.selected_encoding
  source_id ← nonempty_text (source_reference_text evidence ++ representation)
  requested ← requested_address evidence.requested_url
  resolved ← resolved_address evidence.resolved_url
  let origin = case evidence.provenance of
        RenderedBrowserDom _ ⇒ DerivedSource
        OriginalIcuResponse _ ⇒ case decoding of
          Nothing ⇒ HtmlSource
          Just _ ⇒ DerivedSource
  let source = Source source_id origin CompleteSource
  let heading_title = if view_title view == "" then Nothing else Just (view_title view)
  pure (MakeStrand source requested resolved heading_title blocks)

extract_verified_source : HtmlSourceIdentity → Maybe HtmlDecodedText → String → Either String HtmlPrepaintResult
extract_verified_source admission decoding html =
      let log = recover_document_log admission.source_key html in
      let view = information_from_log admission.requested_url admission.resolved_url log in
      let (base, base_notes) = link_base admission.resolved_url log in
      let (blocks, images, notes) = map_items admission base (view_items view) in
      if length blocks > 4096
        then Left "prepaint-block-budget-exceeded"
        else
          case make_html_strand admission decoding view blocks of
            Nothing ⇒ Left "invalid-source-strand"
            Just strand ⇒
              let revision = prepaint_from_strand first_revision CompleteRevision strand in
              case serialize_version1 [revision] of
                Nothing ⇒ Left "version1-serialization-refused"
                Just wire ⇒
                  Right (MadeHtmlPrepaint admission log view strand revision wire
                    images (base_notes ++ notes ++
                    unsupported_events (document_log_events log)) decoding)

-- Reuse the exact semantic folding when a checked decoded-item coordinate
-- needs the corresponding retained Prepaint block occurrence.
export
html_item_block_position : HtmlPrepaintResult → Number → Maybe Number
html_item_block_position result position =
  let items = view_items result.information in
  if position >= length items then Nothing
  else let (base, _) = link_base result.evidence.resolved_url result.recovered
           (preceding_blocks, _, _) = map_items result.evidence base (take position items) in
       Just (length preceding_blocks)

public export
convert_admitted_html : HtmlEvidence → String → Either String HtmlPrepaintResult
convert_admitted_html admission html =
  case source_admission_reason admission of
    Just refusal ⇒ Left refusal
    Nothing ⇒ extract_verified_source (original_identity admission) Nothing html

-- The original receipt remains unchanged. A decoded derivative can enter
-- Prepaint only after every source/HTTP/completeness check and the maintained
-- decoder agree about its original encoding and exact byte count.
public export
convert_committed_html_octets : HtmlEvidence → List SourceOctet → Either String HtmlPrepaintResult
convert_committed_html_octets admission octets = do
  case source_identity_reason admission of
    Just refusal ⇒ Left refusal
    Nothing ⇒ Right ()
  decoded ← decode_html_bytes admission.charset octets
  if cast decoded.original_byte_count /= admission.reopened_bytes
    then Left "decoded-original-byte-count-mismatch"
    else extract_verified_source (original_identity admission) (Just decoded) decoded.decoded_text

dom_generation : Text → Bool
dom_generation value = value /= "" && value /= "0" &&
  all (\character ⇒ character >= '0' && character <= '9') (unpack value) &&
  take 1 (unpack value) /= ['0'] &&
  (length (unpack value) < 10 || (length (unpack value) ≟ 10 && value <= "2147483647"))

source_prefix : Text → Text → Bool
source_prefix prefix value = take (length (unpack prefix)) (unpack value) ≟ unpack prefix

dom_scalar : Char → Bool
dom_scalar character = ord character < 0xD800 ||
  (ord character > 0xDFFF && ord character <= 0x10FFFF)

scalar_utf8_bytes : Char → Number
scalar_utf8_bytes character = if ord character < 128 then 1
  else if ord character < 2048 then 2 else if ord character < 65536 then 3 else 4

export
browser_dom_admission_reason : BrowserDomEvidence → Text → Maybe Text
browser_dom_admission_reason evidence dom =
  if not (metadata_safe evidence.source_key) || not (source_prefix "arena-dom:" evidence.source_key) ||
     not (metadata_safe evidence.parent_source_key) || not (source_prefix "arena:" evidence.parent_source_key) ||
     not (dom_generation evidence.source_generation) ||
     evidence.source_generation /= evidence.parent_source_generation
    then Just "bad-rendered-source-identity"
  else if not (is_digest evidence.claimed_sha256) || evidence.claimed_sha256 /= evidence.reopened_sha256 ||
          not (is_digest evidence.parent_source_sha256)
    then Just "rendered-source-digest-mismatch"
  else if evidence.claimed_bytes <= 0 || evidence.claimed_bytes > 2097152 ||
          evidence.claimed_bytes /= evidence.reopened_bytes ||
          cast (sum (map scalar_utf8_bytes (unpack dom))) /= evidence.reopened_bytes
    then Just "rendered-source-byte-count-mismatch"
  else if not evidence.utf8_verified || not (all dom_scalar (unpack dom)) ||
          not evidence.fully_serialized || evidence.serialization /= "webview-content-outerHTML-utf8-v1"
    then Just "incomplete-or-unsupported-DOM-serialization"
  else if not (metadata_safe evidence.provider_package) || not (metadata_safe evidence.provider_version) ||
          not (cheap_http_url evidence.requested_url) || not (cheap_http_url evidence.resolved_url)
    then Just "unobserved-DOM-provider-or-address"
  else Nothing

export
convert_committed_browser_dom : BrowserDomEvidence → Text → Either Text HtmlPrepaintResult
convert_committed_browser_dom evidence dom = case browser_dom_admission_reason evidence dom of
  Just reason ⇒ Left reason
  Nothing ⇒ extract_verified_source (dom_identity evidence) Nothing dom

verified_utf8_identity : HtmlEvidence → Text → Either Text HtmlSourceIdentity
verified_utf8_identity evidence carrier = do
  case source_admission_reason evidence of
    Just reason ⇒ Left reason
    Nothing ⇒ Right ()
  if not (all dom_scalar (unpack carrier)) ||
     cast (sum (map scalar_utf8_bytes (unpack carrier))) /= evidence.reopened_bytes
    then Left "decoded-original-byte-count-mismatch"
    else Right (original_identity evidence)

verified_legacy_identity : HtmlEvidence → Text → Either Text HtmlSourceIdentity
verified_legacy_identity evidence carrier = do
  octets ← source_octet_carrier carrier
  decoded ← decode_html_bytes evidence.charset octets
  if cast decoded.original_byte_count /= evidence.reopened_bytes
    then Left "decoded-original-byte-count-mismatch"
    else Right (original_identity evidence)

-- Verify a retained HTTP representation without building another view. This
-- keeps Google link resolution bound to actual ICU bytes and the same status,
-- MIME, charset, completeness and digest checks used by the ordinary reader.
export
verify_committed_html_representation : HtmlEvidence → Text → Either Text HtmlSourceIdentity
verify_committed_html_representation evidence carrier = do
  case source_identity_reason evidence of
    Just reason ⇒ Left reason
    Nothing ⇒ Right ()
  if evidence.charset ≟ "utf-8" || evidence.charset ≟ "UTF-8"
    then verified_utf8_identity evidence carrier
    else if not (windows_1252_label evidence.charset) then Left "unsupported-charset"
      else verified_legacy_identity evidence carrier
