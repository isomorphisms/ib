module IB.HtmlPrepaint

import IB.Information
import IB.RecoveredInformation
import IB.Strand
import IB.Prepaint
import IB.Prepaint.Version1
import IB.HtmlLinks

-- Bounded by caller/admission; explicit conversion failures are returned.

-- A producer supplies this ONLY after checking the exact committed Arena range.
-- Claimed and reopened digest/length are independent inputs, not a hash of an
-- unverified String. Source admission and byte-level SHA-256 belong to Grease /
-- the canonical Arena reader; semantic extraction belongs here.
public export
record HtmlEvidence where
  constructor HtmlSourceEvidence
  source_key : String
  source_generation : String
  claimed_sha256 : String
  reopened_sha256 : String
  claimed_bytes : Integer
  reopened_bytes : Integer
  requested_url : String
  resolved_url : String
  mime_type : String
  charset : String
  http_status : String
  utf8_decoded : Bool
  fully_acquired : Bool

public export
record PendingImage where
  constructor NeedImageAcquisition
  image_url : String
  alternate : String
  caption : String
  image_source_key : String

public export
record HtmlPrepaintResult where
  constructor MadeHtmlPrepaint
  evidence : HtmlEvidence
  recovered : RecoveredDocumentLog
  information : InformationView
  strand : Strand
  revision : PrepaintRevision
  wire : String
  pending_images : List PendingImage
  limitations : List String

is_hex_character : Char → Bool
is_hex_character character =
  let number : Integer = cast (ord character) in
  (number >= 48 && number <= 57) || (number >= 97 && number <= 102)

is_digest : String → Bool
is_digest value =
  length (unpack value) == 64 && all is_hex_character (unpack value)

metadata_safe : String → Bool
metadata_safe value =
  value /= "" && length (unpack value) <= 256 &&
  not (elem '\t' (unpack value)) &&
  not (elem '\n' (unpack value)) &&
  not (elem '\r' (unpack value))

public export
source_admission_reason : HtmlEvidence → Maybe String
source_admission_reason e =
  if not (metadata_safe e.source_key) || not (metadata_safe e.source_generation)
    then Just "bad-source-identity"
  else if not (is_digest e.claimed_sha256) || e.claimed_sha256 /= e.reopened_sha256
    then Just "missing-or-mismatched-sha256"
  else if e.claimed_bytes <= 0 || e.claimed_bytes > 4194304 ||
    e.claimed_bytes /= e.reopened_bytes
    then Just "bad-reopened-byte-count"
  else if e.mime_type /= "text/html" &&
    e.mime_type /= "text/html; charset=utf-8" &&
    e.mime_type /= "text/html; charset=UTF-8"
    then Just "unsupported-mime"
  else if e.charset /= "utf-8" && e.charset /= "UTF-8"
    then Just "unsupported-charset"
  else if e.http_status /= "200"
    then Just "unadmitted-http-status"
  else if not e.utf8_decoded
    then Just "invalid-utf8"
  else if not e.fully_acquired
    then Just "incomplete-or-stale-source"
  else if not (cheap_http_url e.requested_url) || not (cheap_http_url e.resolved_url)
    then Just "unverified-requested-or-resolved-url"
  else Nothing

first_html_base : List DocumentEvent → Maybe String
first_html_base [] = Nothing
first_html_base (StartTag "base" tag :: events) =
  case attribute_value "href" tag of
    Nothing ⇒ first_html_base events
    Just value ⇒ Just (decode_html_entities value)
first_html_base (_ :: events) = first_html_base events

link_base : String → RecoveredDocumentLog → (String, List String)
link_base resolved log =
  case first_html_base (document_log_events log) of
    Nothing ⇒ (resolved, [])
    Just href ⇒
      case resolve_html_reference resolved href of
        Nothing ⇒ (resolved, ["unsupported-html-base"])
        Just value ⇒ (value, [])

heading_number : String → Maybe HeadingLevel
heading_number "h1" = heading_level 1
heading_number "h2" = heading_level 2
heading_number "h3" = heading_level 3
heading_number "h4" = heading_level 4
heading_number "h5" = heading_level 5
heading_number "h6" = heading_level 6
heading_number _ = Nothing

checked_link : String → String → String →
  (List InformationBlock, List String)
checked_link base label href =
  case resolve_html_reference base href of
    Nothing ⇒ ([IB.Strand.TextBlock label], ["unusable-link:" ++ href])
    Just url ⇒
      case link_reference url of
        Nothing ⇒ ([IB.Strand.TextBlock label], ["empty-link"])
        Just ref ⇒ ([IB.Strand.Link label ref], [])

request_image : HtmlEvidence → String → String → String → String → List PendingImage
request_image evidence base address alternate caption =
  case resolve_html_reference base address of
    Nothing ⇒ []
    Just absolute_address ⇒
      [NeedImageAcquisition absolute_address alternate caption evidence.source_key]

image_limitations : String → List PendingImage → List String
image_limitations original [] = ["unsupported-image-reference:" ++ original]
image_limitations original (_ :: _) = ["image-requires-separate-admission:" ++ original]

image_navigation : String → String → String →
  (List InformationBlock, List String)
image_navigation base label "" = ([], [])
image_navigation base label target = checked_link base label target

map_item : HtmlEvidence → String → InformationItem →
  (List InformationBlock, List PendingImage, List String)
map_item e base (IB.Information.Heading text) =
  ([IB.Strand.Heading Heading1 text], [], ["legacy-heading-level-unknown"])
map_item e base (HeadingAt name text) =
  case heading_number name of
    Nothing ⇒ ([IB.Strand.TextBlock text], [], ["invalid-heading-level"])
    Just level ⇒ ([IB.Strand.Heading level text], [], [])
map_item e base (IB.Information.TextBlock text) =
  ([IB.Strand.TextBlock text], [], [])
map_item e base (FigureCaption caption) =
  ([IB.Strand.TextBlock ("Figure caption: " ++ caption)], [],
   ["orphaned-figure-caption"])
map_item e base (IB.Information.Link text href) =
  let (blocks, notes) = checked_link base text href in
  (blocks, [], notes)
map_item e base (IB.Information.Form description action) =
  ([IB.Strand.TextBlock ("Form (submission unavailable): " ++ description)],
   [], ["form-submission-unavailable:" ++ action])
map_item e base (IB.Information.TableRow []) =
  ([], [], ["empty-table-row"])
map_item e base (IB.Information.TableRow (first :: cells)) =
  ([IB.Strand.TableRow (table_row first cells)], [], [])
map_item e base (IB.Information.Image url alt caption destination) =
  let text = if alt == "" then "Unretrieved image" else alt in
  let label = if caption == "" then text else text ++ " — " ++ caption in
  let pending = request_image e base url alt caption in
  let image_notes = image_limitations url pending in
  let (linked, link_notes) = image_navigation base label destination in
  (IB.Strand.TextBlock ("Image pending acquisition: " ++ label) :: linked,
   pending, image_notes ++ link_notes)

map_items : HtmlEvidence → String → List InformationItem →
  (List InformationBlock, List PendingImage, List String)
map_items e base [] = ([], [], [])
map_items e base
  (IB.Information.Image source alt caption target :: FigureCaption figure_text :: rest) =
  let effective_caption = if figure_text == "" then caption else figure_text in
  let (blocks, images, notes) =
    map_item e base (IB.Information.Image source alt effective_caption target) in
  let (other_blocks, other_images, other_notes) = map_items e base rest in
  (blocks ++ other_blocks, images ++ other_images, notes ++ other_notes)
map_items e base (item :: rest) =
  let (block, images, notes) = map_item e base item in
  let (other_blocks, other_images, other_notes) = map_items e base rest in
  (block ++ other_blocks, images ++ other_images, notes ++ other_notes)

unsupported_event : DocumentEvent → List String
unsupported_event (StartTag name _) =
  if elem name ["script", "style", "template", "canvas", "video",
                "audio", "svg", "iframe", "object"]
    then ["excluded-or-unsupported-element:" ++ name] else []
unsupported_event _ = []

unsupported_events : List DocumentEvent → List String
unsupported_events [] = []
unsupported_events (event :: rest) =
  unsupported_event event ++ unsupported_events rest

make_html_strand : HtmlEvidence → InformationView →
  List InformationBlock → Maybe Strand
make_html_strand evidence view blocks = do
  source_id ← nonempty_text
    (evidence.source_key ++ ";generation=" ++ evidence.source_generation ++
     ";sha256=" ++ evidence.claimed_sha256)
  requested ← requested_address evidence.requested_url
  resolved ← resolved_address evidence.resolved_url
  let source = Source source_id HtmlSource CompleteSource
  let heading_title = if view_title view == "" then Nothing else Just (view_title view)
  pure (MakeStrand source requested resolved heading_title blocks)

public export
convert_admitted_html : HtmlEvidence → String → Either String HtmlPrepaintResult
convert_admitted_html admission html =
  case source_admission_reason admission of
    Just refusal ⇒ Left refusal
    Nothing ⇒
      let log = recover_document_log admission.source_key html in
      let view = information_from_log admission.requested_url admission.resolved_url log in
      let (base, base_notes) = link_base admission.resolved_url log in
      let (blocks, images, notes) = map_items admission base (view_items view) in
      if length blocks > 4096
        then Left "prepaint-block-budget-exceeded"
        else
          case make_html_strand admission view blocks of
            Nothing ⇒ Left "invalid-source-strand"
            Just strand ⇒
              let revision = prepaint_from_strand first_revision CompleteRevision strand in
              case serialize_version1 [revision] of
                Nothing ⇒ Left "version1-serialization-refused"
                Just wire ⇒
                  Right (MadeHtmlPrepaint admission log view strand revision wire
                    images (base_notes ++ notes ++
                    unsupported_events (document_log_events log)))
