module IB.WorkerLifecycle

import IB.LongViewTask

-- Durable work identity is browser-owned. A process attachment belongs to one
-- exact execution attempt. PID alone, or PID plus process-start identity alone,
-- is never enough to complete or mutate that attempt.

public export
choice worker_operation_class one_of
  restartable_bounded_observation
  nonreplayable_state_change

public export
choice worker_phase one_of
  worker_planned
  worker_running
  worker_result_committed
  worker_exited_without_result
  worker_failed
  worker_killed
  worker_authority_unavailable

public export
choice worker_recovery one_of
  no_restart_needed
  automatic_restart_allowed
  wait_for_authority
  manual_recovery_required

public export
record ProcessAttachment where
  constructor AttachedProcess
  launch_identity : DurableIdentity
  boot_identity : DurableIdentity
  process_uid : Integer
  process_id : Integer
  process_start_ticks : Integer
  process_name : DurableIdentity
  host_generation : Integer
  attempt_identity : DurableIdentity
  attempt_number : Integer

public export
record WorkerTask where
  constructor Worker
  work_identity : DurableIdentity
  result_identity : DurableIdentity
  operation_class : worker_operation_class
  maximum_attempts : Integer
  attempts_started : Integer
  phase : worker_phase
  attachment : Maybe ProcessAttachment
  committed_result : Bool

public export
plan_worker :
  DurableIdentity → DurableIdentity → worker_operation_class → Integer →
  Maybe WorkerTask
plan_worker work result operation maximum_attempts =
  if maximum_attempts > 0
    then Just (Worker work result operation maximum_attempts 0 worker_planned Nothing False)
    else Nothing

phase_allows_new_attempt : worker_phase → Bool
phase_allows_new_attempt worker_planned = True
phase_allows_new_attempt worker_exited_without_result = True
phase_allows_new_attempt worker_failed = True
phase_allows_new_attempt worker_killed = True
phase_allows_new_attempt _ = False

phase_can_resolve_attempt : worker_phase → Bool
phase_can_resolve_attempt worker_running = True
phase_can_resolve_attempt worker_authority_unavailable = True
phase_can_resolve_attempt _ = False

phase_is_running : worker_phase → Bool
phase_is_running worker_running = True
phase_is_running _ = False

public export
next_attempt_number : WorkerTask → Integer
next_attempt_number task = task.attempts_started + 1

public export
attach_worker_process :
  DurableIdentity → DurableIdentity → Integer → Integer → Integer →
  DurableIdentity → Integer → DurableIdentity → WorkerTask → Maybe WorkerTask
attach_worker_process launch boot uid pid start_ticks process_name host_generation
                      attempt task =
  if uid >= 0 &&
     pid > 1 &&
     start_ticks >= 0 &&
     host_generation >= 0 &&
     task.attempts_started < task.maximum_attempts &&
     not task.committed_result &&
     phase_allows_new_attempt task.phase
    then
      let attempt_number = next_attempt_number task in
        Just
          (Worker
            task.work_identity
            task.result_identity
            task.operation_class
            task.maximum_attempts
            attempt_number
            worker_running
            (Just
              (AttachedProcess
                launch
                boot
                uid
                pid
                start_ticks
                process_name
                host_generation
                attempt
                attempt_number))
            False)
    else Nothing

public export
attachment_matches : ProcessAttachment → ProcessAttachment → Bool
attachment_matches expected observed =
  identity_text expected.launch_identity == identity_text observed.launch_identity &&
  identity_text expected.boot_identity == identity_text observed.boot_identity &&
  expected.process_uid == observed.process_uid &&
  expected.process_id == observed.process_id &&
  expected.process_start_ticks == observed.process_start_ticks &&
  identity_text expected.process_name == identity_text observed.process_name &&
  expected.host_generation == observed.host_generation &&
  identity_text expected.attempt_identity == identity_text observed.attempt_identity &&
  expected.attempt_number == observed.attempt_number

current_attempt_matches : ProcessAttachment → WorkerTask → Bool
current_attempt_matches observed task =
  case task.attachment of
    Nothing ⇒ False
    Just expected ⇒ attachment_matches expected observed

worker_with_phase : worker_phase → WorkerTask → WorkerTask
worker_with_phase next_phase task =
  Worker
    task.work_identity
    task.result_identity
    task.operation_class
    task.maximum_attempts
    task.attempts_started
    next_phase
    task.attachment
    task.committed_result

public export
commit_worker_result : ProcessAttachment → WorkerTask → Maybe WorkerTask
commit_worker_result observed task =
  if current_attempt_matches observed task &&
     not task.committed_result &&
     (case task.phase of
        worker_running ⇒ True
        worker_authority_unavailable ⇒ True
        _ ⇒ False)
    then
      Just
        (Worker
          task.work_identity
          task.result_identity
          task.operation_class
          task.maximum_attempts
          task.attempts_started
          worker_result_committed
          task.attachment
          True)
    else Nothing

public export
worker_exited : ProcessAttachment → Bool → WorkerTask → Maybe WorkerTask
worker_exited observed successful task =
  if current_attempt_matches observed task && phase_can_resolve_attempt task.phase
    then
      if task.committed_result
        then Just (worker_with_phase worker_result_committed task)
        else if successful
          then Just (worker_with_phase worker_exited_without_result task)
          else Just (worker_with_phase worker_failed task)
    else Nothing

public export
worker_was_killed : ProcessAttachment → WorkerTask → Maybe WorkerTask
worker_was_killed observed task =
  if current_attempt_matches observed task && phase_can_resolve_attempt task.phase
    then
      if task.committed_result
        then Just (worker_with_phase worker_result_committed task)
        else Just (worker_with_phase worker_killed task)
    else Nothing

public export
worker_authority_was_lost : ProcessAttachment → WorkerTask → Maybe WorkerTask
worker_authority_was_lost observed task =
  if current_attempt_matches observed task
    then
      if task.committed_result
        then Just (worker_with_phase worker_result_committed task)
        else if phase_is_running task.phase
          then Just (worker_with_phase worker_authority_unavailable task)
          else Nothing
    else Nothing

public export
recovery_for : WorkerTask → worker_recovery
recovery_for task =
  if task.committed_result
    then no_restart_needed
    else
      case task.phase of
        worker_authority_unavailable ⇒ wait_for_authority
        _ ⇒
          case task.operation_class of
            nonreplayable_state_change ⇒ manual_recovery_required
            restartable_bounded_observation ⇒
              if task.attempts_started < task.maximum_attempts
                then automatic_restart_allowed
                else manual_recovery_required

-- Frontend/rish caller lifetime is not durable task state. Disconnecting a
-- caller therefore does not mutate the task or manufacture a failure.
public export
caller_disconnected : WorkerTask → WorkerTask
caller_disconnected task = task

public export
same_worker_identity : WorkerTask → WorkerTask → Bool
same_worker_identity before after =
  identity_text before.work_identity == identity_text after.work_identity &&
  identity_text before.result_identity == identity_text after.result_identity
