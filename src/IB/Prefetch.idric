module IB.Prefetch

%default total

public export
choice prefetch_retention one_of
  transient_cache
  reading_corpus

public export
prefetch_retention_text : prefetch_retention → String
prefetch_retention_text transient_cache = "transient"
prefetch_retention_text reading_corpus = "reading"

public export
data PrefetchTarget = Target String prefetch_retention

public export
prefetch_target_url : PrefetchTarget → String
prefetch_target_url (Target url _) = url

public export
prefetch_target_retention : PrefetchTarget → prefetch_retention
prefetch_target_retention (Target _ retention) = retention

remove_target_url : String → List PrefetchTarget → List PrefetchTarget
remove_target_url wanted [] = []
remove_target_url wanted (target :: rest) =
  if prefetch_target_url target == wanted
    then remove_target_url wanted rest
    else target :: remove_target_url wanted rest

public export
deduplicate_prefetch_targets : List PrefetchTarget → List PrefetchTarget
deduplicate_prefetch_targets [] = []
deduplicate_prefetch_targets (target :: rest) =
  target :: deduplicate_prefetch_targets (remove_target_url (prefetch_target_url target) rest)

take_prefetch_targets : Nat → List PrefetchTarget → List PrefetchTarget
take_prefetch_targets Z _ = []
take_prefetch_targets (S remaining) [] = []
take_prefetch_targets (S remaining) (target :: rest) =
  target :: take_prefetch_targets remaining rest

-- Callers supply targets in priority order.  The core removes duplicate URLs
-- and enforces the caller's resource budget without inventing crawl policy.
public export
bounded_prefetch : Nat → List PrefetchTarget → List PrefetchTarget
bounded_prefetch budget targets =
  take_prefetch_targets budget (deduplicate_prefetch_targets targets)

public export
reading_target_count : List PrefetchTarget → Nat
reading_target_count [] = 0
reading_target_count (target :: rest) =
  case prefetch_target_retention target of
    transient_cache => reading_target_count rest
    reading_corpus => S (reading_target_count rest)
