module IB.Reflow.Arithmetic

-- Number is the maintained nonnegative whole-number surface. Subtracting
-- directly via (-) requires a Neg instance the pinned compiler does not have
-- for Number. This saturating difference is total, explicit and portable.
-- It is a correctness baseline, not a target-specific fast subtraction.
public export
nonnegative_difference : Number → Number → Number
nonnegative_difference amount Z = amount
nonnegative_difference Z (S taken) = Z
nonnegative_difference (S amount) (S taken) =
  nonnegative_difference amount taken
