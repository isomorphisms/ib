module IB.Reflow.Balanced

import Data.Text

-- Optimize the entire paragraph rather than deciding each break immediately.
-- Each suffix keeps its best known layout; candidate breaks are tested against
-- those suffixes. The quadratic number of candidate breaks and retained plans
-- cost more time/memory than greedy reflow, especially with Text concatenation.
-- The metric is total squared unused width, INCLUDING the final line.
-- Use the pinned compiler's executable ASCII arithmetic operators here;
-- Unicode minus/multiply remain an Idriç frontend compatibility gap.
-- Unbreakable overwide segments are kept intact and incur zero slack penalty;
-- their overrun must be dealt with by the rendering boundary, not clipped here.
record LinePlan where
  constructor Planned
  penalty : Number
  lines : List Text

unused_width : Number → Number → Number
unused_width available used =
  if used <= available then available - used else 0

candidate : (Text → Number) → Number → Text → LinePlan → LinePlan
candidate measure width line (Planned tail_penalty tail_lines) =
  let slack = unused_width width (measure line) in
  Planned (slack * slack + tail_penalty) (line :: tail_lines)

prefer : LinePlan → LinePlan → LinePlan
prefer first second =
  if first.penalty <= second.penalty then first else second

-- The suffix plans align with the remaining input segments. An equal-cost
-- choice retains the earlier (shorter first-line) candidate deterministically.
consider_longer : (Text → Number) → Number → Text → List Text →
  List LinePlan → LinePlan → LinePlan
consider_longer measure width current [] plans best = best
consider_longer measure width current words [] best = best
consider_longer measure width current (next :: rest) (tail :: tails) best =
  let extended = current ++ " " ++ next in
  let updated = if measure extended <= width
    then prefer best (candidate measure width extended tail)
    else best in
  -- An arbitrary shaped width metric might not be monotone. Keep checking.
  consider_longer measure width extended rest tails updated

-- This is an executable suffix dynamic program, not an exponential search.
-- The first plan in the returned list is for the full supplied suffix.
suffix_plans : (Text → Number) → Number → List Text → List LinePlan
suffix_plans measure width [] = [Planned 0 []]
suffix_plans measure width (first :: rest) =
  case suffix_plans measure width rest of
    [] ⇒ []
    tail :: later ⇒
      let initial = candidate measure width first tail in
      let best = consider_longer measure width first rest later initial in
      best :: tail :: later

public export
reflow_balanced : (Text → Number) → Number → List Text → List Text
reflow_balanced measure width segments =
  case suffix_plans measure width segments of
    [] ⇒ []
    (Planned _ lines) :: _ ⇒ lines
