module IB.Reflow.SourceBreaks

import Data.Text
import IB.Reflow.Arithmetic

-- A source-bound list of possible line breaks. Offsets count decoded Unicode
-- code points (elements of unpack), NOT UTF-8 bytes, UTF-16 units or glyphs.
-- A break is the position immediately AFTER source_offset characters.
-- The source text itself remains canonical. No renderer output is reparsed.
public export
data BreakKind
  = PossibleBreak
  | MandatoryBreak
  | DiscretionaryHyphen
  | ZeroWidthBreak
  | SourceEnd

public export
record SourceBreak where
  constructor At
  source_offset : Number
  break_kind : BreakKind

public export
record SourceLine where
  constructor FromSource
  first_codepoint : Number
  after_last_codepoint : Number
  visible_text : Text
  ending : BreakKind

is_han : Char → Bool
is_han value =
  let number = ord value in
  (number >= 19968 && number <= 40959) ||
  (number >= 13312 && number <= 19903)

-- Deliberately bounded Unicode tailoring, NOT the complete UAX #14.
-- ASCII SPACE, ZERO WIDTH SPACE, SOFT HYPHEN, hard line endings and selected
-- Han–Han boundaries produce candidates. NBSP/WORD JOINER and emoji ZWJ do
-- not generate breaks. Complete Unicode/locale break data can supply an
-- independently qualified list of SourceBreak values to the same solver.
hard_line_end : Char → List Char → Bool
hard_line_end '\r' ('\n' :: _) = False
hard_line_end '\r' _ = True
hard_line_end '\n' _ = True
hard_line_end value _ =
  let number = ord value in
  number ≟ 133 || number ≟ 8232 || number ≟ 8233

classify : Char → List Char → Maybe BreakKind
classify value rest =
  if hard_line_end value rest then Just MandatoryBreak
  else if ord value ≟ 173 then Just DiscretionaryHyphen
  else if ord value ≟ 8203 then Just ZeroWidthBreak
  else if value ≟ ' ' then
    case rest of
      next :: _ ⇒
        if hard_line_end next [] || ord next ≟ 8205 || ord next ≟ 8288
          then Nothing else Just PossibleBreak
      [] ⇒ Nothing
  else if is_han value then
    case rest of
      next :: _ ⇒ if is_han next then Just PossibleBreak else Nothing
      [] ⇒ Nothing
  else Nothing

is_empty : List Char → Bool
is_empty [] = True
is_empty (_ :: _) = False

scan_breaks : Number → List Char → List SourceBreak
scan_breaks offset [] = [At offset SourceEnd]
scan_breaks offset (value :: rest) =
  let later = scan_breaks (S offset) rest in
  case classify value rest of
    Nothing ⇒ later
    Just kind ⇒
      if is_empty rest
        then case kind of
          MandatoryBreak ⇒ [At (S offset) MandatoryBreak]
          _ ⇒ later
        else At (S offset) kind :: later

public export
source_breaks : Text → List SourceBreak
source_breaks text = scan_breaks 0 (unpack text)

-- Checks do not establish all of UAX #14/#29. They *do* fail closed on
-- malformed ranges, duplicate/reordered cuts, missing mandatory breaks, cuts
-- inside CRLF or after ZWJ/word joiner, and cuts before common combining marks.
-- Full segmentation is a separate, versioned provider qualification.
is_combining_mark : Char → Bool
is_combining_mark value =
  let number = ord value in
  (number >= 768 && number <= 879) ||
  (number >= 6832 && number <= 6911) ||
  (number >= 7616 && number <= 7679) ||
  (number >= 8400 && number <= 8447) ||
  (number >= 65056 && number <= 65071)

-- Validate the source and ordered cuts together. The previous implementation
-- repeatedly counted and indexed the complete character list at every cut.
-- The same checks now use the two characters adjoining the current boundary.
safe_boundary : Char → List Char → BreakKind → Bool
safe_boundary previous [] kind = True
safe_boundary previous (next :: rest) kind =
  not (previous ≟ '\r' && next ≟ '\n') &&
  not (ord previous ≟ 8205 || ord previous ≟ 8288) &&
  not (ord next ≟ 8205 || ord next ≟ 8288) &&
  (case kind of
    MandatoryBreak ⇒ True
    _ ⇒ not (is_combining_mark next)) &&
  (case kind of
    MandatoryBreak ⇒ True
    _ ⇒ not (hard_line_end next []))

sound_boundary : Char → List Char → BreakKind → Bool
sound_boundary previous rest MandatoryBreak = hard_line_end previous rest
sound_boundary previous rest DiscretionaryHyphen = ord previous ≟ 173
sound_boundary previous rest ZeroWidthBreak = ord previous ≟ 8203
sound_boundary previous rest PossibleBreak = not (hard_line_end previous rest)
sound_boundary previous [] SourceEnd = not (hard_line_end previous [])
sound_boundary previous (_ :: _) SourceEnd = False

validate_boundaries : Number → List Char → List SourceBreak → Bool
validate_boundaries offset [] [] = True
validate_boundaries offset [] (_ :: _) = False
validate_boundaries offset (_ :: _) [] = False
validate_boundaries offset (previous :: rest) cuts@(At position kind :: later) =
  let boundary = S offset in
  if position < boundary then False
  else if position ≟ boundary
    then safe_boundary previous rest kind &&
         sound_boundary previous rest kind &&
         validate_boundaries boundary rest later
    else not (hard_line_end previous rest) &&
         validate_boundaries boundary rest cuts

public export
valid_source_breaks : Text → List SourceBreak → Bool
valid_source_breaks text breaks =
  case unpack text of
    [] ⇒ case breaks of
      [] ⇒ True
      [At Z SourceEnd] ⇒ True
      _ ⇒ False
    characters ⇒ validate_boundaries 0 characters breaks

-- Reconstruct EXACT decoded source from offsets, regardless of paint spelling.
-- This is an independent identity oracle for layouts with discretionary marks.
public export
source_for_line : Text → SourceLine → Text
source_for_line source line =
  pack (take (nonnegative_difference line.after_last_codepoint line.first_codepoint)
    (drop line.first_codepoint (unpack source)))
