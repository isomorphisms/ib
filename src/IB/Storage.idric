module IB.Storage

import Data.Text

%default total

public export
choice storage_kind one_of
  canonical
  derived
  snapshot
  cache
  secret
  unknown

public export
storage_kind_text : storage_kind → String
storage_kind_text canonical = "canonical"
storage_kind_text derived = "derived"
storage_kind_text snapshot = "snapshot"
storage_kind_text cache = "cache"
storage_kind_text secret = "secret"
storage_kind_text unknown = "unknown"

finish_part : List Char → List String → List String
finish_part chars parts = pack (reverse chars) :: parts

split_chars : List Char → List Char → List String → List String
split_chars current [] parts = reverse (finish_part current parts)
split_chars current ('/' :: rest) parts = split_chars [] rest (finish_part current parts)
split_chars current (char :: rest) parts = split_chars (char :: current) rest parts

without_empty : List String → List String
without_empty [] = []
without_empty ("" :: rest) = without_empty rest
without_empty (part :: rest) = part :: without_empty rest

public export
path_parts : String → List String
path_parts path = without_empty (split_chars [] (unpack path) [])

is_tab_record : List String → Bool
is_tab_record ["tabs", _, "tab.txt"] = True
is_tab_record ["tabs", _, "history.log"] = True
is_tab_record ["tabs", _, "view.txt"] = True
is_tab_record _ = False

is_task_record : List String → Bool
is_task_record ["tasks", _, "task.txt"] = True
is_task_record ["tasks", _, "roots"] = True
is_task_record ["tasks", _, "resource-edges"] = True
is_task_record ["tasks", _, "frontier"] = True
is_task_record _ = False

secret_part : String → Bool
secret_part part = elem part [
  "auth", "authentication", "cookie", "cookies", "credential", "credentials",
  "login", "logins", "oauth", "password", "passwords", "secret", "secrets",
  "session", "sessions", "token", "tokens", "login_data", "web_data"
  ]

has_secret : List String → Bool
has_secret [] = False
has_secret (part :: rest) = secret_part part || has_secret rest

public export
classify_path : String → storage_kind
classify_path path =
  let parts = path_parts path in
    if parts == ["visits.jsonl"] || is_tab_record parts || is_task_record parts
      then canonical
      else if has_secret parts
        then secret
        else case parts of
          "indexes" :: _ ⇒ derived
          "snapshots" :: _ ⇒ snapshot
          "cache" :: _ ⇒ cache
          "caches" :: _ ⇒ cache
          "renderer-cache" :: _ ⇒ cache
          "renderer_cache" :: _ ⇒ cache
          "scratch" :: _ ⇒ cache
          "tmp" :: _ ⇒ cache
          _ ⇒ unknown

transparent_index : String → Bool
transparent_index name = elem name [
  "chronology.tsv", "urls.tsv", "hosts.tsv", "sources.tsv", "days.tsv",
  "queries.tsv", "terms.tsv", "summary.json"
  ]

public export
transparent_path : String → Bool
transparent_path path =
  let parts = path_parts path in
    parts == ["visits.jsonl"] || is_tab_record parts || is_task_record parts ||
      case parts of
        ["indexes", name] ⇒ transparent_index name
        _ ⇒ False

has_parent : List String → Bool
has_parent [] = False
has_parent (".." :: _) = True
has_parent (_ :: rest) = has_parent rest

public export
safe_relative_path : String → Bool
safe_relative_path path =
  case unpack path of
    [] ⇒ False
    '/' :: _ ⇒ False
    _ ⇒ not (has_parent (path_parts path))

is_secret : storage_kind → Bool
is_secret secret = True
is_secret _ = False

public export
readable_path : String → Bool
readable_path path =
  safe_relative_path path && transparent_path path && not (is_secret (classify_path path))

-- Path classification supports inspection. It never authorizes clearance.
-- Temperature, placement and removable-media availability are separate facts
-- and cannot substitute for retained input and rebuild evidence.
public export
choice retention_kind one_of
  canonical_information
  acquired_information
  accepted_decisions
  last_complete_result
  derived_information
  unknown_retention

public export
choice clearance_request one_of
  no_clearance_requested
  explicit_clearance_requested

public export
choice clearance_result one_of
  preserve_information
  clear_qualified_projection

public export
record RebuildEvidence where
  constructor OfflineRebuildEvidence
  input_references : List Text
  retained_input_references : List Text
  decision_revision : Text
  retained_decision_revision : Text
  generator_revision : Text
  original_digest : Text
  rebuilt_digest : Text
  complete : Bool
  offline_rebuild_observed : Bool
  prerequisites_available : Bool

all_retained : List Text → List Text → Bool
all_retained [] retained = True
all_retained (reference :: rest) retained =
  not (reference ≟ "") && elem reference retained && all_retained rest retained

rebuild_is_complete : RebuildEvidence → Bool
rebuild_is_complete evidence =
  not (null evidence.input_references) &&
  all_retained evidence.input_references evidence.retained_input_references &&
  not (evidence.decision_revision ≟ "") &&
  evidence.decision_revision ≟ evidence.retained_decision_revision &&
  not (evidence.generator_revision ≟ "") &&
  not (evidence.original_digest ≟ "") &&
  evidence.original_digest ≟ evidence.rebuilt_digest &&
  evidence.complete && evidence.offline_rebuild_observed &&
  evidence.prerequisites_available

-- RebuildEvidence records already-observed facts. The future store consumer
-- must verify their exact identities and hashes against retained bytes; this
-- pure policy function is not a verifier for arbitrary caller claims.

export
clearance_decision : retention_kind → clearance_request → RebuildEvidence → clearance_result
clearance_decision derived_information explicit_clearance_requested evidence =
  if rebuild_is_complete evidence then clear_qualified_projection else preserve_information
clearance_decision _ _ _ = preserve_information
