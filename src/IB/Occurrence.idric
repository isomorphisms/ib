module IB.Occurrence

%default total

-- Authoritative source text remains separate from fragment and strand indexes.
public export
data AuthoritativeText = SourceText String String

public export
source_id : AuthoritativeText → String
source_id (SourceText value _) = value

public export
source_text : AuthoritativeText → String
source_text (SourceText _ value) = value

-- Source ranges are half-open: source_start <= coordinate < source_end.
public export
SourceCoordinate : Type
SourceCoordinate = Number

public export
StrandPosition : Type
StrandPosition = Number

public export
WindowExtent : Type
WindowExtent = Number

public export
data SourceFragment = Fragment String String SourceCoordinate SourceCoordinate

public export
fragment_id : SourceFragment → String
fragment_id (Fragment value _ _ _) = value

public export
fragment_source_id : SourceFragment → String
fragment_source_id (Fragment _ value _ _) = value

public export
fragment_source_start : SourceFragment → SourceCoordinate
fragment_source_start (Fragment _ _ value _) = value

public export
fragment_source_end : SourceFragment → SourceCoordinate
fragment_source_end (Fragment _ _ _ value) = value

-- A strand is source-agnostic.  The occurrence path uses a document-order
-- strand, but other strands may cross source boundaries.
public export
data Strand = MaterializedStrand String (List String)

public export
strand_id : Strand → String
strand_id (MaterializedStrand value _) = value

public export
strand_fragment_ids : Strand → List String
strand_fragment_ids (MaterializedStrand _ value) = value

-- Each literal occurrence retains both its source coordinate and its position
-- on the supplied materialized strand.  The fragment id remains the durable
-- identity.
public export
data Occurrence = Hit SourceCoordinate StrandPosition String

public export
occurrence_source_start : Occurrence → SourceCoordinate
occurrence_source_start (Hit value _ _) = value

public export
occurrence_strand_position : Occurrence → StrandPosition
occurrence_strand_position (Hit _ value _) = value

public export
occurrence_fragment_id : Occurrence → String
occurrence_fragment_id (Hit _ _ value) = value

starts_with_chars : List Char → List Char → Bool
starts_with_chars [] _ = True
starts_with_chars (_ :: _) [] = False
starts_with_chars (wanted :: wanted_rest) (value :: rest) =
  wanted == value && starts_with_chars wanted_rest rest

literal_offsets_from : SourceCoordinate → List Char → List Char → List SourceCoordinate
literal_offsets_from position wanted [] = []
literal_offsets_from position wanted chars@(_ :: rest) =
  if starts_with_chars wanted chars
    then position :: literal_offsets_from (S position) wanted rest
    else literal_offsets_from (S position) wanted rest

-- Empty text is not treated as an occurrence at every source coordinate.
public export
literal_offsets : String → AuthoritativeText → List SourceCoordinate
literal_offsets wanted source =
  if wanted == ""
    then []
    else literal_offsets_from 0 (unpack wanted) (unpack (source_text source))

number_less : Number → Number → Bool
number_less Z Z = False
number_less Z (S _) = True
number_less (S _) Z = False
number_less (S left) (S right) = number_less left right

number_at_most : Number → Number → Bool
number_at_most left right = left == right || number_less left right

contains_coordinate : SourceCoordinate → SourceFragment → Bool
contains_coordinate coordinate fragment =
  not (number_less coordinate (fragment_source_start fragment)) &&
  number_less coordinate (fragment_source_end fragment)

fragment_at_coordinate : String → SourceCoordinate → List SourceFragment → Maybe String
fragment_at_coordinate wanted_source coordinate [] = Nothing
fragment_at_coordinate wanted_source coordinate (fragment :: rest) =
  if fragment_source_id fragment == wanted_source && contains_coordinate coordinate fragment
    then Just (fragment_id fragment)
    else fragment_at_coordinate wanted_source coordinate rest

strand_position_from : StrandPosition → String → List String → Maybe StrandPosition
strand_position_from position wanted [] = Nothing
strand_position_from position wanted (value :: rest) =
  if wanted == value
    then Just position
    else strand_position_from (S position) wanted rest

strand_position : String → Strand → Maybe StrandPosition
strand_position wanted strand = strand_position_from 0 wanted (strand_fragment_ids strand)

occurrence_at : String → List SourceFragment → Strand → SourceCoordinate → Maybe Occurrence
occurrence_at wanted_source fragments strand coordinate =
  case fragment_at_coordinate wanted_source coordinate fragments of
    Nothing ⇒ Nothing
    Just found_fragment ⇒
      case strand_position found_fragment strand of
        Nothing ⇒ Nothing
        Just position ⇒ Just (Hit coordinate position found_fragment)

collect_occurrences : String → List SourceFragment → Strand → List SourceCoordinate → List Occurrence
collect_occurrences wanted_source fragments strand [] = []
collect_occurrences wanted_source fragments strand (coordinate :: rest) =
  case occurrence_at wanted_source fragments strand coordinate of
    Nothing ⇒ collect_occurrences wanted_source fragments strand rest
    Just occurrence ⇒ occurrence :: collect_occurrences wanted_source fragments strand rest

seen_fragment : String → List String → Bool
seen_fragment wanted [] = False
seen_fragment wanted (value :: rest) = wanted == value || seen_fragment wanted rest

identifiers_unique : List String → Bool
identifiers_unique [] = True
identifiers_unique (value :: rest) =
  not (seen_fragment value rest) && identifiers_unique rest

fragment_identifiers : List SourceFragment → List String
fragment_identifiers [] = []
fragment_identifiers (fragment :: rest) = fragment_id fragment :: fragment_identifiers rest

fragment_range_valid : AuthoritativeText → SourceFragment → Bool
fragment_range_valid source fragment =
  fragment_source_id fragment == source_id source &&
  number_less (fragment_source_start fragment) (fragment_source_end fragment) &&
  number_at_most (fragment_source_end fragment) (length (unpack (source_text source)))

fragment_ranges_do_not_overlap : SourceFragment → List SourceFragment → Bool
fragment_ranges_do_not_overlap fragment [] = True
fragment_ranges_do_not_overlap fragment (other :: rest) =
  not
    (number_less (fragment_source_start fragment) (fragment_source_end other) &&
     number_less (fragment_source_start other) (fragment_source_end fragment)) &&
  fragment_ranges_do_not_overlap fragment rest

fragment_map_valid : AuthoritativeText → List SourceFragment → Bool
fragment_map_valid source fragments =
  identifiers_unique (fragment_identifiers fragments) && go fragments
  where
    go : List SourceFragment → Bool
    go [] = True
    go (fragment :: rest) =
      fragment_range_valid source fragment &&
      fragment_ranges_do_not_overlap fragment rest &&
      go rest

fragment_identifiers_on_strand : List SourceFragment → List String → Bool
fragment_identifiers_on_strand [] strand_identifiers = True
fragment_identifiers_on_strand (fragment :: rest) strand_identifiers =
  seen_fragment (fragment_id fragment) strand_identifiers &&
  fragment_identifiers_on_strand rest strand_identifiers

strand_valid_for : List SourceFragment → Strand → Bool
strand_valid_for fragments strand =
  let identifiers = strand_fragment_ids strand in
    identifiers_unique identifiers &&
    fragment_identifiers_on_strand fragments identifiers

-- Search the authoritative source, then map each exact match back onto stable
-- fragments and the supplied materialized strand.  Invalid or ambiguous range
-- and strand maps fail closed rather than dropping or reassigning hits.  For
-- #54 the supplied strand is the source's document-order strand.  No alias,
-- fuzzy, semantic, or model-derived matching occurs here.
public export
search_occurrences :
  String → AuthoritativeText → List SourceFragment → Strand → Maybe (List Occurrence)
search_occurrences wanted source fragments strand =
  if fragment_map_valid source fragments && strand_valid_for fragments strand
    then Just
      (collect_occurrences
        (source_id source)
        fragments
        strand
        (literal_offsets wanted source))
    else Nothing

unique_occurrence_fragments : List String → List Occurrence → List String
unique_occurrence_fragments seen [] = []
unique_occurrence_fragments seen (occurrence :: rest) =
  let value = occurrence_fragment_id occurrence in
    if seen_fragment value seen
      then unique_occurrence_fragments seen rest
      else value :: unique_occurrence_fragments (value :: seen) rest

public export
matching_fragment_ids :
  String → AuthoritativeText → List SourceFragment → Strand → Maybe (List String)
matching_fragment_ids wanted source fragments strand =
  case search_occurrences wanted source fragments strand of
    Nothing ⇒ Nothing
    Just occurrences ⇒ Just (unique_occurrence_fragments [] occurrences)

subtract_saturating : Number → Number → Number
subtract_saturating value Z = value
subtract_saturating Z (S _) = Z
subtract_saturating (S value) (S amount) = subtract_saturating value amount

window_from : StrandPosition → StrandPosition → StrandPosition → List String → List String
window_from index lower upper [] = []
window_from index lower upper (value :: rest) =
  if number_less upper index
    then []
    else if number_less index lower
      then window_from (S index) lower upper rest
      else value :: window_from (S index) lower upper rest

fragment_id_at : StrandPosition → List String → Maybe String
fragment_id_at Z [] = Nothing
fragment_id_at Z (value :: _) = Just value
fragment_id_at (S position) [] = Nothing
fragment_id_at (S position) (_ :: rest) = fragment_id_at position rest

-- A hit is only windowed against the strand revision it still matches.  A stale
-- position/id pair fails rather than silently returning context around a
-- different fragment.
public export
context_fragment_ids :
  WindowExtent → WindowExtent → Occurrence → Strand → Maybe (List String)
context_fragment_ids before after occurrence strand =
  let position = occurrence_strand_position occurrence in
  let ids = strand_fragment_ids strand in
    if not (identifiers_unique ids)
      then Nothing
      else case fragment_id_at position ids of
        Nothing ⇒ Nothing
        Just current ⇒
          if current == occurrence_fragment_id occurrence
            then let lower = subtract_saturating position before in
                 let upper = position + after in
                   Just (window_from 0 lower upper ids)
            else Nothing
