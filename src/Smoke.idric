module Smoke

import IB.History
import IB.Index
import IB.Storage
import IB.Inspect
import IB.DisplayRepair
import IB.ScientificMedia
import IB.Prefetch
import IB.LongViewTask
import System

%default total

sample_entries : List HistoryEntry
sample_entries = [
  Entry "https://example.test/a" (Just 10) (Just "a1") raw_urls visit Nothing 90,
  Entry "https://example.test/a" (Just 10) (Just "a2") raw_urls visit Nothing 91,
  Entry "https://other.test/b" (Just 11) (Just "b") google_activity search (Just "browser") 92,
  Entry "https://missing-time.test/c" Nothing Nothing raw_urls visit Nothing 93
  ]

sample_prefetch_targets : List PrefetchTarget
sample_prefetch_targets = [
  Target "https://example.test/a" transient_cache,
  Target "https://example.test/b" reading_corpus,
  Target "https://example.test/a" reading_corpus,
  Target "https://example.test/c" transient_cache
  ]

first_or : Nat → List Nat → Nat
first_or fallback [] = fallback
first_or fallback (value :: _) = value

same_identity : LongViewTask → LongViewTask → Bool
same_identity before after =
  identity_text before.task_identity == identity_text after.task_identity &&
  identity_text before.tab_identity == identity_text after.tab_identity &&
  identity_text before.navigation_identity == identity_text after.navigation_identity

heap_is_not_live : heap_result → Bool
heap_is_not_live live_heap_observed = False
heap_is_not_live recreated_heap_observed = True
heap_is_not_live heap_not_available = True

session_is_unproven : session_result → Bool
session_is_unproven session_not_proven = True
session_is_unproven _ = False

persistence_text : persistence_policy → String
persistence_text renderer_lifetime_only = "renderer-lifetime-only"
persistence_text durable_browser_task = "durable-browser-task"

record LongViewEvidence where
  constructor Evidence
  identities_preserved : Bool
  generations_advanced : Bool
  false_continuity_refused : Bool
  ordinary_tab_policy : persistence_policy
  sensitive_url_refused : Bool
  record_contract_matches : Bool

expected_long_view_record : String
expected_long_view_record =
  "schema\tib-long-view-task-v1\n" ++
  "task_id\ttask-1\n" ++
  "tab_id\ttab-1\n" ++
  "navigation_id\tnavigation-1\n" ++
  "neutral_url\thttps://example.test/\n" ++
  "origin\thttps://example.test/\n" ++
  "address_reconstruction\texact-neutral\n" ++
  "continuity\tlive-renderer-survival\n" ++
  "session_result\tnot-proven\n" ++
  "form_result\tnone-permitted\n" ++
  "heap_result\tnot-available\n" ++
  "reconstruction_result\tpending\n" ++
  "renderer_id\t\n" ++
  "host_process_id\thost-1\n" ++
  "host_generation\t1\n" ++
  "activity_generation\t1\n" ++
  "renderer_generation\t0\n" ++
  "authorization_adapter\tnone\n"

long_view_evidence : Maybe LongViewEvidence
long_view_evidence = do
  task_id ← durable_identity "task-1"
  tab_id ← durable_identity "tab-1"
  navigation_id ← durable_identity "navigation-1"
  host_1 ← durable_identity "host-1"
  host_2 ← durable_identity "host-2"
  renderer ← durable_identity "renderer-1"
  address ← neutral_address "https://console.cloud.google.com/auth/scopes"
  contract_address ← neutral_address "https://example.test/"
  let started = start_protected_task
        task_id tab_id navigation_id (Just address) (Just address)
        potentially_sensitive_url_material_redacted host_1
  let rendered = attach_initial_renderer renderer started
  let renderer_rebuilt = attach_renderer renderer (renderer_was_lost rendered)
  let host_rebuilt = host_process_restarted host_2 rendered
  pure (Evidence
    (same_identity rendered renderer_rebuilt && same_identity rendered host_rebuilt)
    (renderer_rebuilt.renderer_generation == rendered.renderer_generation + 1 &&
     host_rebuilt.host_generation == rendered.host_generation + 1)
    (heap_is_not_live renderer_rebuilt.heap &&
     heap_is_not_live host_rebuilt.heap &&
     session_is_unproven renderer_rebuilt.session &&
     session_is_unproven host_rebuilt.session)
    (persistence_for ordinary_tab)
    (case neutral_address "https://example.test/callback?code=secret" of
       Nothing ⇒ True
       Just _ ⇒ False)
    (serialize_long_view_task
       (start_protected_task
         task_id tab_id navigation_id (Just contract_address) (Just contract_address)
         exact_neutral_address host_1) == expected_long_view_record))

evidence_passes : LongViewEvidence → Bool
evidence_passes evidence =
  evidence.identities_preserved &&
  evidence.generations_advanced &&
  evidence.false_continuity_refused &&
  (case evidence.ordinary_tab_policy of
     renderer_lifetime_only ⇒ True
     durable_browser_task ⇒ False) &&
  evidence.sensitive_url_refused &&
  evidence.record_contract_matches

long_view_report : String
long_view_report =
  case long_view_evidence of
    Nothing ⇒ "long-view-construction=False"
    Just evidence ⇒
      "long-view-identities=" ++ show evidence.identities_preserved ++ "\n" ++
      "long-view-generations=" ++ show evidence.generations_advanced ++ "\n" ++
      "long-view-no-false-continuity=" ++ show evidence.false_continuity_refused ++ "\n" ++
      "ordinary-tab-durability=" ++ persistence_text evidence.ordinary_tab_policy ++ "\n" ++
      "sensitive-url-refused=" ++ show evidence.sensitive_url_refused ++ "\n" ++
      "long-view-record-contract=" ++ show evidence.record_contract_matches

main : IO ()
main = do
  let raw = ingest_raw_lines ["# ignored", " https://example.test/a ", "https://example.test/a", "https://other.test/b"]
  let indices = build_indices sample_entries
  let files = [
        FileRow "visits.jsonl" 20 regular_file,
        FileRow "indexes/summary.json" 10 regular_file,
        FileRow "cache/visits.jsonl" 30 regular_file,
        FileRow "tabs/T1/tab.txt" 12 symlink_file,
        FileRow "renderer/passwords" 40 regular_file
        ]
  let copy_repair = copy_button "code-1" "git status" code_block
  let prefetch = bounded_prefetch 2 sample_prefetch_targets
  putStrLn ("ingest=" ++ show (length raw))
  putStrLn ("duplicate-url-count=" ++ show (row_count "https://example.test/a" (url_rows indices)))
  putStrLn ("newest-order=" ++ show (first_or 99 (index_chronology indices)))
  putStrLn ("host-count=" ++ show (row_count "example.test" (host_rows indices)))
  putStrLn ("canonical=" ++ storage_kind_text (classify_path "visits.jsonl"))
  putStrLn ("cache-fake=" ++ storage_kind_text (classify_path "cache/visits.jsonl"))
  putStrLn ("secret=" ++ storage_kind_text (classify_path "renderer/passwords"))
  putStrLn ("readable-files=" ++ show (readable_file_count files))
  putStrLn ("canonical-files=" ++ show (files_of_kind canonical files))
  putStrLn ("copy-label=" ++ repair_label copy_repair)
  putStrLn ("copy-target=" ++ copy_target_id copy_repair)
  putStrLn ("copy-payload=" ++ copy_payload copy_repair)
  putStrLn ("arxiv-html-first=" ++ arxiv_html_url "2203.11355")
  putStrLn ("arxiv-prefetch=" ++ scientific_resource_prefetch_text arxiv_resource_prefetch)
  putStrLn ("caption-name-basis=" ++ image_name_basis_text (initial_image_name_basis (Just "Figure 1. Regions") Nothing))
  putStrLn ("temporary-needs-language-model=" ++ show (needs_language_model_image_name temporary_image_name))
  putStrLn ("prefetch-bounded=" ++ show (length prefetch))
  putStrLn ("prefetch-reading=" ++ show (reading_target_count prefetch))
  putStrLn long_view_report
  case long_view_evidence of
    Just evidence ⇒ if evidence_passes evidence then pure () else exitFailure
    Nothing ⇒ exitFailure
