module InformationSmoke

import IB.Information
import IB.Reflow
import Data.Text
import System

heavy_prefix : Text
heavy_prefix =
  "<html><head><title>Build console</title>" ++
  "<link rel='stylesheet' href='/app-900kb.css'>" ++
  "<style>body { display: grid; } hidden-style-marker</style>" ++
  "</head><body>" ++
  "<h1>Deployments</h1>" ++
  "<p>Production account</p>" ++
  "<table>" ++
  "<tr><th>Service</th><th>Status</th></tr>" ++
  "<tr><td>api</td><td>healthy</td></tr>" ++
  "<tr><td>worker</td><td>queued</td></tr>" ++
  "</table>"

heavy_tail : Text
heavy_tail =
  "<script>framework boot marker</script>" ++
  "<canvas>canvas marker</canvas>" ++
  "<video autoplay>video marker</video>" ++
  "<img src='/hero-8mb.jpg'>" ++
  "<a href='/jobs/42'>job 42</a>" ++
  "<form action='/search'><label>Find project</label><input name='q'></form>" ++
  "</body></html>"

shell_only : Text
shell_only =
  "<html><head><title>Application shell</title></head><body>" ++
  "<div id='root'></div>" ++
  "<script>project row exists only after framework execution</script>" ++
  "</body></html>"

article_body : Text
article_body =
  "<html><head><title>Field notes</title></head><body><article>" ++
  "<h1>Small pages first</h1>" ++
  "<p>The first paragraph is the useful first paint.</p>" ++
  "<p>The second paragraph remains part of the full text.</p>" ++
  "<p>Text before <a href='/inside'>an inline article link</a> text after.</p>" ++
  "<a href='/source'>Read the source</a>" ++
  "<a href='/full-figure'><img src='/figure.png' alt='Figure one' title='Measured values'></a>" ++
  "</article></body></html>"

plain_url_list : Text
plain_url_list =
  "https://example.test/one\n" ++
  "ordinary text\n" ++
  "http://example.test/two?q=three\n"

all_lines_within : Number → List Text → Bool
all_lines_within width [] = True
all_lines_within width (line :: rest) =
  length (unpack line) <= width && all_lines_within width rest

has_line : Text → List Text → Bool
has_line wanted [] = False
has_line wanted (line :: rest) = line ≟ wanted || has_line wanted rest

character_width : Text → Number
character_width value = length (unpack value)

matches_lines : List Text → Either Text (List Text) → Bool
matches_lines wanted (Right actual) = actual ≟ wanted
matches_lines wanted _ = False

has_error : Either Text (List Text) → Bool
has_error (Left _) = True
has_error _ = False

is_greedy : reflow_way → Bool
is_greedy greedy = True
is_greedy _ = False

is_balanced : reflow_way → Bool
is_balanced balanced = True
is_balanced _ = False

main : IO ()
main = do
  let early = extract_html "https://console.test/deployments" "https://console.test/deployments" heavy_prefix
  let full = extract_html "https://console.test/deployments" "https://console.test/deployments" (heavy_prefix ++ heavy_tail)
  let shell = extract_html "https://console.test/app" "https://console.test/app" shell_only
  let article = prepaint_full_text "https://example.test/notes" "https://example.test/notes" article_body
  let plain = prepaint_text "URL list" plain_url_list
  let phone = phone_lines 6 48 full
  -- Source segments are identical. Only the selected break positions differ.
  let segments = ["aa", "bb", "cc", "dd", "eeeeee"]
  let promptly_lines = reflow (Requirements 8 promptly) character_width segments
  let evenly_lines = reflow (Requirements 8 evenly) character_width segments
  let greedy_selected = is_greedy (select_reflow (Requirements 8 promptly))
  let balanced_selected = is_balanced (select_reflow (Requirements 8 evenly))
  let greedy_correct = matches_lines ["aa bb cc", "dd", "eeeeee"] promptly_lines
  let balanced_correct = matches_lines ["aa bb", "cc dd", "eeeeee"] evenly_lines
  let long_word_intact = matches_lines ["abcdefghij", "x"]
    (reflow (Requirements 8 promptly) character_width ["abcdefghij", "x"])
  let empty_intact = matches_lines []
    (reflow (Requirements 8 evenly) character_width [])
  let zero_refused = has_error
    (reflow (Requirements 0 promptly) character_width ["x"])
  putStrLn ("reflow-selected-greedy=" ++ show greedy_selected)
  putStrLn ("reflow-selected-balanced=" ++ show balanced_selected)
  putStrLn ("reflow-greedy-lines=" ++ show promptly_lines)
  putStrLn ("reflow-balanced-lines=" ++ show evenly_lines)
  putStrLn ("reflow-greedy-correct=" ++ show greedy_correct)
  putStrLn ("reflow-balanced-correct=" ++ show balanced_correct)
  putStrLn ("reflow-overwide-word-intact=" ++ show long_word_intact)
  putStrLn ("reflow-empty-intact=" ++ show empty_intact)
  putStrLn ("reflow-zero-width-refused=" ++ show zero_refused)
  putStrLn ("information-title=" ++ view_title full)
  putStrLn ("early-table-header=" ++ show (has_table_row ["Service", "Status"] early))
  putStrLn ("early-table-data=" ++ show (has_table_row ["api", "healthy"] early))
  putStrLn ("full-link=" ++ show (has_link "job 42" "/jobs/42" full))
  putStrLn ("full-form=" ++ show (has_form "/search" full))
  putStrLn ("script-leaked=" ++ show (has_exact_item_text "framework boot marker" full))
  putStrLn ("style-leaked=" ++ show (has_exact_item_text "body { display: grid; } hidden-style-marker" full))
  putStrLn ("video-leaked=" ++ show (has_exact_item_text "video marker" full))
  putStrLn ("html-must-escalate=" ++ show (must_escalate full))
  putStrLn ("shell-must-escalate=" ++ show (must_escalate shell))
  putStrLn ("phone-api-row=" ++ show (has_line "| api | healthy |" phone))
  putStrLn ("phone-lines=" ++ show (length phone))
  putStrLn ("phone-width-bounded=" ++ show (all_lines_within 48 phone))
  putStrLn ("article-first-paragraph=" ++ show (has_exact_item_text "The first paragraph is the useful first paint." article))
  putStrLn ("article-second-paragraph=" ++ show (has_exact_item_text "The second paragraph remains part of the full text." article))
  putStrLn ("article-href=" ++ show (has_link "Read the source" "/source" article))
  putStrLn ("article-inline-href=" ++ show (has_link "an inline article link" "/inside" article))
  putStrLn ("article-inline-prefix=" ++ show (has_exact_item_text "Text before" article))
  putStrLn ("article-inline-suffix=" ++ show (has_exact_item_text "text after." article))
  putStrLn ("article-linked-image=" ++ show (has_image "Figure one" "/figure.png" "/full-figure" article))
  putStrLn ("article-image-empty-link=" ++ show (has_link "" "/full-figure" article))
  putStrLn ("plain-first-url=" ++ show (has_link "https://example.test/one" "https://example.test/one" plain))
  putStrLn ("plain-second-url=" ++ show (has_link "http://example.test/two?q=three" "http://example.test/two?q=three" plain))
  putStrLn ("cheap-url-rejects-relative=" ++ show (cheap_http_url "/relative"))

  let article_retains_content =
        has_exact_item_text "The first paragraph is the useful first paint." article &&
        has_exact_item_text "The second paragraph remains part of the full text." article &&
        has_link "an inline article link" "/inside" article &&
        has_exact_item_text "Text before" article &&
        has_exact_item_text "text after." article &&
        has_image "Figure one" "/figure.png" "/full-figure" article &&
        not (has_link "" "/full-figure" article)
  let plain_links_are_candidates =
        has_link "https://example.test/one" "https://example.test/one" plain &&
        has_link "http://example.test/two?q=three" "http://example.test/two?q=three" plain &&
        not (cheap_http_url "/relative") &&
        not (cheap_http_url "https://example.test/a b")
  if article_retains_content && plain_links_are_candidates &&
     greedy_selected && balanced_selected &&
     greedy_correct && balanced_correct &&
     long_word_intact && empty_intact && zero_refused
    then pure ()
    else exitFailure
