module Main

import IB.ExactSurface
import System

-- This classifies verified SURFER sparse terms under an explicit domain and
-- chart. It does not manufacture an image or a deep link.
main : IO ()
main = do
  arguments ← getArgs
  case arguments of
    _ :: domain :: chart :: signature :: [] ⇒ do
      let renderer = renderer_for
        (domain_from_text domain)
        (chart_from_text chart)
        (proof_from_signature signature)
      putStrLn (renderer_text renderer)
      putStrLn (media_status renderer)
      putStrLn (interactive_status renderer)
    _ ⇒ do
      putStrLn "usage: ib-exact-surface DOMAIN CHART VERIFIED_SPARSE_SIGNATURE"
      exitFailure
