# Selected Binder capability: ICU acquisition. Shizuku currently supplies this
# capability, but a browser/reader never invokes rish or opens network sockets.
ib_binder_icu_get() {
  ib_shizuku_icu_get "$@"
}

# Same source-of-truth pinned ICU request, but stdout is a binary transport
# stream to an authorized caller-held write PFD rather than an Arena pathname.
ib_binder_icu_stream() {
  ib_shizuku_icu_stream "$@"
}
