# Grease source. Navigation policy calls this only for paper URLs that strongly
# imply the existing scientific-media path. A committed arXiv visit is reading,
# so the complete artifact bundle belongs in the durable reading corpus. The
# fetched response bytes also remain in the ordinary clearable prefetch cache.

scientific_navigation_is_arxiv() {
  input=$1
  cleaned=${input%%\#*}
  cleaned=${cleaned%%\?*}
  case "$cleaned" in
    http://arxiv.org/abs/*|https://arxiv.org/abs/*|\
    http://arxiv.org/html/*|https://arxiv.org/html/*|\
    http://arxiv.org/pdf/*|https://arxiv.org/pdf/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

prefetch_arxiv_navigation_reading() {
  navigation_input=$1
  navigation_reading_directory=$(prefetch_arxiv_to_reading "$navigation_input") || return 1
  printf 'navigation_committed\treading_corpus\t%s\n' "$navigation_input" \
    > "$navigation_reading_directory/trigger.tsv"
  printf '%s\n' "$navigation_reading_directory"
}
