# Grease source.  A look-ahead body is the best human-readable result of a
# fetch attempt: fetched bytes on success, descriptive plain text on failure.
# The small `result` file distinguishes those cases without hiding either one.

ib_look_ahead_fail() {
  printf '%s\n' "$*" >&2
  return 1
}

ib_look_ahead_require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    ib_look_ahead_fail "missing command: $1"
}

ib_look_ahead_root() {
  if test -n "${IB_LOOK_AHEAD_DIR:-}"; then
    printf '%s\n' "$IB_LOOK_AHEAD_DIR"
  else
    test -n "${HOME:-}" || {
      ib_look_ahead_fail 'HOME is not set'
      return 1
    }
    printf '%s/look-ahead\n' "$HOME"
  fi
}

ib_look_ahead_url_key() {
  ib_look_ahead_require_command sha256sum || return 1
  printf '%s' "$1" | sha256sum | awk '{ print $1 }'
}

ib_look_ahead_entry_directory() {
  root=$(ib_look_ahead_root) || return 1
  key=$(ib_look_ahead_url_key "$1") || return 1
  printf '%s/%s\n' "$root" "$key"
}

ib_look_ahead_cached_path() {
  entry_directory=$(ib_look_ahead_entry_directory "$1") || return 1
  test -f "$entry_directory/body" || return 1
  grep -Fx 'ok' "$entry_directory/result" >/dev/null 2>&1 || return 1
  printf '%s/body\n' "$entry_directory"
}

ib_look_ahead_fetch() {
  test "$#" -eq 1 || {
    ib_look_ahead_fail 'usage: ib_look_ahead_fetch URL'
    return 2
  }

  url=$1
  nice_command=${IB_NICE:-nice}
  icu_command=${IB_ICU:-icu}
  niceness=${IB_LOOK_AHEAD_NICENESS:-20}

  ib_look_ahead_require_command "$nice_command" || return 1
  ib_look_ahead_require_command "$icu_command" || return 1

  entry_directory=$(ib_look_ahead_entry_directory "$url") || return 1
  body_path="$entry_directory/body"
  request_path="$entry_directory/request.url"
  result_path="$entry_directory/result"
  mkdir -p "$entry_directory" || return 1

  if test -f "$body_path" && grep -Fx 'ok' "$result_path" >/dev/null 2>&1; then
    printf '%s\n' "$body_path"
    return 0
  fi

  body_partial="$entry_directory/.body.$$"
  request_partial="$entry_directory/.request.$$"
  result_partial="$entry_directory/.result.$$"
  error_partial="$entry_directory/.error.$$"
  rm -f "$body_partial" "$request_partial" "$result_partial" "$error_partial"
  printf '%s\n' "$url" > "$request_partial"

  fetch_failed=0
  if "$nice_command" -n "$niceness" "$icu_command" get "$url" \
      > "$body_partial" 2> "$error_partial"; then
    printf '%s\n' ok > "$result_partial"
  else
    fetch_status=$?
    attempted_at=${IB_LOOK_AHEAD_NOW:-$(date -u '+%Y-%m-%dT%H:%M:%SZ')}
    {
      printf '%s\n' 'EyeBrowser could not fetch this page.'
      printf 'Attempted: %s\n' "$attempted_at"
      printf 'URL: %s\n' "$url"
      printf 'Command: icu get\n'
      printf 'Exit status: %s\n' "$fetch_status"
      printf '%s\n' 'ICU said:'
      if test -s "$error_partial"; then
        cat "$error_partial"
      else
        printf '%s\n' '(no error text)'
      fi
    } > "$body_partial"
    printf '%s\n' error > "$result_partial"
    fetch_failed=1
  fi
  rm -f "$error_partial"

  if ! mv "$request_partial" "$request_path"; then
    rm -f "$body_partial" "$request_partial" "$result_partial"
    return 1
  fi
  if ! mv "$body_partial" "$body_path"; then
    rm -f "$body_partial" "$request_path" "$result_partial"
    return 1
  fi
  if ! mv "$result_partial" "$result_path"; then
    rm -f "$result_partial"
    return 1
  fi

  if test "$fetch_failed" -ne 0; then
    ib_look_ahead_fail "look-ahead GET failed: $url"
    return 1
  fi

  printf '%s\n' "$body_path"
}

ib_look_ahead_prefetch_stream() {
  failures=0
  while IFS= read -r url || test -n "$url"; do
    test -n "$url" || continue
    if ! ib_look_ahead_fetch "$url"; then
      failures=1
    fi
  done
  return "$failures"
}
