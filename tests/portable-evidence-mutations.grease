#!/usr/bin/env grease
# Run known-bad copies. Maintained sources are never modified by this test.
umask 077
var tests_directory = $(dirname -- $0)
var root = $(realpath -- "$tests_directory/..")
var runner = ENV.GREASE
var compiler = ENV.IDRIC
var temporary = $(mktemp -d)
trap --add EXIT { rm -rf -- $temporary }
mkdir -p -- "$temporary/path/bin" "$temporary/path/lib/ib" "$temporary/policy" "$temporary/outside"
cp -- "$root/bin/retain-source.grease" "$temporary/path/bin/retain-source.grease"
cp -- "$root/lib/ib/pensieve.grease" "$temporary/path/lib/ib/pensieve.grease"
# Exact defect: permit a selected output path to cross a symlink ancestor.
sed 's/if test -L $current/if false/' "$root/bin/ib-evidence.grease" > "$temporary/path/bin/ib-evidence.grease"
printf 'synthetic bytes\n' > "$temporary/raw"
var hash = $(sha256sum "$temporary/raw" | cut -d ' ' -f 1)
var count = $(wc -c < "$temporary/raw" | tr -d '[:space:]')
printf 'source_kind\traw_urls\nsource_identity\tpath-mutation-control\nsource_generation\t1\nacquired_at\t2026-10-08T00:00:00Z\nprivacy\tordinary\nmodel\tdeny\nexposure\tlocal-only\nsha256\t%s\nbyte_count\t%s\n' $hash $count > "$temporary/source.tsv"
var id = $(env IB_HOME="$temporary/store" $runner +O ysh:all "$root/bin/retain-source.grease" "$temporary/raw" "$temporary/source.tsv")
printf '%s\traw\tordinary\n' $id > "$temporary/selection.tsv"
ln -s "$temporary/outside" "$temporary/linked"
cat > "$temporary/refuse-output.grease" <<'EOF'
var runner = ENV.GREASE
try { $runner $[ARGV[0]] export $[ARGV[1]] $[ARGV[2]] > /dev/null 2>&1 }
if (not _error.code) { write -- 'FAIL expected destination refusal'; exit 17 }
write -- 'PASS linked output refused'
EOF
env GREASE=$runner IB_HOME="$temporary/store" $runner "$temporary/refuse-output.grease" "$root/bin/ib-evidence.grease" "$temporary/selection.tsv" "$temporary/linked/clean" > "$temporary/control.log"
test ! -e "$temporary/outside/clean"
try { env GREASE=$runner IB_HOME="$temporary/store" $runner "$temporary/refuse-output.grease" "$temporary/path/bin/ib-evidence.grease" "$temporary/selection.tsv" "$temporary/linked/mutant" > "$temporary/path.log" }
if (_error.code !== 17) { write -- 'FAIL path mutant did not trigger the expected acceptance failure' >&2; exit 1 }
grep -F 'FAIL expected destination refusal' "$temporary/path.log" > /dev/null
test -f "$temporary/outside/mutant/sources/$id/raw"
write -- 'PASS malicious-path mutant rejected; clean control refused, mutant escaped into fixture outside directory'

cp -- "$root/examples/autogenerated/portable-evidence/PortableEvidenceAcceptance.idric" "$temporary/policy/PortableEvidenceAcceptance.idric"
# Exact defect: an unmatched source class is treated as selected ordinary data.
sed 's/admit_selection _ _ = False/admit_selection _ _ = True/' "$root/examples/autogenerated/portable-evidence/PortableEvidence.idric" > "$temporary/policy/PortableEvidence.idric"
cd "$temporary/policy"
$compiler --client acceptance_results PortableEvidenceAcceptance.idric > "$temporary/policy.log"
grep -F 'False' "$temporary/policy.log" > /dev/null
write -- 'PASS Idriç unselected-private/secret/profile policy mutant rejected'
