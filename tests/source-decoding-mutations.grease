#!/usr/bin/env grease
# Compile actual known-bad decoders; never edit the implementation under test.
umask 077
var tests_directory = $(dirname -- $0)
var root = $(realpath -- "$tests_directory/..")
var compiler = ENV.IDRIC
var temporary = $(mktemp -d)
trap --add EXIT { rm -rf -- $temporary }

proc compile_and_reject(source, name) {
  var directory = "$temporary/$name"
  mkdir -p -- "$directory/IB"
  cp -- $source "$directory/IB/SourceDecoding.idric"
  cp -- "$root/examples/autogenerated/source-byte-decoding/SourceDecodingChecks.idric" "$directory/SourceDecodingChecks.idric"
  var previous = $(pwd)
  cd $directory
  $compiler SourceDecodingChecks.idric -o checks > "$directory/compile.log" 2>&1
  cd $previous
  try {
    "$directory/build/exec/checks" "$root/tests/fixtures/index-windows-1252.txt" "$directory/unused.raw" "$directory/unused.utf8" > "$directory/result.log" 2>&1
  }
  if (not _error.code) { write -- "FAIL $name mutant passed normative oracle" >&2; exit 1 }
  grep -F 'FAIL all 256 octets match normative index' "$directory/result.log" > /dev/null
  write -- "PASS compiled $name mutant rejected by normative scalar oracle"
}

# Wrong mechanism: interpret every source octet as the identically numbered
# Unicode scalar, ignoring HTML's windows-1252 punctuation mapping.
sed 's/chr \. windows_1252_scalar/chr . cast/' "$root/src/IB/SourceDecoding.idric" > "$temporary/latin1.idric"
if cmp -s "$root/src/IB/SourceDecoding.idric" "$temporary/latin1.idric" { exit 1 }
compile_and_reject "$temporary/latin1.idric" 'naive-latin1'

# Wrong mechanism: a non-WHATWG undefined-byte policy replaces five C1 slots.
sed -e 's/129 ⇒ 0x0081/129 ⇒ 0xFFFD/' \
  -e 's/141 ⇒ 0x008D/141 ⇒ 0xFFFD/' \
  -e 's/143 ⇒ 0x008F/143 ⇒ 0xFFFD/' \
  -e 's/144 ⇒ 0x0090/144 ⇒ 0xFFFD/' \
  -e 's/157 ⇒ 0x009D/157 ⇒ 0xFFFD/' \
  "$root/src/IB/SourceDecoding.idric" > "$temporary/replacement.idric"
compile_and_reject "$temporary/replacement.idric" 'undefined-byte-replacement'
