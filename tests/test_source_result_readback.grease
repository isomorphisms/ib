#!/usr/bin/env grease
set -eu

# Run the preserved byte owners themselves, never a substitute decoder. This
# independently measures the receipts used by Idriç normalization acceptance.
test "$#" -eq 4 || exit 2
repository_root=$1
retained_owner=$2
runtime=$3
state_root=$4
test "$(git -C "$retained_owner" rev-parse HEAD)" = b4d93c47327f112433b90c0a77a00b3ddcba0af4
test ! -e "$state_root" || exit 2
fixture=$repository_root/examples/autogenerated/source-result

invoke_preserved() {
  # Explicit debt of the unchanged POSIX-era owner, executed by actual Grease.
  env ASAN_OPTIONS=detect_leaks=0 IB_HOME="$state_root" "$runtime" \
    +O no_parse_sh_arith +O no_parse_word_join +O strict_errexit \
    +O no_osh_builtins +O no_exported +O env_obj +O simple_trap_builtin "$@"
}

file_digest() {
  measured=$(sha256sum "$1")
  printf '%s\n' "${measured%% *}"
}

first_id=$(invoke_preserved "$retained_owner/bin/retain-source.grease" "$fixture/first.urls" "$fixture/first.tsv")
second_id=$(invoke_preserved "$retained_owner/bin/retain-source.grease" "$fixture/second.urls" "$fixture/second.tsv")
test "$first_id" = 2001ab879efaac563df10d85fc01e06865b08e9ea3f4a3cd44e66622d3a6713d
test "$second_id" = f8b3c4f6f35fb44f65a3e68cd2c1d1324e045c185200bb83bcbbe38780466f27
invoke_preserved "$retained_owner/bin/project-raw-urls.grease" "$first_id" >/dev/null
invoke_preserved "$retained_owner/bin/project-raw-urls.grease" "$second_id" >/dev/null
first_view=$state_root/pensieve/sources/ordinary/$first_id
second_view=$state_root/pensieve/sources/ordinary/$second_id
test "$(file_digest "$first_view/text/urls.txt")" = 174be1f365a4b21864fd201508fa1ff41eb2ca8bca032c4f03ac2b3dc4c68c90
test "$(file_digest "$second_view/text/urls.txt")" = bb522e70f6259ec4dd7f99457b5d140f80828bd81ad60e608539d26c95ebe36c
test "$(wc -c <"$first_view/text/urls.txt" | tr -d '[:space:]')" = 84
test "$(wc -c <"$second_view/text/urls.txt" | tr -d '[:space:]')" = 59
test "$(wc -l <"$first_view/text/urls.txt" | tr -d '[:space:]')" = 3
test "$(wc -l <"$second_view/text/urls.txt" | tr -d '[:space:]')" = 2
grep -F '1	3	unknown' "$first_view/coordinates.tsv" >/dev/null
grep -F 'decoder	raw-urls-v1' "$first_view/source.tsv" >/dev/null
cmp "$fixture/first.urls" "$state_root/cauldron/sources/$first_id/raw"
cmp "$fixture/second.urls" "$state_root/cauldron/sources/$second_id/raw"

# Independent caller rebuilds from unchanged retained bytes; the decoder does
# not invoke acquisition. Keep the old view for exact comparison.
mv "$state_root/pensieve" "$state_root/previous-pensieve"
invoke_preserved "$retained_owner/bin/project-raw-urls.grease" "$first_id" >/dev/null
invoke_preserved "$retained_owner/bin/project-raw-urls.grease" "$second_id" >/dev/null
cmp "$first_view/text/urls.txt" "$state_root/previous-pensieve/sources/ordinary/$first_id/text/urls.txt"
cmp "$second_view/text/urls.txt" "$state_root/previous-pensieve/sources/ordinary/$second_id/text/urls.txt"

# Tamper only this synthetic retained copy. Owner refuses before damaging its
# existing derivative; then restore the fixture bytes for independent reopen.
printf 'changed\n' >>"$state_root/cauldron/sources/$first_id/raw"
try { invoke_preserved "$retained_owner/bin/project-raw-urls.grease" "$first_id" >"$state_root/stale.out" 2>"$state_root/stale.err" }
test "$[_error.code]" -eq 2
grep -F 'retained source length mismatch' "$state_root/stale.err" >/dev/null
cmp "$first_view/text/urls.txt" "$state_root/previous-pensieve/sources/ordinary/$first_id/text/urls.txt"
cp "$fixture/first.urls" "$state_root/cauldron/sources/$first_id/raw"
cmp "$fixture/first.urls" "$state_root/cauldron/sources/$first_id/raw"
printf '%s\n' 'source-result-retained-readback=PASS'
