#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repository_root/lib/scientific_media.grease"

work_directory=$(mktemp -d)
trap 'rm -rf "$work_directory"' EXIT HUP INT TERM

html_count=0
processed_count=0
caption_total=0
for identifier in 2203.11355 1901.09021 1606.05336 2305.00241; do
  output_directory="$work_directory/$(printf '%s' "$identifier" | tr '/' '_')"
  sh "$repository_root/bin/harvest_arxiv_images.grease" \
    "https://arxiv.org/abs/$identifier" "$output_directory"
  kind=$(source_kind_from_harvest_directory "$output_directory")
  image_count=$(wc -l < "$output_directory/images.tsv" | tr -d ' ')
  caption_count=$(awk -F '\t' '$4 == "caption" { count += 1 } END { print count + 0 }' "$output_directory/images.tsv")
  alt_text_count=$(awk -F '\t' '$4 == "alt_text" { count += 1 } END { print count + 0 }' "$output_directory/images.tsv")
  temporary_count=$(awk -F '\t' '$4 == "temporary" { count += 1 } END { print count + 0 }' "$output_directory/images.tsv")
  printf '%s\t%s\t%s images\t%s caption\t%s alt\t%s temporary\n' \
    "$identifier" "$kind" "$image_count" "$caption_count" "$alt_text_count" "$temporary_count"
  processed_count=$((processed_count + 1))
  if test "$kind" = html; then
    html_count=$((html_count + 1))
    caption_total=$((caption_total + caption_count))
    test "$image_count" -gt 0
    image_tag_count=$(find "$output_directory/image_tags" -type f -name 'image_tag_*.html' -print | wc -l | tr -d ' ')
    test "$image_tag_count" -eq "$image_count"
  fi
done

test "$processed_count" -eq 4
test "$html_count" -gt 0
test "$caption_total" -gt 0
printf 'live arXiv image harvest: %s HTML-first papers out of %s; %s caption-derived names\n' \
  "$html_count" "$processed_count" "$caption_total"
