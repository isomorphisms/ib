#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repository_root/lib/scientific_media.grease"

work_directory=$(mktemp -d)

# Retain only this public test's failed paper. This is the existing sh test
# boundary; it does not assert that the capture was executed through Grease.
retain_failure() (
  # Allow the extra byte used to distinguish a full archive from truncation.
  ulimit -f 65538 || return 1
  mkdir -p "$IB_SCIENTIFIC_FAILURE_DIRECTORY" || return 1
  failure_directory=$(CDPATH= cd -- "$IB_SCIENTIFIC_FAILURE_DIRECTORY" && pwd) || return 1
  {
    printf 'test_exit=%s\nidentifier=%s\narchive_limit_bytes=33554432\n' "$failure_status" "${identifier:-unknown}"
    git -C "$repository_root" rev-parse HEAD
    locale
    xmlstarlet --version
    iconv --version
  } 2>&1 | head -c 65536 > "$failure_directory/environment.txt"
  sha256sum "$repository_root/lib/scientific_media.grease" \
    "$repository_root/lib/pdf_figure_captions.grease" \
    "$repository_root/tests/live_arxiv_image_harvest.grease" \
    "$repository_root/.github/workflows/idric-core.yml" \
    > "$failure_directory/source.sha256"
  test -d "${output_directory:-}" || return 1
  cd "$output_directory" || return 1
  if test -f document.html; then
    if html_image_rows document.html > regenerated_rows.tsv 2> regenerated_rows.stderr; then
      printf '0\n' > regenerated_rows.exit
    else
      printf '%s\n' "$?" > regenerated_rows.exit
    fi
  fi
  if test -d images; then
    find images -type f -printf '%P\0' > image_filenames.nul
  fi
  : > capture.list
  for capture_name in document.html source.tsv images.tsv unresolved_images.tsv image_tags \
    regenerated_rows.tsv regenerated_rows.stderr regenerated_rows.exit image_filenames.nul; do
    if test -e "$capture_name"; then
      printf '%s\n' "$capture_name" >> capture.list
    fi
  done
  while IFS= read -r capture_name; do
    find "$capture_name" -type f -exec sha256sum '{}' +
  done < capture.list | head -c 262144 > "$failure_directory/input.sha256"
  # Preserve complete bytes below the limit. A capped archive is explicitly
  # incomplete; it is never presented as an exact copy of the failed input.
  printf 'incomplete: archive limit reached or capture failed\n' > "$failure_directory/archive.status" || return 1
  if (
    if tar -cf - -T capture.list; then
      printf '0\n' > "$failure_directory/archive-producer.exit"
    else
      printf '%s\n' "$?" > "$failure_directory/archive-producer.exit"
    fi
  ) | head -c 33554433 > "$failure_directory/inputs.tar"; then
    archive_bytes=$(stat -c %s "$failure_directory/inputs.tar") || return 1
    if test "$archive_bytes" -gt 33554432; then
      truncate -s 33554432 "$failure_directory/inputs.tar" || return 1
    elif test "$(cat "$failure_directory/archive-producer.exit")" = 0; then
      printf 'complete\n' > "$failure_directory/archive.status"
    else
      return 1
    fi
  else
    return 1
  fi
)

cleanup() {
  failure_status=$?
  trap - EXIT HUP INT TERM
  if test "$failure_status" -ne 0 && test -n "${IB_SCIENTIFIC_FAILURE_DIRECTORY:-}"; then
    if ! retain_failure; then
      printf 'scientific-media: failure capture incomplete\n' >&2
    fi
  fi
  if ! rm -rf "$work_directory"; then
    printf 'scientific-media: temporary cleanup failed\n' >&2
  fi
  exit "$failure_status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

html_count=0
processed_count=0
caption_total=0
for identifier in 2203.11355 1901.09021 1606.05336 2305.00241; do
  output_directory="$work_directory/$(printf '%s' "$identifier" | tr '/' '_')"
  sh "$repository_root/bin/harvest_arxiv_images.grease" \
    "https://arxiv.org/abs/$identifier" "$output_directory"
  kind=$(source_kind_from_harvest_directory "$output_directory")
  image_count=$(wc -l < "$output_directory/images.tsv" | tr -d ' ')
  caption_count=$(awk -F '\t' '$4 == "caption" { count += 1 } END { print count + 0 }' "$output_directory/images.tsv")
  alt_text_count=$(awk -F '\t' '$4 == "alt_text" { count += 1 } END { print count + 0 }' "$output_directory/images.tsv")
  temporary_count=$(awk -F '\t' '$4 == "temporary" { count += 1 } END { print count + 0 }' "$output_directory/images.tsv")
  printf '%s\t%s\t%s images\t%s caption\t%s alt\t%s temporary\n' \
    "$identifier" "$kind" "$image_count" "$caption_count" "$alt_text_count" "$temporary_count"
  processed_count=$((processed_count + 1))
  if test "$kind" = html; then
    html_count=$((html_count + 1))
    caption_total=$((caption_total + caption_count))
    test "$image_count" -gt 0
    image_tag_count=$(find "$output_directory/image_tags" -type f -name 'image_tag_*.html' -print | wc -l | tr -d ' ')
    test "$image_tag_count" -eq "$image_count"
  fi
done

test "$processed_count" -eq 4
test "$html_count" -gt 0
test "$caption_total" -gt 0
printf 'live arXiv image harvest: %s HTML-first papers out of %s; %s caption-derived names\n' \
  "$html_count" "$processed_count" "$caption_total"
