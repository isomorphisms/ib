#!/usr/bin/env grease
# Evaluate the actual Idriç policy through the maintained compiler. No target
# executable or compiler-wide/Android qualification is claimed.
var tests_directory = $(dirname -- $0)
var root = $(realpath -- "$tests_directory/..")
var compiler = ENV.IDRIC
var temporary = $(mktemp -d)
trap --add EXIT { rm -rf -- $temporary }
cd "$root/examples/autogenerated/portable-evidence"
$compiler --client acceptance_results PortableEvidenceAcceptance.idric > "$temporary/results"
grep -Fx '[True, True, True, True, True, True, True, True, True, True]' "$temporary/results" > /dev/null
write -- 'PASS Idriç ordinary/private/secret/profile/assistant policy evaluation'
