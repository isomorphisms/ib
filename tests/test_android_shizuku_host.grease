#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)
. "$repository_root/lib/android_shizuku_host.grease"
. "$repository_root/lib/android_binder_host.grease"

work_directory=$(mktemp -d)
cleanup() {
  rm -rf "$work_directory"
}
trap cleanup EXIT HUP INT TERM

fake_rish="$work_directory/rish"
fake_log="$work_directory/rish.log"
export FAKE_RISH_LOG="$fake_log"

cat > "$fake_rish" <<'FAKE_RISH'
#!/bin/sh
if test "$#" -ne 2 || test "$1" != '-c'; then
  printf 'fake rish expected: -c COMMAND\n' >&2
  exit 91
fi

command_text=$2
printf '%s\n' "$command_text" >> "$FAKE_RISH_LOG"

case "$command_text" in
  __success__)
    printf 'ok\n'
    ;;
  __failure__)
    printf 'remote failure\n' >&2
    exit 37
    ;;
  'id -u')
    printf '%s\n' "${FAKE_RISH_UID-2000}"
    if test -n "${FAKE_RISH_UID_ERROR:-}"; then
      printf '%s\n' "$FAKE_RISH_UID_ERROR" >&2
    fi
    exit "${FAKE_RISH_UID_STATUS:-0}"
    ;;
  *'printf "identity'*'id -Z 2>/dev/null'*'printf "unavailable'*)
    printf 'identity\tuid=2000(shell) gid=2000(shell) groups=2000(shell)\n'
    printf 'selinux\tu:r:shell:s0\n'
    ;;
  'ps -A')
    printf 'PID NAME\n2000 sh\n'
    ;;
  *'expected_start=999'*'expected_name=ibworker'*'kill -TERM'*)
    ;;
  *'expected_start=998'*'expected_name=ibworker'*)
    exit 45
    ;;
  *'pid=123;'*'/proc/$pid/stat;'*'/proc/$pid/comm;'*)
    printf '123\t999\tibworker\n'
    ;;
  'pidof org.isomorphisms.ib')
    printf '4242 4243\n'
    ;;
  'am force-stop org.isomorphisms.ib')
    ;;
  *)
    printf 'unexpected remote command: %s\n' "$command_text" >&2
    exit 92
    ;;
esac
FAKE_RISH
chmod +x "$fake_rish"
export IB_RISH_COMMAND="$fake_rish"

output=$(ib_shizuku_run '__success__')
test "$output" = 'ok'

bounded_output=$(ib_shizuku_run_bounded 5 '__success__')
test "$bounded_output" = 'ok'

before=$(wc -l < "$fake_log")
if ib_shizuku_run_bounded 0 '__success__' >/dev/null 2>&1; then
  printf 'zero-second timeout was accepted\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

if ib_shizuku_run '__failure__' >"$work_directory/failure.out" 2>"$work_directory/failure.err"; then
  printf 'remote failure was reported as success\n' >&2
  exit 1
else
  status=$?
fi
test "$status" -eq 37
grep -F 'remote failure' "$work_directory/failure.err" >/dev/null

# Test both the provider adapter and the real Binder-facing caller. Capture the
# producer status separately: a text comparison must not mask failed discovery.
assert_authority_result() {
  authority_expected_status=$1
  authority_expected_output=$2
  for authority_function in ib_shizuku_authority ib_binder_authority; do
    if "$authority_function" >"$work_directory/authority.out" 2>"$work_directory/authority.err"; then
      authority_status=0
    else
      authority_status=$?
    fi
    if test "$authority_status" -ne "$authority_expected_status"; then
      printf '%s returned status %s; expected %s\n' "$authority_function" "$authority_status" "$authority_expected_status" >&2
      exit 1
    fi
    if test -n "$authority_expected_output"; then
      printf '%s\n' "$authority_expected_output" >"$work_directory/authority.expected"
    else
      : >"$work_directory/authority.expected"
    fi
    if ! cmp "$work_directory/authority.expected" "$work_directory/authority.out"; then
      printf '%s produced unexpected authority output\n' "$authority_function" >&2
      exit 1
    fi
    if test -n "${authority_expected_error:-}"; then
      grep -F "$authority_expected_error" "$work_directory/authority.err" >/dev/null
    else
      test ! -s "$work_directory/authority.err"
    fi
  done
}

export FAKE_RISH_UID=2000 FAKE_RISH_UID_STATUS=0
authority_expected_error=
assert_authority_result 0 shell
export FAKE_RISH_UID=0
assert_authority_result 0 root
export FAKE_RISH_UID=10123
assert_authority_result 0 uid:10123

# Plausible privilege text from a failed provider must never claim authority.
export FAKE_RISH_UID=0 FAKE_RISH_UID_STATUS=37
assert_authority_result 37 ''
export FAKE_RISH_UID=2000 FAKE_RISH_UID_STATUS=124
assert_authority_result 124 ''
export FAKE_RISH_UID_STATUS=13 FAKE_RISH_UID_ERROR='permission denied by provider'
authority_expected_error=$FAKE_RISH_UID_ERROR
assert_authority_result 13 ''
unset FAKE_RISH_UID_ERROR

export FAKE_RISH_UID_STATUS=0
authority_expected_error='invalid effective UID from Shizuku provider'
for malformed_uid in '' shell ' 2000' '2000 ' 2000x -1 "$(printf '2000\n0')"; do
  export FAKE_RISH_UID="$malformed_uid"
  assert_authority_result 2 ''
done

export IB_RISH_COMMAND="$work_directory/missing-rish"
authority_expected_error='rish is not executable:'
assert_authority_result 1 ''
: >"$work_directory/denied-rish"
chmod 600 "$work_directory/denied-rish"
export IB_RISH_COMMAND="$work_directory/denied-rish"
assert_authority_result 1 ''
export IB_RISH_COMMAND="$fake_rish"
unset FAKE_RISH_UID FAKE_RISH_UID_STATUS

identity=$(ib_shizuku_identity)
printf '%s\n' "$identity" | grep -F 'identity' >/dev/null
printf '%s\n' "$identity" | grep -F 'uid=2000(shell)' >/dev/null
printf '%s\n' "$identity" | grep -F 'u:r:shell:s0' >/dev/null

processes=$(ib_shizuku_process_snapshot)
printf '%s\n' "$processes" | grep -F '2000 sh' >/dev/null

process_identity=$(ib_shizuku_process_identity 123)
test "$process_identity" = "$(printf '123\t999\tibworker')"

ib_shizuku_signal_owned 123 999 ibworker TERM

if ib_shizuku_signal_owned 123 998 ibworker TERM     >"$work_directory/stale.out" 2>"$work_directory/stale.err"; then
  printf 'stale process start identity was accepted\n' >&2
  exit 1
else
  status=$?
fi
test "$status" -eq 45

before=$(wc -l < "$fake_log")
if ib_shizuku_signal 123 TERM >/dev/null 2>&1; then
  printf 'PID-only signal was accepted\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

package_pids=$(ib_shizuku_package_pids org.isomorphisms.ib)
test "$package_pids" = '4242 4243'

before=$(wc -l < "$fake_log")
if ib_shizuku_force_stop_package org.isomorphisms.ib >/dev/null 2>&1; then
  printf 'package stop ran without explicit fault target\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

export IB_SHIZUKU_FAULT_TARGET_PACKAGE=org.isomorphisms.ib
ib_shizuku_force_stop_package org.isomorphisms.ib
unset IB_SHIZUKU_FAULT_TARGET_PACKAGE

for special_pid in 0 1; do
  before=$(wc -l < "$fake_log")
  if ib_shizuku_signal_owned "$special_pid" 999 ibworker TERM >/dev/null 2>&1; then
    printf 'special pid %s was accepted\n' "$special_pid" >&2
    exit 1
  fi
  after=$(wc -l < "$fake_log")
  test "$before" -eq "$after"
done

before=$(wc -l < "$fake_log")
if ib_shizuku_signal_owned '123;echo-bad' 999 ibworker TERM >/dev/null 2>&1; then
  printf 'unsafe pid was accepted\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

before=$(wc -l < "$fake_log")
if ib_shizuku_signal_owned 123 '999;echo-bad' ibworker TERM >/dev/null 2>&1; then
  printf 'unsafe start identity was accepted\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

before=$(wc -l < "$fake_log")
if ib_shizuku_signal_owned 123 999 'ibworker;echo-bad' TERM >/dev/null 2>&1; then
  printf 'unsafe process name was accepted\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

before=$(wc -l < "$fake_log")
if ib_shizuku_force_stop_package 'org.isomorphisms.ib;echo-bad' >/dev/null 2>&1; then
  printf 'unsafe package name was accepted\n' >&2
  exit 1
fi
after=$(wc -l < "$fake_log")
test "$before" -eq "$after"

printf 'android shizuku host adapter tests: ok\n'
