#!/usr/bin/env grease
# Semantic compiler normalization only; this never generates consumer code.
# Explicit inherited compatibility mode is required by current orchestration.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
compiler=${IB_IDRIC_COMMAND:-}
case "$compiler" in
  /*) test -x "$compiler" || exit 127 ;;
  *) printf 'IB_IDRIC_COMMAND must name a verified absolute compiler executable\n' >&2; exit 127 ;;
esac
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT HUP INT TERM
mkdir -p "$fixture/IB"
cp "$root/src/IB/StorageAdmission.idric" "$fixture/IB/StorageAdmission.idric"
cp "${IB_STORAGE_CAPABILITIES_SOURCE:-$root/src/IB/StorageCapabilities.idric}" "$fixture/IB/StorageCapabilities.idric"
cp "$root/examples/autogenerated/storage-reconciliation/ReconcileStorage.idric" "$fixture/ReconcileStorage.idric"
cd "$fixture"
if "$compiler" --no-color --check ReconcileStorage.idric > check.log 2>&1; then
  cat check.log
else
  status=$?
  cat check.log >&2
  exit "$status"
fi
if grep -F 'Error:' check.log >/dev/null; then exit 1; fi
if "$compiler" --no-color --quiet ReconcileStorage.idric --client all_cases_pass > normalize.log 2>&1; then
  cat normalize.log
else
  status=$?
  cat normalize.log >&2
  exit "$status"
fi
grep -Fx 'True' normalize.log >/dev/null
printf 'storage-reconciliation: 14 semantic cases normalized PASS\n'
