#!/bin/sh
set -eu

test "$#" -eq 2 || exit 64
test "$1" = get || exit 64
url=$2

fixtures=${IB_FAKE_FIXTURES:?set IB_FAKE_FIXTURES}
if test -n "${IB_FAKE_LOG:-}"; then
  printf '%s\n' "$url" >> "$IB_FAKE_LOG"
fi

case "$url" in
  https://arxiv.org/abs/2203.11355)
    cat "$fixtures/abstract.html"
    ;;
  https://arxiv.org/html/2203.11355)
    cat "$fixtures/paper.html"
    ;;
  https://arxiv.org/pdf/2203.11355)
    cat "$fixtures/paper.pdf"
    ;;
  https://arxiv.org/html/2203.11355v1/figure1.png)
    cat "$fixtures/figure1.png"
    ;;
  *)
    printf 'fake ICU: unexpected URL: %s\n' "$url" >&2
    exit 69
    ;;
esac
