<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/readerSurfaceColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <Button android:id="@id/sources_button" android:layout_width="56dp"
            android:layout_height="48dp" android:text="☰" android:contentDescription="Sources"
            android:textColor="#ECECEC" android:backgroundTint="#292929" android:onClick="onClick" />
        <TextView android:id="@id/reader_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="IB" android:textSize="21sp" android:textColor="#ECECEC" android:paddingStart="16dp"
            android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@id/reflow_button" android:layout_width="140dp"
            android:layout_height="48dp" android:text="Reflow: Greedy" android:onClick="onClick"
            android:textColor="#ECECEC" android:backgroundTint="#292929" />
    </LinearLayout>
    <TextView android:id="@id/reader_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="#ACACAC" android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" android:maxLines="3" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:paddingHorizontal="12dp">
        <Button android:id="@id/back_button" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="Back" android:enabled="false" android:onClick="onClick"
            android:textColor="#ECECEC" android:backgroundTint="#292929" />
        <Button android:id="@id/forward_button" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="Forward" android:enabled="false" android:onClick="onClick"
            android:textColor="#ECECEC" android:backgroundTint="#292929" />
        <Button android:id="@id/cancel_button" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="Cancel" android:onClick="onClick"
            android:textColor="#ECECEC" android:backgroundTint="#292929" />
    </LinearLayout>
    <LinearLayout android:id="@id/sources_panel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="16dp" android:background="#212121" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sources" android:textSize="18sp" android:textColor="#ECECEC" />
        <EditText android:id="@id/reader_input" android:layout_width="match_parent"
            android:layout_height="64dp" android:gravity="top" android:inputType="text"
            android:singleLine="true" android:hint="URL or search terms" android:textSize="16sp" android:textColor="#ECECEC"
            android:textColorHint="#ACACAC" android:padding="8dp" />
        <Button android:id="@id/read_button" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Read" android:onClick="onClick"
            android:textColor="#171717" android:backgroundTint="#B8C7DE" />
        <Button android:id="@id/search_button" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Search Google" android:onClick="onClick"
            android:textColor="#171717" android:backgroundTint="#B8C7DE" />
        <Button android:id="@id/permission_button" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Authorize Shizuku" android:onClick="onClick"
            android:textColor="#ECECEC" android:backgroundTint="#292929" />
    </LinearLayout>
    <FrameLayout android:id="@id/google_acquisition_panel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
    <ScrollView android:id="@id/reader_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:padding="20dp">
        <org.isomorphisms.ib.NativeTextView android:id="@id/reader_body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:lineSpacingExtra="5dp"
            android:textColor="#ECECEC" android:textIsSelectable="true" android:fontFamily="sans"
            android:paddingBottom="40dp" />
    </ScrollView>
</LinearLayout>
