#!/usr/bin/env grease
# Stages remain separate: source/backend, parser, resources, packaging, signer.
if (len(ARGV) !== 12) {
  echo 'usage: grease build-reader.grease IB DRIVER PREFIX SCHEME AAPT FRAMEWORK ZIPALIGN APKSIGNER_JAR KEYSTORE NEW_OUTPUT GREASE DEXDUMP' >&2
  exit 2
}
var repository = ARGV[0]
var driver = ARGV[1]
var prefix = ARGV[2]
var scheme = ARGV[3]
var aapt = ARGV[4]
var framework = ARGV[5]
var zipalign = ARGV[6]
var signer = ARGV[7]
var keystore = ARGV[8]
var output = ARGV[9]
var grease = ARGV[10]
var dexdump = ARGV[11]
for path in "$repository" "$driver" "$prefix" "$scheme" "$aapt" "$framework" "$zipalign" "$signer" "$keystore" "$output" "$grease" "$dexdump" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
for program in "$driver" "$scheme" "$aapt" "$zipalign" "$grease" "$dexdump" { test -x "$program" }
for input in "$framework" "$signer" "$keystore" { test -s "$input" }
if test -e "$output" { echo 'refusing reused package output' >&2; exit 1 }
"$grease" "$repository/android-native/check-source.grease" "$repository"
mkdir -p "$output"
var source = "$repository/examples/autogenerated/native-reader"
var libraries = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$libraries" CHEZ="$scheme" \
  "$driver" --cg dex --source-dir "$source" --build-dir "$output/build" \
  --output-dir "$output" "$source/NativeReader.idric" -o reader > "$output/compile.txt" 2>&1
try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" }
if (_error.code !== 1) { echo 'FAIL checked native reader compiler diagnostics' >&2; exit 1 }
for suffix in dex dex.plan checked.anf smali { test -s "$output/reader.$suffix" }
"$dexdump" -c "$output/reader.dex" > "$output/dex-checksum.txt" 2>&1
"$dexdump" -d "$output/reader.dex" > "$output/dex-disassembly.txt" 2>&1
rg -q -F "Superclass        : 'Landroid/app/Activity;'" "$output/dex-disassembly.txt"
rg -q -F 'invoke-super' "$output/dex-disassembly.txt"
rg -q -F 'check-cast' "$output/dex-disassembly.txt"
rg -q -F 'setText' "$output/dex-disassembly.txt"

"$aapt" package -f -M "$repository/android-native/AndroidManifest.xml" \
  -S "$repository/android-native/res" -I "$framework" -F "$output/resources.apk"
"$aapt" dump resources "$output/resources.apk" > "$output/resources.txt"
for identity in '0x7f020000 org.isomorphisms.ib.prepaint:layout/reader:' \
  '0x7f030000 org.isomorphisms.ib.prepaint:id/reader_body:' \
  '0x7f030001 org.isomorphisms.ib.prepaint:id/reader_input:' \
  '0x7f030002 org.isomorphisms.ib.prepaint:id/sources_panel:' \
  '0x7f030003 org.isomorphisms.ib.prepaint:id/sources_button:' \
  '0x7f030004 org.isomorphisms.ib.prepaint:id/read_button:' {
  rg -q -F "$identity" "$output/resources.txt"
}
cp "$output/resources.apk" "$output/unsigned.apk"
cp "$output/reader.dex" "$output/classes.dex"
zip -q -j "$output/unsigned.apk" "$output/classes.dex"
"$zipalign" -f 4 "$output/unsigned.apk" "$output/aligned.apk"
var signing_classpath = "$signer:$(dirname "$signer")/apksig.jar"
test -s "$(dirname "$signer")/apksig.jar"
java -cp "$signing_classpath" com.android.apksigner.ApkSignerTool sign --ks "$keystore" --ks-pass pass:wegert-debug \
  --key-pass pass:wegert-debug --ks-key-alias wegert-debug \
  --out "$output/candidate.apk" "$output/aligned.apk"
java -cp "$signing_classpath" com.android.apksigner.ApkSignerTool verify --verbose --print-certs "$output/candidate.apk" > "$output/signer.txt" 2>&1
rg -q -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signer.txt"
"$aapt" dump badging "$output/candidate.apk" > "$output/badging.txt"
rg -q -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3'" "$output/badging.txt"
rg -q -F "launchable-activity: name='Idric.Generated'" "$output/badging.txt"
unzip -p "$output/candidate.apk" classes.dex > "$output/packaged.dex"
cmp "$output/reader.dex" "$output/packaged.dex"
"$zipalign" -c 4 "$output/candidate.apk"
mv "$output/candidate.apk" "$output/ib-native-reader-3.apk"
sha256sum "$source/NativeReader.idric" "$output/reader.dex" "$output/ib-native-reader-3.apk" > "$output/digests.txt"
echo 'PASS source-to-direct-DEX, parser, resource IDs, package identity, signer and packaged-byte equality' > "$output/result.txt"
echo 'NOT_RUN ART lifecycle, visible text/clicks, physical C67 replacement install' >> "$output/result.txt"
echo 'INCOMPLETE full source recovery/Longview/Binder/navigation migration' >> "$output/result.txt"
echo 'UNQUALIFIED inherited compiler bootstrap; no producer promotion/release' >> "$output/result.txt"
cat "$output/result.txt"
