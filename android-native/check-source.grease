#!/usr/bin/env grease
if (len(ARGV) !== 1) { echo 'usage: grease check-source.grease ABSOLUTE_IB_REPOSITORY' >&2; exit 2 }
var repository = ARGV[0]
if (repository[0] !== '/') { echo 'absolute repository path required' >&2; exit 2 }
test -f "$repository/src/IB/LongViewTask.idric"
test -f "$repository/examples/autogenerated/native-reader/NativeReader.idric"
var paths = $(git -C "$repository" ls-files --cached --others --exclude-standard)
try { printf '%s\n' "$paths" | rg -n '\.(java|kt|kts)$|(^|/)(gradlew|gradlew\.bat|build\.gradle|settings\.gradle|gradle\.properties)$' }
var status = _error.code
if (status === 0) { echo 'FAIL Java/Kotlin/Gradle application source remains' >&2; exit 1 }
if (status !== 1) { echo 'FAIL source-path inspection' >&2; exit 2 }
try { rg -n '^[[:space:]]*(gradle|gradlew|javac|d8)([[:space:]]|$)' "$repository/.github/workflows" "$repository/bin" }
setvar status = _error.code
if (status === 0) { echo 'FAIL Java compilation recipe remains' >&2; exit 1 }
if (status !== 1) { echo 'FAIL build-recipe inspection' >&2; exit 2 }
echo 'PASS no first-party Java/Kotlin/Gradle source or Java compilation recipe'
echo 'This source check does not establish full browser migration or device acceptance.'
