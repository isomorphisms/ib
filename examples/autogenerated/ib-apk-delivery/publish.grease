#!/usr/bin/env grease
# Retain a reviewed-source APK candidate; never merge or create a release.
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease publish.grease SDK EXPECTED_DELIVERY_HEAD NEW_EVIDENCE' >&2; exit 2 }
var sdk = ARGV[0]
var expected_head = ARGV[1]
var evidence = ARGV[2]
var branch = 'delivery/ib-reader-a7349efc'
if (ENV.DELIVERY_BRANCH !== branch) { echo 'FAIL unexpected publication branch' >&2; exit 2 }
for path in "$sdk" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused delivery evidence' >&2; exit 2 }
mkdir -p "$evidence/input"
printf '%s\n' "$expected_head" > "$evidence/expected-head"
rg -x '[0-9a-f]{40}' "$evidence/expected-head"
var live_head = $(gh api "repos/isomorphisms/ib/git/ref/heads/$branch" --jq .object.sha)
if (live_head !== expected_head) { echo 'FAIL delivery branch advanced before publication' >&2; exit 1 }
var authorization = ENV.GH_TOKEN
var source = 'f43af99856a8ad4161114863e681c118e38c2218'
var producer = '41370466399'
var producer_observer = 'cef5ae8eb891c97dba81cd7bfc6f36edebb44c53'
var independent_observer = 'ecea325a32d7d922540a51d6e460349d4d9fabef'
var independent_run = '41376593878'
var search_run = '41376593837'
var packaging_observer = 'cef5ae8eb891c97dba81cd7bfc6f36edebb44c53'
var packaging_run = '41367067272'
var input_table = 'examples/autogenerated/ib-apk-delivery/archives.tsv'
test "$(wc -l < "$input_table")" = 16
# Every row is frozen in this reviewed delivery source. Fixed repository and
# lane enums plus numeric/hash validation keep artifact data out of shell
# syntax, network hosts and Git reference names.
proc obtain(lane, expected_owner, directory) {
  var row = $(awk -F '\t' -v lane="$lane" '$1==lane {if(NF!=7)exit 2; print; n++} END {if(n!=1)exit 2}' "$input_table")
  var owner = $(printf '%s\n' "$row" | cut -f 2)
  var identifier = $(printf '%s\n' "$row" | cut -f 3)
  var amount = $(printf '%s\n' "$row" | cut -f 4)
  var checksum = $(printf '%s\n' "$row" | cut -f 5)
  var observer = $(printf '%s\n' "$row" | cut -f 6)
  var run = $(printf '%s\n' "$row" | cut -f 7)
  if (owner !== expected_owner) { echo 'FAIL archive owner mismatch' >&2; exit 1 }
  var expected_observer = independent_observer
  var expected_run = independent_run
  if (lane === 'source' or lane.startsWith('primary')) {
    setvar expected_observer = producer_observer
    setvar expected_run = producer
  } elif (lane === 'packaging') {
    setvar expected_observer = packaging_observer
    setvar expected_run = packaging_run
  } elif (lane.startsWith('decoding') or lane.startsWith('search')) {
    setvar expected_run = search_run
  }
  if (observer !== expected_observer or run !== expected_run) { echo 'FAIL frozen archive producer or observer mismatch' >&2; exit 1 }
  printf '%s\n' "$identifier" "$amount" "$run" | rg -x '[1-9][0-9]{0,19}' > "$evidence/$lane.numeric.txt"
  test "$(wc -l < "$evidence/$lane.numeric.txt")" = 3
  printf '%s\n' "$checksum" | rg -x '[0-9a-f]{64}'
  printf '%s\n' "$observer" | rg -x '[0-9a-f]{40}'
  var archive = "$evidence/$lane.zip"
  curl --fail --location --silent --show-error --max-time 300 --max-filesize 2147483648 \
    --header "Authorization: Bearer $authorization" \
    "https://api.github.com/repos/$owner/actions/artifacts/$identifier/zip" --output "$archive"
  test "$(wc -c < "$archive")" = "$amount"
  printf '%s  %s\n' "$checksum" "$archive" | sha256sum -c -
  unzip -Z1 "$archive" > "$evidence/$lane.entries.txt"
  awk 'substr($0,1,1)=="/" || $0~/(^|\/)\.\.(\/|$)/ {exit 1}' "$evidence/$lane.entries.txt"
  mkdir -p "$directory"
  if (lane === 'source') {
    unzip -q "$archive" -d "$directory" ib-commit.txt backend-commit.txt frontend-commit.txt \
      compiler.sha256 frontend-version.txt grease-version.txt \
      native-client/ib-native-boundary.apk native-client/activity.dex native-client/platform.dex \
      'native-client/payload/lib/*/libib_reader.so' 'native-client/*-commit.txt' \
      native-client/sha256.txt native-client/ndk.properties \
      native-client/reproduction.tsv native-client/reproduction.sha256 \
      native-client/package/evidence/inputs-sha256.txt \
      'native-client/native-*/sha256.txt' 'native-client/native-*/receipt.tsv'
  } elif (lane === 'packaging') {
    unzip -q "$archive" -d "$directory" '*.txt' '*.tsv' '*.sha256' '*.exit'
  } else {
    unzip -q "$archive" -d "$directory" '*.txt' '*.tsv' '*.sha256'
  }
  # Retain the frozen identity and exact selected bytes, not another temporary
  # copy of every compiler bundle, Arena body and emulator screenshot.
  rm "$archive"
}
# The producer's current conclusion and exact source are a publication gate.
test "$(gh api "repos/isomorphisms/ib/actions/runs/$producer" --jq .head_sha)" = "$source"
test "$(gh api "repos/isomorphisms/ib/actions/runs/$producer" --jq .conclusion)" = success
gh api "repos/isomorphisms/ib/actions/runs/$producer/jobs?per_page=100" \
  --jq '.jobs[] | [.name, .conclusion] | @tsv' > "$evidence/primary-jobs.tsv"
rg -q -x -F 'source-to-dex	success' "$evidence/primary-jobs.tsv"
for api in 29 34 { rg -q -x -F "Required reader ART API $api	success" "$evidence/primary-jobs.tsv" }
test "$(gh api "repos/isomorphisms/ai-ci/actions/runs/$independent_run" --jq .head_sha)" = "$independent_observer"
test "$(gh api "repos/isomorphisms/ai-ci/actions/runs/$independent_run" --jq .conclusion)" = success
test "$(gh api "repos/isomorphisms/ai-ci/actions/runs/$search_run" --jq .head_sha)" = "$independent_observer"
gh api "repos/isomorphisms/ai-ci/actions/runs/$search_run/jobs?per_page=100" \
  --jq '.jobs[] | [.name, .conclusion] | @tsv' > "$evidence/search-decoder-jobs.tsv"
for api in 29 34 { rg -q -x -F "installed API $api / decoding	success" "$evidence/search-decoder-jobs.tsv" }
# Independent packaging and reusable backend qualification are separate from
# reader behavior. Their exact commits and outcomes are publication gates.
test "$(gh api "repos/isomorphisms/ai-ci/actions/runs/$packaging_run" --jq .head_sha)" = "$packaging_observer"
test "$(gh api "repos/isomorphisms/ai-ci/actions/runs/$packaging_run" --jq .conclusion)" = success
obtain packaging isomorphisms/ai-ci "$evidence/packaging"
rg -q -x -F 'backend_source	153e7fc8053ba4072954a5e77d4efa3609d829e4' "$evidence/packaging/receipt.tsv"
rg -q -x -F 'baseline_source	9861b303a7e6d989125d80cee552a46cb2503555' "$evidence/packaging/receipt.tsv"
for field in caller_bytes_modes_mtimes_unchanged signed_APK_byte_reproduction {
  rg -q -x -F "$field	PASS" "$evidence/packaging/receipt.tsv"
}
rg -q -x -F 'old_producer_timestamp_control	REJECTED' "$evidence/packaging/receipt.tsv"
test "$(cat "$evidence/packaging/baseline-comparison.exit")" = 1
test "$(cat "$evidence/packaging/fixed-comparison.exit")" = 0
for backend_run in 41366980936 41366980897 41366980810 41366980828 41366974380 41366980911 {
  test "$(gh api "repos/isomorphisms/android-NDK/actions/runs/$backend_run" --jq .head_sha)" = 153e7fc8053ba4072954a5e77d4efa3609d829e4
  test "$(gh api "repos/isomorphisms/android-NDK/actions/runs/$backend_run" --jq .conclusion)" = success
  gh api "repos/isomorphisms/android-NDK/actions/runs/$backend_run" \
    --jq '[.id,.head_sha,.name,.conclusion,.run_attempt] | @tsv' >> "$evidence/backend-qualification.tsv"
}
obtain source isomorphisms/ib "$evidence/input"
var input = "$evidence/input"
test "$(cat "$input/ib-commit.txt")" = "$source"
test "$(cat "$input/native-client/ib-commit.txt")" = "$source"
test "$(cat "$input/backend-commit.txt")" = 153e7fc8053ba4072954a5e77d4efa3609d829e4
test "$(cat "$input/frontend-commit.txt")" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(cat "$input/native-client/observer-commit.txt")" = "$producer_observer"
var apk = "$input/native-client/ib-native-boundary.apk"
var tools = "$sdk/build-tools/35.0.0"
"$tools/apksigner" verify --verbose --print-certs "$apk" > "$evidence/signature.txt" 2>&1
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/signature.txt"
"$tools/aapt2" dump badging "$apk" > "$evidence/badging.txt"
rg -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3' versionName='0.3.0'" "$evidence/badging.txt"
rg -x -F "minSdkVersion:'29'" "$evidence/badging.txt"
rg -x -F "targetSdkVersion:'36'" "$evidence/badging.txt"
unzip -Z1 "$apk" > "$evidence/entries.txt"
for abi in x86_64 armeabi-v7a arm64-v8a {
  rg -x -F "lib/$abi/libib_reader.so" "$evidence/entries.txt"
  unzip -p "$apk" "lib/$abi/libib_reader.so" > "$evidence/$abi.so"
  cmp "$input/native-client/payload/lib/$abi/libib_reader.so" "$evidence/$abi.so"
}
unzip -p "$apk" classes.dex > "$evidence/classes.dex"
unzip -p "$apk" classes2.dex > "$evidence/classes2.dex"
cmp "$input/native-client/activity.dex" "$evidence/classes.dex"
cmp "$input/native-client/platform.dex" "$evidence/classes2.dex"
# Record every shipped worker DEX/native dependency from the signed candidate.
# Compare its existing manifest rather than assigning identities from filenames.
for asset in icu-worker.dex ib-worker.grease {
  rg -x -F "assets/$asset" "$evidence/entries.txt"
  unzip -p "$apk" "assets/$asset" > "$evidence/$asset"
}
var worker_dex_digest = $(sha256sum "$evidence/icu-worker.dex" | cut -d ' ' -f 1)
var worker_script_digest = $(sha256sum "$evidence/ib-worker.grease" | cut -d ' ' -f 1)
for abi in x86_64 armeabi-v7a arm64-v8a {
  for library in libib_grease.so libicu_transport.so {
    rg -x -F "lib/$abi/$library" "$evidence/entries.txt"
    unzip -p "$apk" "lib/$abi/$library" > "$evidence/$abi-$library"
  }
  unzip -p "$apk" "assets/worker-$abi.sha256" > "$evidence/$abi-worker-manifest"
  test "$(wc -c < "$evidence/$abi-worker-manifest")" = 270
  test "$(wc -l < "$evidence/$abi-worker-manifest")" = 5
  test "$(head -n 1 "$evidence/$abi-worker-manifest")" = IBWORKER1
  tail -n +2 "$evidence/$abi-worker-manifest" | rg -x '[0-9a-f]{64}' > "$evidence/$abi-manifest-hashes.txt"
  test "$(wc -l < "$evidence/$abi-manifest-hashes.txt")" = 4
  var grease_digest = $(sha256sum "$evidence/$abi-libib_grease.so" | cut -d ' ' -f 1)
  var icu_digest = $(sha256sum "$evidence/$abi-libicu_transport.so" | cut -d ' ' -f 1)
  printf '%s\n%s\n%s\n%s\n' "$grease_digest" "$icu_digest" "$worker_dex_digest" "$worker_script_digest" > "$evidence/$abi-actual-worker-hashes.txt"
  cmp "$evidence/$abi-manifest-hashes.txt" "$evidence/$abi-actual-worker-hashes.txt"
  printf 'worker_Grease_ELF_%s_sha256\t%s\nworker_ICU_ELF_%s_sha256\t%s\n' "$abi" "$grease_digest" "$abi" "$icu_digest" >> "$evidence/worker-identity.tsv"
}
var digest = $(sha256sum "$apk" | cut -d ' ' -f 1)
var original_digest = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$input/native-client/sha256.txt")
if (digest !== original_digest) { echo 'FAIL candidate APK differs from the source-bound build receipt' >&2; exit 1 }
for field in checked_Activity_platform_worker_DEX_repeat ICK_NDK_application_ELF_three_ABIs_repeat signed_APK_byte_reproduction {
  rg -q -x -F "$field	PASS" "$input/native-client/reproduction.tsv"
}
rg -q -x -F 'native_ICU_Grease_dependencies	REUSED_UNCHANGED_HASHED_INPUTS' "$input/native-client/reproduction.tsv"
var repeat_digest = $(awk '$2~/\/reproduction-package\/ib-material-reader[.]apk$/ {print $1}' "$input/native-client/reproduction.sha256")
var first_digest = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$input/native-client/reproduction.sha256")
if (repeat_digest !== digest or first_digest !== digest) { echo 'FAIL repeated signed APK differs from published candidate' >&2; exit 1 }
# Preserve only allowlisted public response metadata from the actual snapshots;
# never copy authorization headers, body text or transient query strings.
var observations = "$evidence/verified-observations.tsv"
printf 'schema\tib-frozen-runtime-observations-v1\n' > "$observations"
proc retain_observations(directory, lane) {
  rg --files "$directory" -g '*.tsv' > "$evidence/$lane.metadata-files.txt"
  for record in @(cat "$evidence/$lane.metadata-files.txt") {
    printf '%s\n' "$record" > "$evidence/$lane.record-path.txt"
    if rg -q '/(actual-arena|committed-arena|continuation-arena|early-link-arena)/receipts/[A-Za-z0-9._-]+[.]tsv$' "$evidence/$lane.record-path.txt" {
      test "$(wc -c < "$record")" -le 16384
      tr -cd '\011\012\040-\176' < "$record" | cmp -s - "$record"
      var record_hash = $(sha256sum "$record" | cut -d ' ' -f 1)
      awk -F '\t' -v lane="$lane" -v root="$directory/" -v path="$record" -v digest="$record_hash" '
        BEGIN {
          OFS="\t"
          relative=substr(path,length(root)+1)
          print "snapshot_receipt_sha256",lane,relative,digest
          n=split("schema request_id source_key source_generation http_status mime_type charset content_encoding utf8 redirect_count declared_length received_length transport arena_name arena_offset arena_end byte_count sha256 reopen_check acquisition_complete navigation_admitted transfer_decoding",fields," ")
          for(i=1;i<=n;i++)allowed[fields[i]]=1
        }
        NF!=2 {exit 1}
        $1=="requested_url" || $1=="resolved_url" {
          value=$2
          sub(/\?.*/,"?[QUERY_OMITTED]",value)
          print "observed",lane,relative,$1,value
          next
        }
        $1=="redirect_chain" {print "observed",lane,relative,"redirect_chain_retained_in_frozen_archive","YES";next}
        allowed[$1] {print "observed",lane,relative,$1,$2}
      ' "$record" >> "$observations"
    }
  }
}
# Independently observed exact APK bytes, not a rebuilt approximation.
for lane in primary-29 primary-34 full-29 full-34 fragments-29 fragments-34 lifecycle-29 lifecycle-34 links-29 links-34 decoding-29 decoding-34 search-29 search-34 {
  var api = '29'
  if (lane.endsWith('-34')) { setvar api = '34' }
  var owner = 'isomorphisms/ai-ci'
  if (lane.startsWith('primary')) { setvar owner = 'isomorphisms/ib' }
  var directory = "$evidence/independent-$lane"
  obtain "$lane" "$owner" "$directory"
  if (lane.startsWith('primary')) {
    var primary = "$directory/ib-input"
    rg -q -x -F "source	$source" "$primary/receipt.tsv"
    rg -q -x -F 'producer_APK_digests	PASS' "$primary/receipt.tsv"
    rg -q -x -F 'recompilation	NONE' "$primary/receipt.tsv"
    var observed_apk = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$primary/candidate.sha256")
    if (observed_apk !== digest) { echo 'FAIL primary Android input differs from published candidate' >&2; exit 1 }
    var required = "$directory/ib-observed/required.tsv"
    rg -q -x -F 'schema	ib-required-observers-v5' "$required"
    rg -q -x -F "api	$api" "$required"
    for field in core_exit source_reflow_exit html_anchors_exit large_source_exit parcelable_exit installed_exit navigation_exit fragment_viewport_exit Activity_ownership_exit link_shapes_exit {
      rg -q -x -F "$field	0" "$required"
    }
  } else {
    var replay = "$directory/ib-installed-replay"
    test "$(cat "$replay/observer-commit.txt")" = "$independent_observer"
    rg -q -x -F "source	$source" "$replay/input-identity.tsv"
    var observed_apk = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$replay/candidate-sha256.txt")
    if (observed_apk !== digest) { echo 'FAIL independent observer consumed different APK bytes' >&2; exit 1 }
    for name in ib-native-boundary.apk ib-native-uid-bypass.apk ib-native-death-noop.apk \
      ib-native-strict-flags.apk ib-native-stale-authorization.apk ib-native-anchor-zero.apk \
      ib-native-resume-noop.apk ib-native-detach-any.apk ib-native-anchor-reset.apk ib-native-single-scroll.apk {
      var producer_hash = $(awk -v name="$name" '{n=split($2,p,"/"); if(p[n]==name)print $1}' "$input/native-client/sha256.txt")
      var replay_hash = $(awk -v name="$name" '{n=split($2,p,"/"); if(p[n]==name)print $1}' "$replay/candidate-sha256.txt")
      printf '%s\n' "$producer_hash" | rg -x '[0-9a-f]{64}'
      if (producer_hash !== replay_hash) { echo 'FAIL independent original or compiled mutant differs from the producer' >&2; exit 1 }
    }
    var installed = "$replay/profile/installed/receipt.tsv"
    if (lane.startsWith('full')) { setvar installed = "$replay/profile/full/installed/receipt.tsv" }
    if (lane.startsWith('decoding') or lane.startsWith('search')) { setvar installed = "$replay/observed/receipt.tsv" }
    rg -q -x -F "api	$api" "$installed"
    rg -q -x -F 'dead_authority_RPC_without_notification	PASS' "$installed"
    rg -q -x -F 'compiled_missing_callback_and_RPC_revocation	REJECTED' "$installed"
    if (lane.startsWith('full')) {
      var required = "$replay/profile/full/required.tsv"
      rg -q -x -F 'schema	ib-required-observers-v5' "$required"
      rg -q -x -F "api	$api" "$required"
      for field in core_exit source_reflow_exit html_anchors_exit large_source_exit parcelable_exit installed_exit navigation_exit fragment_viewport_exit Activity_ownership_exit link_shapes_exit {
        rg -q -x -F "$field	0" "$required"
      }
      rg -q -x -F 'compiled_native_zero_point	REJECTED' "$replay/profile/full/fragments/receipt.tsv"
      rg -q -x -F 'compiled_native_stale_cursor_animation	REJECTED' "$replay/profile/full/fragments/receipt.tsv"
      for field in SDK_collapsed_caret_on_visible_fragment_line frame_timed_real_DOWN_UP_after_reflow actual_early_link_new_ICU_source independent_early_link_original_bytes {
        rg -q -x -F "$field	PASS" "$replay/profile/full/fragments/receipt.tsv"
      }
      rg -q -x -F 'compiled_native_single_scroll	REJECTED' "$replay/profile/full/fragments/receipt.tsv"
      rg -q -x -F 'actual_ICU_request_before_process_kill	PASS' "$replay/profile/full/lifecycle/receipt.tsv"
      rg -q -x -F 'completed_response_unchanged_state_claim	REJECTED' "$replay/profile/full/lifecycle/receipt.tsv"
      rg -q -x -F 'once_encoded_UTF8_query_observed_by_real_HTTP_server	PASS' "$replay/profile/full/link-shapes/receipt.tsv"
    } elif (lane.startsWith('fragments')) {
      var result = "$replay/profile/fragments/receipt.tsv"
      for field in actual_touch_fragment_link strict_UTF8_fragment_target SDK_target_visibility_and_beginning_exclusion SDK_collapsed_caret_on_visible_fragment_line original_HTML_and_committed_ranges ordered_history offline_Back_Forward_positions Arena_bytes_unchanged_offline frame_timed_real_DOWN_UP_after_reflow actual_early_link_new_ICU_source independent_early_link_original_bytes {
        rg -q -x -F "$field	PASS" "$result"
      }
      rg -q -x -F 'compiled_native_zero_point	REJECTED' "$result"
      rg -q -x -F 'compiled_native_stale_cursor_animation	REJECTED' "$result"
      rg -q -x -F 'compiled_native_single_scroll	REJECTED' "$result"
      rg -q -x -F 'changed_committed_source	REJECTED' "$result"
    } elif (lane.startsWith('lifecycle')) {
      var result = "$replay/profile/lifecycle/receipt.tsv"
      for field in original_application_PID_death legitimate_recreation_allowed_without_old_source_publication framework_two_Activities_and_return retained_current_source_on_resume new_navigation_after_return three_original_ranges_and_fixture_digests ordered_history resume_without_refetch offline_Activity_return_Back_Forward actual_ICU_request_before_process_kill held_response_released_after_observed_process_death source_history_receipts_unchanged_after_pending_acquisition_loss independent_last_good_readback_after_process_loss {
        rg -q -x -F "$field	PASS" "$result"
      }
      rg -q -x -F 'completed_response_unchanged_state_claim	REJECTED' "$result"
      rg -q -x -F 'deliberately_stale_checked_destroy	REFUSED' "$result"
      rg -q -x -F 'compiled_resume_noop	REJECTED' "$result"
      rg -q -x -F 'compiled_detach_any_owner	REJECTED' "$result"
      rg -q -x -F 'changed_committed_source	REJECTED' "$result"
    } elif (lane.startsWith('links')) {
      var result = "$replay/profile/links/receipt.tsv"
      for field in actual_native_touches supported_base relative root_relative query_only once_encoded_UTF8_query_observed_by_real_HTTP_server absolute_HTTP cross_origin_HTTPS six_original_source_ranges_and_digests ordered_retained_history offline_Back_Forward_without_refetch {
        rg -q -x -F "$field	PASS" "$result"
      }
      rg -q -x -F 'changed_source	REJECTED' "$result"
      rg -q -x -F 'forged_requested_URL	REJECTED' "$result"
    } elif (lane.startsWith('decoding')) {
      rg -q -x -F 'certificate_trust_negative	REJECTED' "$replay/navigation/receipt.tsv"
      rg -q -x -F 'checksummed_semantic_journal_corruption	REJECTED' "$replay/navigation/receipt.tsv"
      rg -q -x -F 'actual_ICU_windows1252_ISO88591	PASS' "$replay/encoding/receipt.tsv"
      rg -q -x -F 'actual_post_snapshot_shell_UID	2000' "$replay/encoding/receipt.tsv"
      rg -q -x -F 'source_faithful_decoded_clipboard	PASS' "$replay/encoding/receipt.tsv"
      rg -q -x -F 'independent_original_bytes_identity_generation_digest	PASS' "$replay/encoding/receipt.tsv"
    } else {
      rg -q -x -F 'ChordReader_source	e6c84d645ad7086a11ae2735258188a49e444d13' "$replay/search/handoff/receipt.tsv"
      rg -q -x -F 'actual_ChordReader_search_button	PASS' "$replay/search/handoff/receipt.tsv"
      rg -q -x -F 'exact_once_encoded_Google_request	PASS' "$replay/search/handoff/receipt.tsv"
      rg -q -x -F 'Google_original_byte_generation_request_identity_mutations	REJECTED' "$replay/search/handoff/receipt.tsv"
      rg -q -x -F 'Google_results	NOT_RUN' "$replay/search/handoff/receipt.tsv"
      # Public results are recorded as failed only when this fresh run
      # actually followed the provided first-party continuation and refused it.
      var continuation = "$replay/search/continuation-receipt.tsv"
      rg -q -x -F 'schema	ib-Google-native-continuation-observation-v1' "$continuation"
      rg -q -x -F 'actual_first_party_touch	OBSERVED' "$continuation"
      for field in original_href_membership committed_original_range_digest {
        rg -q -x -F "$field	PASS" "$continuation"
      }
      rg -q -x -F 'changed_committed_byte	REJECTED' "$continuation"
      rg -q -x -F 'public_Google_results	NOT_RUN' "$continuation"
      rg -q -x -F 'clicked_public_result	NOT_RUN' "$continuation"
    }
  }
  retain_observations "$directory" "$lane"
}
var size = $(wc -c < "$apk")
var receipt = "$evidence/ib-reader-f43af998.receipt.tsv"
printf 'schema\tib-reviewable-apk-candidate-v2\nsource\t%s\nsource_run\t%s\ncompiler_source\t153e7fc8053ba4072954a5e77d4efa3609d829e4\nfrontend_source\t740bbf2b1d9e811fd00c719c3473eede17ceea3b\nproducer_observer\t%s\nindependent_observer\t%s\nindependent_profile_run\t%s\nindependent_search_decoder_run\t%s\npackage\torg.isomorphisms.ib.prepaint\nversion_code\t3\nversion_name\t0.3.0\nminimum_API\t29\ntarget_API\t36\npackaged_ABIs\tx86_64,armeabi-v7a,arm64-v8a\nsigner_sha256\tde9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9\nAPK_byte_count\t%s\nAPK_sha256\t%s\n' \
  "$source" "$producer" "$producer_observer" "$independent_observer" "$independent_run" "$search_run" "$size" "$digest" > "$receipt"
printf 'main_reader_API29_API34\tPASS\nindependent_fragment_viewport_API29_API34\tPASS\ncompiled_zero_fragment_point\tREJECTED\ncompiled_stale_cursor_animation\tREJECTED\nframe_timed_real_link_touch_API29_API34\tPASS\ncompiled_single_scroll_interception\tREJECTED\nindependent_early_link_source\tPASS\nindependent_Activity_ownership_API29_API34\tPASS\ncompiled_resume_noop_and_detach_any\tREJECTED\nindependent_native_link_shapes_and_once_encoded_UTF8_query_API29_API34\tPASS\nindependent_full_unchanged_IB_observe_all_API29_API34\tPASS\npending_ICU_process_loss_API29_API34\tPASS\ncompleted_response_unchanged_state_claim\tREJECTED\nChordReader_source\te6c84d645ad7086a11ae2735258188a49e444d13\nChordReader_version_code\t1002\nChordReader_x86_64_APK_sha256\t808786b3783a769c1692783efdac14e0d97bb4c3bb71970fee3677c5e247853b\nindependent_legacy_decoding_replay_API29_API34\tPASS\nauthenticated_ChordReader_handoff\tPASS\nGoogle_results\tFAIL\nclicked_public_result\tNOT_RUN\nphysical_TAB_P10\tBLOCKED\nphysical_signer_ABI_SDK_inventory\tNOT_RUN\nphysical_replacement_install\tBLOCKED\nrelease_decision\tINSUFFICIENT\n' >> "$receipt"
var activity_digest = $(sha256sum "$evidence/classes.dex" | cut -d ' ' -f 1)
var platform_digest = $(sha256sum "$evidence/classes2.dex" | cut -d ' ' -f 1)
printf 'Activity_DEX_sha256\t%s\nplatform_DEX_sha256\t%s\n' "$activity_digest" "$platform_digest" >> "$receipt"
printf 'worker_ICU_DEX_sha256\t%s\nworker_Grease_script_sha256\t%s\nworker_manifests_match_signed_bytes\tPASS\n' "$worker_dex_digest" "$worker_script_digest" >> "$receipt"
cat "$evidence/worker-identity.tsv" >> "$receipt"
for abi in x86_64 armeabi-v7a arm64-v8a {
  var elf_digest = $(sha256sum "$evidence/$abi.so" | cut -d ' ' -f 1)
  printf 'native_ELF_%s_sha256\t%s\n' "$abi" "$elf_digest" >> "$receipt"
}
for component in icu Idric-Net appendfat Grease-packaging {
  var source_pin = $(cat "$input/native-client/${component}-commit.txt")
  printf '%s\n' "$source_pin" | rg -x '[0-9a-f]{40}'
  printf '%s_source\t%s\n' "$component" "$source_pin" >> "$receipt"
}
printf 'ICK_source\tfbe86e23d55cfec2000c08e61deea2a407fd7175\nGrease_worker_source\t5651cf97a1b5042f24f14112a7ade9a1518eb0bc\nCat_Food_bootstrap_source\t609a9628d5a52860f956bf62e0914a0cd03292ae\nGrease_bootstrap_source\tf19c94c6df18cddbdc1e81463e5bd689533e3c13\nNDK_declared\t27.2.12479018\nSDK_build_tools_declared\t35.0.0\nactual_runtime_APIs\t29,34\nactual_runtime_ABI\tx86_64\nARM_runtime\tNOT_RUN\n' >> "$receipt"
var actual_ndk = $(awk -F ' = ' '$1=="Pkg.Revision"{print $2}' "$input/native-client/ndk.properties")
if (actual_ndk !== '27.2.12479018') { echo 'FAIL observed NDK revision differs from the qualified input' >&2; exit 1 }
printf 'NDK_observed\t%s\n' "$actual_ndk" >> "$receipt"
"$tools/aapt2" version > "$evidence/aapt2-version.txt"
"$tools/apksigner" version > "$evidence/apksigner-version.txt"
sha256sum "$tools/aapt2" "$tools/zipalign" "$tools/apksigner" > "$evidence/packaging-tool-sha256.txt"
sed 's/^/verification_packaging_tool\t/' "$evidence/packaging-tool-sha256.txt" >> "$receipt"
sed 's/^/producer_packaging_input\t/' "$input/native-client/package/evidence/inputs-sha256.txt" >> "$receipt"
sed 's/^/aapt2_version\t/' "$evidence/aapt2-version.txt" >> "$receipt"
sed 's/^/apksigner_version\t/' "$evidence/apksigner-version.txt" >> "$receipt"
printf 'independent_packaging_observer\t%s\nindependent_packaging_run\t%s\n' "$packaging_observer" "$packaging_run" >> "$receipt"
sed 's/^/independent_packaging\t/' "$evidence/packaging/receipt.tsv" >> "$receipt"
sed 's/^/independent_packaging_hash\t/' "$evidence/packaging/rebuilt-sha256.txt" >> "$receipt"
sed 's/^/backend_qualification\t/' "$evidence/backend-qualification.tsv" >> "$receipt"
var backend_archives = 'examples/autogenerated/ib-apk-delivery/backend-archives.tsv'
awk -F '\t' 'NF!=5 || $1!~/^[1-9][0-9]*$/ || $2!~/^[1-9][0-9]*$/ || $3!~/^[1-9][0-9]*$/ || length($4)!=64 || $4~/[^0-9a-f]/ || $5!~/^[A-Za-z0-9._-]+$/ {exit 1} END {if(NR!=9)exit 1}' "$backend_archives"
sed 's/^/backend_archive\t/' "$backend_archives" >> "$receipt"
sed 's/^/actual_DEX_compiler_binary\t/' "$input/compiler.sha256" >> "$receipt"
sed 's/^/actual_frontend_version\t/' "$input/frontend-version.txt" >> "$receipt"
sed 's/^/actual_build_Grease_version\t/' "$input/grease-version.txt" >> "$receipt"
for abi in x86_64 armeabi-v7a arm64-v8a {
  sed "s/^/actual_ICK_application_build_$abi\t/" "$input/native-client/native-$abi/receipt.tsv" >> "$receipt"
  sed "s/^/actual_ICK_application_tool_hash_$abi\t/" "$input/native-client/native-$abi/sha256.txt" >> "$receipt"
}
sed 's/^/application_reproduction\t/' "$input/native-client/reproduction.tsv" >> "$receipt"
sed 's/^/application_reproduction_hash\t/' "$input/native-client/reproduction.sha256" >> "$receipt"
sed 's/^/archive\t/' "$input_table" >> "$receipt"
rg -q '^snapshot_receipt_sha256' "$observations"
cat "$observations" >> "$receipt"
# The GitHub API requires JSON. Fixed paths and validated hashes only are
# inserted into these bodies; credentials and source contents never become
# shell syntax or public receipt fields.
printf '{"encoding":"base64","content":"' > "$evidence/apk-blob.json"
base64 -w0 "$apk" >> "$evidence/apk-blob.json"
printf '"}\n' >> "$evidence/apk-blob.json"
var apk_blob = $(gh api --method POST repos/isomorphisms/ib/git/blobs \
  --input "$evidence/apk-blob.json" --jq .sha)
var receipt_blob = $(gh api --method POST repos/isomorphisms/ib/git/blobs \
  --field "content=@$receipt" --raw-field encoding=utf-8 --jq .sha)
var ledger_file = 'examples/autogenerated/ib-apk-delivery/integration-ledger.md'
test -s "$ledger_file"
rg -q -F 'f43af99856a8ad4161114863e681c118e38c2218' "$ledger_file"
var ledger_blob = $(gh api --method POST repos/isomorphisms/ib/git/blobs \
  --field "content=@$ledger_file" --raw-field encoding=utf-8 --jq .sha)
var base_tree = $(gh api "repos/isomorphisms/ib/git/commits/$expected_head" --jq .tree.sha)
for hash in "$apk_blob" "$receipt_blob" "$ledger_blob" "$base_tree" {
  printf '%s\n' "$hash" > "$evidence/API-hash"
  rg -x '[0-9a-f]{40}' "$evidence/API-hash"
}
printf '{"base_tree":"%s","tree":[{"path":"candidates/ib-reader-f43af998.apk","mode":"100644","type":"blob","sha":"%s"},{"path":"candidates/ib-reader-f43af998.receipt.tsv","mode":"100644","type":"blob","sha":"%s"},{"path":"candidates/ib-reader-f43af998.ledger.md","mode":"100644","type":"blob","sha":"%s"}]}\n' \
  "$base_tree" "$apk_blob" "$receipt_blob" "$ledger_blob" > "$evidence/tree.json"
var tree = $(gh api --method POST repos/isomorphisms/ib/git/trees --input "$evidence/tree.json" --jq .sha)
printf '%s\n' "$tree" > "$evidence/tree-sha"
rg -x '[0-9a-f]{40}' "$evidence/tree-sha"
printf '{"message":"Retain the exact independently exercised native IB APK candidate","tree":"%s","parents":["%s"]}\n' \
  "$tree" "$expected_head" > "$evidence/commit.json"
var published = $(gh api --method POST repos/isomorphisms/ib/git/commits --input "$evidence/commit.json" --jq .sha)
printf '%s\n' "$published" > "$evidence/published-sha"
rg -x '[0-9a-f]{40}' "$evidence/published-sha"
var before_update = $(gh api "repos/isomorphisms/ib/git/ref/heads/$branch" --jq .object.sha)
if (before_update !== expected_head) { echo 'FAIL delivery branch advanced; candidate objects remain unreferenced' >&2; exit 1 }
# A non-forced fast-forward to our direct child also rejects a concurrent
# branch change occurring after the read above. No application/source branch
# or release reference is writable through this fixed target.
gh api --method PATCH "repos/isomorphisms/ib/git/refs/heads/$branch" \
  --raw-field "sha=$published" --field force=false --jq .object.sha > "$evidence/updated-head"
var updated = $(cat "$evidence/updated-head")
if (updated !== published) { echo 'FAIL unexpected delivery reference result' >&2; exit 1 }
printf 'https://raw.githubusercontent.com/isomorphisms/ib/%s/candidates/ib-reader-f43af998.apk\n' "$published" > "$evidence/direct-APK-URL.txt"
cat "$receipt"
printf 'candidate_commit\t%s\n' "$published"
cat "$evidence/direct-APK-URL.txt"
