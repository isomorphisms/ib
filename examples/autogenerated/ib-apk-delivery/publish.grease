#!/usr/bin/env grease
# Retain a reviewed-source APK candidate; never merge or create a release.
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease publish.grease SDK EXPECTED_DELIVERY_HEAD NEW_EVIDENCE' >&2; exit 2 }
var sdk = ARGV[0]
var expected_head = ARGV[1]
var evidence = ARGV[2]
var branch = 'delivery/ib-reader-a7349efc'
if (ENV.DELIVERY_BRANCH !== branch) { echo 'FAIL unexpected publication branch' >&2; exit 2 }
for path in "$sdk" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused delivery evidence' >&2; exit 2 }
mkdir -p "$evidence/input"
printf '%s\n' "$expected_head" > "$evidence/expected-head"
rg -x '[0-9a-f]{40}' "$evidence/expected-head"
var live_head = $(gh api "repos/isomorphisms/ib/git/ref/heads/$branch" --jq .object.sha)
if (live_head !== expected_head) { echo 'FAIL delivery branch advanced before publication' >&2; exit 1 }
var authorization = ENV.GH_TOKEN
var archive = "$evidence/source-bound-candidate.zip"
curl --fail --location --silent --show-error --max-time 300 \
  --header "Authorization: Bearer $authorization" \
  https://api.github.com/repos/isomorphisms/ib/actions/artifacts/13092196333/zip --output "$archive"
test "$(wc -c < "$archive")" = 921674882
printf '0b20640e265b5f76114f0d9f4db09bd15f67c8b2951059d14ef47b8dce7f3f53  %s\n' "$archive" | sha256sum -c -
unzip -q "$archive" -d "$evidence/input"
var input = "$evidence/input"
test "$(cat "$input/ib-commit.txt")" = fb9b34a92328551aa043137a4bba8b58084f2955
test "$(cat "$input/native-client/ib-commit.txt")" = fb9b34a92328551aa043137a4bba8b58084f2955
test "$(cat "$input/backend-commit.txt")" = 6e1c9619a96f28494ad891a32a06edfb72f3e25b
test "$(cat "$input/frontend-commit.txt")" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
var apk = "$input/native-client/ib-native-boundary.apk"
var tools = "$sdk/build-tools/35.0.0"
"$tools/apksigner" verify --verbose --print-certs "$apk" > "$evidence/signature.txt" 2>&1
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/signature.txt"
"$tools/aapt2" dump badging "$apk" > "$evidence/badging.txt"
rg -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3' versionName='0.3.0'" "$evidence/badging.txt"
rg -x -F "minSdkVersion:'29'" "$evidence/badging.txt"
rg -x -F "targetSdkVersion:'36'" "$evidence/badging.txt"
unzip -Z1 "$apk" > "$evidence/entries.txt"
for abi in x86_64 armeabi-v7a arm64-v8a {
  rg -x -F "lib/$abi/libib_reader.so" "$evidence/entries.txt"
  unzip -p "$apk" "lib/$abi/libib_reader.so" > "$evidence/$abi.so"
  cmp "$input/native-client/payload/lib/$abi/libib_reader.so" "$evidence/$abi.so"
}
unzip -p "$apk" classes.dex > "$evidence/classes.dex"
unzip -p "$apk" classes2.dex > "$evidence/classes2.dex"
cmp "$input/native-client/activity.dex" "$evidence/classes.dex"
cmp "$input/native-client/platform.dex" "$evidence/classes2.dex"
var digest = $(sha256sum "$apk" | cut -d ' ' -f 1)
var original_digest = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$input/native-client/sha256.txt")
if (digest !== original_digest) { echo 'FAIL candidate APK differs from the source-bound build receipt' >&2; exit 1 }
# Bind independent observations to these exact candidate bytes. Search
# archives qualify only caller/query/original-byte handoff, not public results.
for lane in decoding-29 decoding-34 search-29 search-34 {
  var artifact = '13092736563'
  var archive_size = '12260022'
  var archive_digest = '627b3c61324bf0509b43492a0930c3d5733ffb691dc03e58ca4601bfbc86d6ae'
  var api = '29'
  if (lane === 'decoding-34') {
    setvar artifact = '13091659160'
    setvar archive_size = '19243836'
    setvar archive_digest = 'd45a9490b4921b454e3bcaa2122cfc117ac9cf5894fb859f080016a174d78ca9'
    setvar api = '34'
  } elif (lane === 'search-29') {
    setvar artifact = '13092417318'
    setvar archive_size = '12968633'
    setvar archive_digest = '2660c5cf5cc3226c82586f45324a6e83344a53b8d9eaeeca4a6f1932cf99c02e'
  } elif (lane === 'search-34') {
    setvar artifact = '13092696825'
    setvar archive_size = '20806041'
    setvar archive_digest = '3b021cb657bdaf70d7cd9ccaff38de5d3ddac057d67e5ca970c1428281844243'
    setvar api = '34'
  }
  var original = "$evidence/independent-$lane.zip"
  curl --fail --location --silent --show-error --max-time 180 \
    --header "Authorization: Bearer $authorization" \
    "https://api.github.com/repos/isomorphisms/ai-ci/actions/artifacts/$artifact/zip" --output "$original"
  test "$(wc -c < "$original")" = "$archive_size"
  printf '%s  %s\n' "$archive_digest" "$original" | sha256sum -c -
  mkdir -p "$evidence/independent-$lane"
  unzip -q "$original" -d "$evidence/independent-$lane"
  var replay = "$evidence/independent-$lane/ib-installed-replay"
  test "$(cat "$replay/observer-commit.txt")" = edb7064a179597ba1ea37927627e2efe2a6c13bd
  rg -q -x -F 'source	fb9b34a92328551aa043137a4bba8b58084f2955' "$replay/input-identity.tsv"
  var observed_apk = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$replay/candidate-sha256.txt")
  if (observed_apk !== digest) { echo 'FAIL independent replay consumed a different APK' >&2; exit 1 }
  rg -q -x -F "api	$api" "$replay/observed/receipt.tsv"
  rg -q -x -F 'dead_authority_RPC_without_notification	PASS' "$replay/observed/receipt.tsv"
  rg -q -x -F 'compiled_missing_callback_and_RPC_revocation	REJECTED' "$replay/observed/receipt.tsv"
  rg -q -x -F 'certificate_trust_negative	REJECTED' "$replay/navigation/receipt.tsv"
  rg -q -x -F 'checksummed_semantic_journal_corruption	REJECTED' "$replay/navigation/receipt.tsv"
  if (lane.startsWith('decoding')) {
    rg -q -x -F 'actual_ICU_windows1252_ISO88591	PASS' "$replay/encoding/receipt.tsv"
    rg -q -x -F 'source_faithful_decoded_clipboard	PASS' "$replay/encoding/receipt.tsv"
    rg -q -x -F 'independent_original_bytes_identity_generation_digest	PASS' "$replay/encoding/receipt.tsv"
  } else {
    rg -q -x -F 'actual_ChordReader_search_button	PASS' "$replay/search/handoff/receipt.tsv"
    rg -q -x -F 'exact_once_encoded_Google_request	PASS' "$replay/search/handoff/receipt.tsv"
    rg -q -x -F 'Google_original_byte_generation_request_identity_mutations	REJECTED' "$replay/search/handoff/receipt.tsv"
    rg -q -x -F 'Google_results	NOT_RUN' "$replay/search/handoff/receipt.tsv"
  }
  printf '%s\t%s\t%s\t%s\n' "$lane" "$artifact" "$archive_digest" "$digest" >> "$evidence/independent-inputs.tsv"
}
var size = $(wc -c < "$apk")
var receipt = "$evidence/ib-reader-fb9b34a9.receipt.tsv"
printf 'schema\tib-reviewable-apk-candidate-v1\nsource\tfb9b34a92328551aa043137a4bba8b58084f2955\nsource_run\t41324363104\nsource_artifact\t13092196333\nsource_archive_sha256\t0b20640e265b5f76114f0d9f4db09bd15f67c8b2951059d14ef47b8dce7f3f53\npackage\torg.isomorphisms.ib.prepaint\nversion_code\t3\nversion_name\t0.3.0\nminimum_API\t29\ntarget_API\t36\npackaged_ABIs\tx86_64,armeabi-v7a,arm64-v8a\nsigner_sha256\tde9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9\nAPK_byte_count\t%s\nAPK_sha256\t%s\nmain_reader_API29_API34\tPASS\nauthenticated_ChordReader_handoff\tPASS\nGoogle_results_and_clicked_result\tFAIL\nphysical_TAB_P10\tBLOCKED\nphysical_signer_ABI_SDK_inventory\tNOT_RUN\nrelease_decision\tINSUFFICIENT\n' "$size" "$digest" > "$receipt"
printf 'compiler_source\t6e1c9619a96f28494ad891a32a06edfb72f3e25b\nfrontend_source\t740bbf2b1d9e811fd00c719c3473eede17ceea3b\n' >> "$receipt"
var activity_digest = $(sha256sum "$evidence/classes.dex" | cut -d ' ' -f 1)
var platform_digest = $(sha256sum "$evidence/classes2.dex" | cut -d ' ' -f 1)
printf 'Activity_DEX_sha256\t%s\nplatform_DEX_sha256\t%s\n' "$activity_digest" "$platform_digest" >> "$receipt"
for abi in x86_64 armeabi-v7a arm64-v8a {
  var elf_digest = $(sha256sum "$evidence/$abi.so" | cut -d ' ' -f 1)
  printf 'native_ELF_%s_sha256\t%s\n' "$abi" "$elf_digest" >> "$receipt"
}
printf 'checksummed_history_recovery_API29_API34\tPASS\nemulator_replacement_install\tPASS\nindependent_legacy_decoding_replay_API29_API34\tPASS\nreal_untrusted_certificate_negative\tREJECTED\nphysical_replacement_install\tBLOCKED\n' >> "$receipt"
printf 'independent_observer\tedb7064a179597ba1ea37927627e2efe2a6c13bd\nindependent_run\t41328116370\ndead_RPC_without_notification\tPASS\ncompiled_stale_authorization\tREJECTED\nGoogle_response_class\tredirect-only-partial\nfragment_viewport\tNOT_RUN\n' >> "$receipt"
cat "$evidence/independent-inputs.tsv" >> "$receipt"
# The GitHub API requires JSON. Fixed paths and validated hashes only are
# inserted into these bodies; credentials and source contents never become
# shell syntax or public receipt fields.
printf '{"encoding":"base64","content":"' > "$evidence/apk-blob.json"
base64 -w0 "$apk" >> "$evidence/apk-blob.json"
printf '"}\n' >> "$evidence/apk-blob.json"
var apk_blob = $(gh api --method POST repos/isomorphisms/ib/git/blobs \
  --input "$evidence/apk-blob.json" --jq .sha)
var receipt_blob = $(gh api --method POST repos/isomorphisms/ib/git/blobs \
  --field "content=@$receipt" --raw-field encoding=utf-8 --jq .sha)
var base_tree = $(gh api "repos/isomorphisms/ib/git/commits/$expected_head" --jq .tree.sha)
for hash in "$apk_blob" "$receipt_blob" "$base_tree" {
  printf '%s\n' "$hash" > "$evidence/API-hash"
  rg -x '[0-9a-f]{40}' "$evidence/API-hash"
}
printf '{"base_tree":"%s","tree":[{"path":"candidates/ib-reader-fb9b34a9.apk","mode":"100644","type":"blob","sha":"%s"},{"path":"candidates/ib-reader-fb9b34a9.receipt.tsv","mode":"100644","type":"blob","sha":"%s"}]}\n' \
  "$base_tree" "$apk_blob" "$receipt_blob" > "$evidence/tree.json"
var tree = $(gh api --method POST repos/isomorphisms/ib/git/trees --input "$evidence/tree.json" --jq .sha)
printf '%s\n' "$tree" > "$evidence/tree-sha"
rg -x '[0-9a-f]{40}' "$evidence/tree-sha"
printf '{"message":"Retain the exact independently exercised native IB APK candidate","tree":"%s","parents":["%s"]}\n' \
  "$tree" "$expected_head" > "$evidence/commit.json"
var published = $(gh api --method POST repos/isomorphisms/ib/git/commits --input "$evidence/commit.json" --jq .sha)
printf '%s\n' "$published" > "$evidence/published-sha"
rg -x '[0-9a-f]{40}' "$evidence/published-sha"
var before_update = $(gh api "repos/isomorphisms/ib/git/ref/heads/$branch" --jq .object.sha)
if (before_update !== expected_head) { echo 'FAIL delivery branch advanced; candidate objects remain unreferenced' >&2; exit 1 }
# A non-forced fast-forward to our direct child also rejects a concurrent
# branch change occurring after the read above. No application/source branch
# or release reference is writable through this fixed target.
gh api --method PATCH "repos/isomorphisms/ib/git/refs/heads/$branch" \
  --raw-field "sha=$published" --field force=false --jq .object.sha > "$evidence/updated-head"
var updated = $(cat "$evidence/updated-head")
if (updated !== published) { echo 'FAIL unexpected delivery reference result' >&2; exit 1 }
printf 'https://raw.githubusercontent.com/isomorphisms/ib/%s/candidates/ib-reader-fb9b34a9.apk\n' "$published" > "$evidence/direct-APK-URL.txt"
cat "$receipt"
printf 'candidate_commit\t%s\n' "$published"
cat "$evidence/direct-APK-URL.txt"
