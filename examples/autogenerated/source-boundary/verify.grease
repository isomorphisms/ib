#!/usr/bin/env grease
if (len(ARGV) !== 3) { echo 'usage: grease verify.grease IB GREASE NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var grease = ARGV[1]
var evidence = ARGV[2]
for path in "$repository" "$grease" "$evidence" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'refusing reused boundary evidence' >&2; exit 1 }
var fixture = "$evidence/fixture"
mkdir -p "$fixture/src/IB" "$fixture/examples/autogenerated/native-reader" "$fixture/.github/workflows" "$fixture/bin"
cp "$repository/src/IB/LongViewTask.idric" "$fixture/src/IB/"
cp "$repository/examples/autogenerated/native-reader/NativeReader.idric" "$fixture/examples/autogenerated/native-reader/"
git -C "$fixture" init -q
git -C "$fixture" add src examples
"$grease" "$repository/android-native/check-source.grease" "$fixture" > "$evidence/positive.txt" 2>&1
rg -q -F 'PASS no first-party Java/Kotlin/Gradle' "$evidence/positive.txt"
printf '%s\n' '// Deliberately forbidden source-path fixture; never compiled.' > "$fixture/RejectedBoundary.java"
try { "$grease" "$repository/android-native/check-source.grease" "$fixture" > "$evidence/java-refusal.txt" 2>&1 }
if (_error.code !== 1) { echo 'FAIL Java path was not refused' >&2; exit 1 }
rg -q -F 'FAIL Java/Kotlin/Gradle application source remains' "$evidence/java-refusal.txt"
rm "$fixture/RejectedBoundary.java"
"$grease" "$repository/android-native/check-source.grease" "$fixture" > "$evidence/java-recovery.txt" 2>&1
printf '%s\n' 'javac RejectedBoundary.java' > "$fixture/bin/rejected-recipe"
try { "$grease" "$repository/android-native/check-source.grease" "$fixture" > "$evidence/recipe-refusal.txt" 2>&1 }
if (_error.code !== 1) { echo 'FAIL javac recipe was not refused' >&2; exit 1 }
rg -q -F 'FAIL Java compilation recipe remains' "$evidence/recipe-refusal.txt"
rm "$fixture/bin/rejected-recipe"
"$grease" "$repository/android-native/check-source.grease" "$fixture" > "$evidence/recipe-recovery.txt" 2>&1
"$grease" "$repository/android-native/check-source.grease" "$repository" > "$evidence/actual-ib.txt" 2>&1
echo 'PASS actual IB absence, Java path refusal, javac recipe refusal and clean recoveries'
