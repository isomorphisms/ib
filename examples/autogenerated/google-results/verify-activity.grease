#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify-activity.grease IB BACKEND FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var baksmali = ARGV[3]
var evidence = ARGV[4]
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence/source"
cp -R "$repository/src/IB" "$evidence/source/IB"
cp "$repository/examples/autogenerated/native-reader/NativeReader.idric" "$evidence/source/"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
"$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
  --source-dir "$evidence/source" --build-dir "$evidence/build" --output-dir "$evidence" \
  "$evidence/source/NativeReader.idric" -o activity > "$evidence/compiler.txt" 2>&1
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/compiler.txt" { cat "$evidence/compiler.txt"; exit 1 }
java -jar "$baksmali" disassemble "$evidence/activity.dex" -o "$evidence/decoded"
rg -x -F '.method public static reader_dom_acquisition_ready(Landroid/app/Activity;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;ILjava/lang/String;I)V' "$evidence/decoded/Idric/Generated.smali"
var boundary = "$repository/examples/autogenerated/native-shizuku"
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$boundary" \
  --build-dir "$evidence/boundary-build" --output-dir "$evidence" \
  "$boundary/ParcelableBoundary.idric" -o boundary > "$evidence/boundary-compiler.txt" 2>&1
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/boundary-compiler.txt" { cat "$evidence/boundary-compiler.txt"; exit 1 }
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
"$evidence/boundary" --client "$evidence/platform.dex" > "$evidence/boundary-generation.txt" 2>&1
java -jar "$baksmali" disassemble "$evidence/platform.dex" -o "$evidence/platform-decoded"
rg -x -F '.super Landroid/webkit/WebViewClient;' "$evidence/platform-decoded/org/isomorphisms/ib/GoogleAcquisitionClient.smali"
rg -x -F '.method public native onReceiveValue(Ljava/lang/Object;)V' "$evidence/platform-decoded/org/isomorphisms/ib/GoogleDomCallback.smali"
sha256sum "$evidence/activity.dex" "$evidence/platform.dex" > "$evidence/outputs.sha256"
printf 'checked_Idric_DEX\tPASS\ntyped_framework_callbacks\tPASS\nindependent_disassembly\tPASS\nART\tNOT_RUN\nGoogle_live_results\tNOT_RUN\n' > "$evidence/receipt.tsv"
