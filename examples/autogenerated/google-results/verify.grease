#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease verify.grease IB FRONTEND NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var evidence = ARGV[2]
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence/source"
cp -R "$repository/src/IB" "$evidence/source/IB"
cp "$repository/examples/autogenerated/google-results/GoogleResultsChecks.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/google-results/BrowserResultsChecks.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/google-results/GoogleLayoutChecks.idric" "$evidence/source/"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
try {
  "$frontend/_/build/exec/idris2" --source-dir "$evidence/source" --build-dir "$evidence/build" --output-dir "$evidence" \
    "$evidence/source/GoogleResultsChecks.idric" -o checks > "$evidence/compiler.txt" 2>&1
}
var status = _error.code
if (status !== 0) { cat "$evidence/compiler.txt"; exit "$status" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/compiler.txt" { cat "$evidence/compiler.txt"; exit 1 }
"$evidence/checks" > "$evidence/actual.txt" 2>&1
cat "$evidence/actual.txt"
try {
  "$frontend/_/build/exec/idris2" --source-dir "$evidence/source" --build-dir "$evidence/build" --output-dir "$evidence" \
    "$evidence/source/BrowserResultsChecks.idric" -o browser-checks > "$evidence/browser-compiler.txt" 2>&1
}
setvar status = _error.code
if (status !== 0) { cat "$evidence/browser-compiler.txt"; exit "$status" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/browser-compiler.txt" { cat "$evidence/browser-compiler.txt"; exit 1 }
"$evidence/browser-checks" > "$evidence/browser-actual.txt" 2>&1
cat "$evidence/browser-actual.txt"
try {
  "$frontend/_/build/exec/idris2" --source-dir "$evidence/source" --build-dir "$evidence/build" --output-dir "$evidence" \
    "$evidence/source/GoogleLayoutChecks.idric" -o layout-checks > "$evidence/layout-compiler.txt" 2>&1
}
setvar status = _error.code
if (status !== 0) { cat "$evidence/layout-compiler.txt"; exit "$status" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/layout-compiler.txt" { cat "$evidence/layout-compiler.txt"; exit 1 }
"$evidence/layout-checks" > "$evidence/layout-actual.txt" 2>&1
cat "$evidence/layout-actual.txt"
printf 'checked_host_result_semantics\tPASS\nGoogle_live_results\tNOT_RUN\nAndroid_ART\tNOT_RUN\nphysical_ARM\tNOT_RUN\n' > "$evidence/receipt.tsv"
