#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease verify-server.grease IB QUALIFIED_ICK NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var compiler = ARGV[1]
var evidence = ARGV[2]
for path in "$repository" "$compiler" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
test -x "$compiler"
if test -e "$evidence" { echo 'FAIL reused fixture evidence' >&2; exit 2 }
umask 077
mkdir -p "$evidence"
var fixture = "$repository/examples/autogenerated/admin-longview-fixture"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "$fixture/server.c" -o "$evidence/server"
var fixture_pid = ''
trap --add EXIT {
  if (len(fixture_pid) > 0) { try { kill -TERM "$fixture_pid" }; try { wait "$fixture_pid" } }
  rm -f "$evidence/one-time.private" "$evidence/cookies.private"
}
proc start(label) {
  fork { exec "$evidence/server" 18493 "$fixture" > "$evidence/$label.stdout" 2> "$evidence/$label.stderr" }
  setglobal fixture_pid = $!
  var ready = false
  for attempt in @(seq 1 50) {
    if rg -q -x -F 'READY 18493' "$evidence/$label.stdout" { setvar ready = true; break }
    sleep 0.1
  }
  if (not ready) { cat "$evidence/$label.stderr" >&2; echo 'FAIL fixture did not bind' >&2; exit 1 }
}
proc counts(label) {
  curl --fail --silent --show-error --max-time 5 http://127.0.0.1:18493/counts > "$evidence/$label.tsv"
  if rg -q 'IB_SYNTHETIC_ONLY_|Cookie|password|token|secret' "$evidence/$label.tsv" {
    echo 'FAIL fixture counters contain non-counter material' >&2; exit 1
  }
}
proc expect(file, name, expected) {
  var actual = $(awk -F '\t' -v key="$name" '$1==key{print $2}' "$file")
  if (actual !== expected) { echo "FAIL fixture counter $name" >&2; exit 1 }
}
start original
counts initial
for field in usable_actions verification_actions value_attempts value_deliveries ambiguous_effects page_requests slow_assets_requested parent_served_bytes {
  expect "$evidence/initial.tsv" "$field" 0
}
var status = $(curl --silent --show-error --max-time 5 -X POST -o /dev/null -w '%{http_code}' http://127.0.0.1:18493/action)
if (status !== '403') { echo 'FAIL pre-verification action accepted' >&2; exit 1 }
var impostor = $(curl --silent --show-error --max-time 5 -X POST -H 'Cookie: NotIBFixtureVerified=yes' \
  -o /dev/null -w '%{http_code}' http://127.0.0.1:18493/action)
if (impostor !== '403') { echo 'FAIL malformed fixture verification accepted' >&2; exit 1 }
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:18493/fake-interactive > "$evidence/fake.html"
counts fake
expect "$evidence/fake.tsv" usable_actions 0
expect "$evidence/fake.tsv" value_deliveries 0
curl --fail --silent --show-error --max-time 5 -X POST http://127.0.0.1:18493/usable-control > "$evidence/action-confirmation.txt"
printf 'confirmed\n' > "$evidence/expected-confirmation.txt"
cmp "$evidence/expected-confirmation.txt" "$evidence/action-confirmation.txt"
curl --fail --silent --show-error --max-time 5 -X POST -c "$evidence/cookies.private" \
  http://127.0.0.1:18493/verification-complete > "$evidence/verification.txt"
curl --fail --silent --show-error --max-time 5 -X POST -b "$evidence/cookies.private" \
  http://127.0.0.1:18493/action > "$evidence/one-time.private"
if ! rg -q -x 'IB_SYNTHETIC_ONLY_[0-9a-f]{32}' "$evidence/one-time.private" {
  echo 'FAIL one-time fixture result shape' >&2; exit 1
}
rm -f "$evidence/one-time.private"
var repeated = $(curl --silent --show-error --max-time 5 -X POST -b "$evidence/cookies.private" \
  -o /dev/null -w '%{http_code}' http://127.0.0.1:18493/action)
if (repeated !== '409') { echo 'FAIL repeated one-time delivery' >&2; exit 1 }
try {
  curl --silent --show-error --max-time 5 -X POST -b "$evidence/cookies.private" \
    -o /dev/null http://127.0.0.1:18493/ambiguous > "$evidence/ambiguous.stdout" 2> "$evidence/ambiguous.stderr"
}
var ambiguous_status = _error.code
if (ambiguous_status !== 18) { echo 'FAIL ambiguous response did not end with missing response bytes' >&2; exit 1 }
printf '%s\n' "$ambiguous_status" > "$evidence/ambiguous.exit"
counts completed
expect "$evidence/completed.tsv" usable_actions 1
expect "$evidence/completed.tsv" verification_actions 1
expect "$evidence/completed.tsv" value_attempts 4
expect "$evidence/completed.tsv" value_deliveries 1
expect "$evidence/completed.tsv" ambiguous_effects 1
for attempt in @(seq 1 3) {
  curl --fail --silent --show-error --max-time 5 -b "$evidence/cookies.private" \
    -o /dev/null http://127.0.0.1:18493/
}
counts reloaded
expect "$evidence/reloaded.tsv" value_attempts 4
expect "$evidence/reloaded.tsv" value_deliveries 1
expect "$evidence/reloaded.tsv" ambiguous_effects 1
expect "$evidence/reloaded.tsv" page_requests 3
if rg -q 'IB_SYNTHETIC_ONLY_' "$evidence/original.stdout" "$evidence/original.stderr" {
  echo 'FAIL fixture server logged the synthetic value' >&2; exit 1
}
kill -TERM "$fixture_pid"
wait "$fixture_pid"
setglobal fixture_pid = ''
start fresh
counts fresh
for field in usable_actions verification_actions value_attempts value_deliveries ambiguous_effects page_requests slow_assets_requested parent_served_bytes {
  expect "$evidence/fresh.tsv" "$field" 0
}
kill -TERM "$fixture_pid"
wait "$fixture_pid"
setglobal fixture_pid = ''
git -C "$repository" rev-parse HEAD > "$evidence/source-head.txt"
sha256sum "$compiler" "$fixture/server.c" "$fixture/AdminFixture.idric" "$fixture/admin.html" \
  "$fixture/ready.js" "$fixture/verify.html" "$fixture/fake-interactive.html" "$evidence/server" > "$evidence/digests.txt"
printf 'schema\tib-admin-fixture-host-v1\nfixture_toolchain\tick\nactual_http_server\tPASS\nunverified_action\tREJECTED\nfalse_cookie_prefix\tREJECTED\nusable_control_post\tPASS\none_time_result\tPASS\nrepeated_value\tREJECTED\nambiguous_remote_effect\tPASS\nread_only_reload_no_replay\tPASS\nsecret_free_server_output\tPASS\nfresh_process_zero_state\tPASS\nAndroid_action\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
