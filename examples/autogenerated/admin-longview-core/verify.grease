#!/usr/bin/env grease
# Host semantics and compiled refusal controls; Android acceptance is separate.
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease verify.grease IB FRONTEND NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var evidence = ARGV[2]
for path in "$repository" "$frontend" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence directory already exists' >&2; exit 2 }
test -x "$frontend/_/build/exec/idris2"
mkdir -p "$evidence"
git -C "$repository" rev-parse HEAD > "$evidence/source-base.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend.txt"
sha256sum "$repository/src/IB/LongViewTask.idric" \
  "$repository/src/IB/LongViewLifecycle.idric" \
  "$repository/src/IB/LongViewNative.idric" \
  "$repository/examples/autogenerated/admin-longview-core/AdminLongViewCoreChecks.idric" \
  > "$evidence/source.sha256"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
for variant in candidate wrong-host stale-renderer false-session {
  var target = "$evidence/$variant"
  mkdir -p "$target/source/IB"
  cp "$repository/src/IB/LongViewTask.idric" "$target/source/IB/"
  cp "$repository/src/IB/LongViewLifecycle.idric" "$target/source/IB/"
  cp "$repository/src/IB/LongViewNative.idric" "$target/source/IB/"
  cp "$repository/examples/autogenerated/admin-longview-core/AdminLongViewCoreChecks.idric" "$target/source/"
  if (variant === 'wrong-host') {
    rg -x -F '      identity_text observation.observed_host ≟ identity_text task.host_process_identity &&' "$target/source/IB/LongViewLifecycle.idric"
    sed -i 's/^      identity_text observation[.]observed_host ≟ identity_text task[.]host_process_identity \&\&$/      True \&\&/' "$target/source/IB/LongViewLifecycle.idric"
  }
  if (variant === 'stale-renderer') {
    rg -x -F '      observation.observed_renderer_generation ≟ task.renderer_generation' "$target/source/IB/LongViewLifecycle.idric"
    sed -i 's/^      observation[.]observed_renderer_generation ≟ task[.]renderer_generation$/      True/' "$target/source/IB/LongViewLifecycle.idric"
  }
  if (variant === 'false-session') {
    sed -i '/^reconstruction_committed task =$/,/^export$/s/^    task[.]continuity task[.]session$/    task.continuity authenticated_session_confirmed/' "$target/source/IB/LongViewTask.idric"
  }
  try {
    "$frontend/_/build/exec/idris2" --source-dir "$target/source" --build-dir "$target/build" --output-dir "$target" \
      "$target/source/AdminLongViewCoreChecks.idric" -o checks > "$target/compiler.txt" 2>&1
  }
  var compile_status = _error.code
  printf '%s\n' "$compile_status" > "$target/compiler.exit"
  if (compile_status !== 0) { cat "$target/compiler.txt"; exit "$compile_status" }
  if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$target/compiler.txt" { cat "$target/compiler.txt"; exit 1 }
  try { "$target/checks" > "$target/actual.txt" 2>&1 }
  var status = _error.code
  printf '%s\n' "$status" > "$target/actual.exit"
  if (variant === 'candidate') {
    if (status !== 0) { cat "$target/actual.txt"; exit "$status" }
    rg -x -F 'PASS invalid projection selectors fail closed' "$target/actual.txt"
    cat "$target/actual.txt"
  } else {
    if (status !== 1) { cat "$target/actual.txt"; echo 'FAIL mutation did not reach an assertion refusal' >&2; exit 1 }
    var expected = 'FAIL page commit remains unconfirmed without a usable action'
    if (variant === 'wrong-host') { setvar expected = 'FAIL wrong host callback refuses' }
    if (variant === 'stale-renderer') { setvar expected = 'FAIL wrong renderer generation refuses' }
    rg -x -F "$expected" "$target/actual.txt"
    printf '\033[32mPASS\033[0m compiled %s control refused at its designated assertion\n' "$variant"
  }
  sha256sum "$target/checks" "$target/checks_app/checks.ss" > "$target/executable.sha256"
}
printf 'checked_host_semantics\tPASS\ncompiled_wrong_host\tPASS\ncompiled_stale_renderer\tPASS\ncompiled_false_session\tPASS\nAndroid_ART\tNOT_RUN\nphysical_C67\tNOT_RUN\nlive_Google_YouTube\tNOT_RUN\n' > "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m checked protected-task host semantics; Android and live acceptance NOT_RUN\n'
