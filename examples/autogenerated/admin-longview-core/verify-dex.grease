#!/usr/bin/env grease
# Compile the actual codec through checked DEX; this is not installed ART.
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify-dex.grease IB FRONTEND BACKEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var backend = ARGV[2]
var baksmali = ARGV[3]
var evidence = ARGV[4]
for path in "$repository" "$frontend" "$backend" "$baksmali" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence directory already exists' >&2; exit 2 }
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
mkdir -p "$evidence/source/IB"
cp "$repository/src/IB/LongViewTask.idric" "$evidence/source/IB/"
cp "$repository/src/IB/LongViewLifecycle.idric" "$evidence/source/IB/"
cp "$repository/src/IB/LongViewNative.idric" "$evidence/source/IB/"
cp "$repository/examples/autogenerated/admin-longview-core/AdminLongViewCoreProbe.idric" "$evidence/source/"
git -C "$repository" rev-parse HEAD > "$evidence/source-base.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend.txt"
git -C "$backend" rev-parse HEAD > "$evidence/backend.txt"
sha256sum "$evidence/source/IB/LongViewTask.idric" "$evidence/source/IB/LongViewLifecycle.idric" \
  "$evidence/source/IB/LongViewNative.idric" "$evidence/source/AdminLongViewCoreProbe.idric" > "$evidence/source.sha256"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
try {
  "$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
    --source-dir "$evidence/source" --build-dir "$evidence/build" --output-dir "$evidence" \
    "$evidence/source/AdminLongViewCoreProbe.idric" -o core > "$evidence/compiler.txt" 2>&1
}
var status = _error.code
printf '%s\n' "$status" > "$evidence/compiler.exit"
if (status !== 0) { cat "$evidence/compiler.txt"; exit "$status" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/compiler.txt" { cat "$evidence/compiler.txt"; exit 1 }
test -s "$evidence/core.dex"
java -jar "$baksmali" disassemble "$evidence/core.dex" -o "$evidence/decoded"
for declaration in \
  '.method public static admin_core_start(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;' \
  '.method public static admin_core_open(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;' \
  '.method public static admin_core_attach(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;' \
  '.method public static admin_core_observe(Ljava/lang/String;ILjava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;III)Ljava/lang/String;' \
  '.method public static admin_core_field(Ljava/lang/String;I)Ljava/lang/String;' \
  '.method public static admin_core_counter(Ljava/lang/String;I)I' {
  rg -x -F "$declaration" "$evidence/decoded/Idric/Generated.smali"
}
sha256sum "$evidence/core.dex" > "$evidence/output.sha256"
printf 'checked_core_DEX\tPASS\nindependent_disassembly\tPASS\ninstalled_Activity\tNOT_RUN\nAndroid_ART\tNOT_RUN\nphysical_C67\tNOT_RUN\nlive_Google_YouTube\tNOT_RUN\n' > "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m production codec DEX and independent disassembly; installed and live acceptance NOT_RUN\n'
