#!/usr/bin/env grease
# Reproduce the actual retained-source consumer; no Android or parser substitute.
if (len(ARGV) !== 9) {
  echo 'usage: grease replay.grease IB DRIVER MODULES PREFIX PACKAGES SCHEME SUPPORT FRESH_EVIDENCE pure|managed' >&2
  exit 2
}
var repository = ARGV[0]
var driver = ARGV[1]
var modules = ARGV[2]
var prefix = ARGV[3]
var packages = ARGV[4]
var scheme = ARGV[5]
var support = ARGV[6]
var evidence = ARGV[7]
var mode = ARGV[8]
if (mode !== 'pure' and mode !== 'managed') { echo 'FAIL mode must be pure or managed' >&2; exit 2 }
for path in "$repository" "$driver" "$modules" "$prefix" "$packages" "$scheme" "$support" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
for program in "$driver" "$scheme" { test -x "$program" }
for directory in "$repository/src" "$modules" "$prefix" "$packages" "$support" { test -d "$directory" }
var example = "$repository/examples/autogenerated/native-source-projection"
var source_name = 'NativeSourceProjection.idric'
var output_name = 'source'
if (mode === 'managed') {
  setvar source_name = 'NativeSourceProjectionCommand.idric'
  setvar output_name = 'source-command'
}
var source = "$example/$source_name"
test -s "$source"
test -s "$support/chez/support.ss"
git -C "$repository" diff --quiet -- src
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 1 }
mkdir -p "$evidence/source"
cp -a "$repository/src/." "$evidence/source/"
cp "$source" "$evidence/source/$source_name"
cmp "$source" "$evidence/source/$source_name"
git -C "$repository" rev-parse HEAD > "$evidence/ib-source-ref.txt"
sha256sum "$example/NativeSourceProjection.idric" "$source" "$driver" \
  "${driver}_app/idric-dex.so" "$repository/src/IB/Information.idric" \
  "$repository/src/IB/RecoveredInformation.idric" > "$evidence/inputs.sha256"
printf '\033[36mACTION\033[0m compile source-title consumer in %s mode\n' "$mode"
try {
  env IDRIS2_PREFIX="$prefix" IDRIS2_PACKAGE_PATH="$packages" \
    IDRIS2_DATA="$support" IDRIS2_LIBS="$support/c" CHEZ="$scheme" \
    IDRIS2_CG=chez IDRIS2_PATH="$modules" \
    "$driver" --cg dex --source-dir "$evidence/source" \
    --build-dir "$evidence/build" --output-dir "$evidence" \
    "$evidence/source/$source_name" -o "$output_name" \
    > "$evidence/compiler.log" 2>&1
}
var compiler_status = _error.code
printf '%s\n' "$compiler_status" > "$evidence/compiler.exit"
if (compiler_status !== 0) {
  cat "$evidence/compiler.log"
  test ! -e "$evidence/$output_name.dex"
  printf 'mode\t%s\nsource_emission\tBLOCKED\ncompiler_exit\t%s\nDEX\tABSENT\nART\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' "$mode" "$compiler_status" > "$evidence/status.tsv"
  printf '\033[31mBLOCKED\033[0m retained-source DEX compilation; actual exit %s\n' "$compiler_status" >&2
  exit 1
}
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/compiler.log" {
  echo 'FAIL source compiler returned success with an error diagnostic' >&2
  exit 1
}
for suffix in dex dex.plan checked.anf smali { test -s "$evidence/$output_name.$suffix" }
sha256sum "$evidence/$output_name.dex" > "$evidence/output.sha256"
printf 'mode\t%s\nsource_emission\tPASS\nART\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' "$mode" > "$evidence/status.tsv"
printf '\033[32mPASS\033[0m %s entrypoint emitted DEX; execution NOT_RUN\n' "$mode"
