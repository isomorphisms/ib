#!/usr/bin/env grease
# Observe the actual package and platform UI; do not replace candidate behavior.
set -eu -o pipefail
if (len(ARGV) !== 4 and len(ARGV) !== 5) {
  echo 'usage: grease verify-screen.grease SDK APK ADB FRESH_EVIDENCE [fresh|replace]' >&2
  exit 2
}
var sdk = ARGV[0]
var apk = ARGV[1]
var adb = ARGV[2]
var evidence = ARGV[3]
var mode = 'fresh'
if (len(ARGV) === 5) { setvar mode = ARGV[4] }
if (mode !== 'fresh' and mode !== 'replace') { exit 2 }
for path in "$sdk" "$apk" "$adb" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL refusing reused screen evidence' >&2; exit 1 }
mkdir -p "$evidence"
var package = 'org.isomorphisms.ib.material3'
proc observe_bounds(label, hierarchy) {
  var bounds = $(sed 's/></>\n</g' "$hierarchy" | rg -F "text=\"$label\"" | sed -n 's/.*bounds="\(\[[^"]*\]\)".*/\1/p')
  var digits = $(echo "$bounds" | tr -cs '0-9' ' ' | sed 's/^ *//;s/ *$//')
  var points = digits.split(' ')
  if (len(points) !== 4) { echo 'FAIL ambiguous observed button' >&2; return 1 }
  var x = (int(points[0]) + int(points[2])) // 2
  var y = (int(points[1]) + int(points[3])) // 2
  "$adb" -s emulator-5554 shell input tap "$x" "$y"
}

proc visible_reader(name) {
  for attempt in @(seq 1 3) {
    "$adb" -s emulator-5554 shell uiautomator dump "/data/local/tmp/ib-reader-$name.xml" > "$evidence/$name-dump-$attempt.txt" 2>&1
    "$adb" -s emulator-5554 pull "/data/local/tmp/ib-reader-$name.xml" "$evidence/$name-attempt-$attempt.xml" > "$evidence/$name-pull-$attempt.txt" 2>&1
    var hierarchy = "$evidence/$name-attempt-$attempt.xml"
    if rg -q -F 'An experimental personal browser' "$hierarchy" {
      cp "$hierarchy" "$evidence/$name.xml"
      return 0
    }
    # Only the already observed host-wide software-emulator watchdog dialog
    # admits Wait. Candidate crashes, app ANRs and unknown screens still fail.
    if rg -q -F -e "Process system isn't responding" -e "System UI isn't responding" "$hierarchy" {
      "$adb" -s emulator-5554 logcat -b all -d > "$evidence/$name-system-anr-$attempt.txt"
      observe_bounds Wait "$hierarchy"
      sleep 5
    } else { echo 'FAIL native reader is not the visible screen' >&2; return 1 }
  }
  echo 'FAIL software emulator remained unresponsive' >&2
  return 1
}
"$sdk/build-tools/35.0.0/apksigner" verify --print-certs "$apk" > "$evidence/signature.txt"
rg -q -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/signature.txt"
sha256sum "$apk" > "$evidence/apk-sha256.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$evidence/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$evidence/abi.txt"
test "$(tr -d '\r' < "$evidence/sdk.txt")" = 34
test "$(tr -d '\r' < "$evidence/abi.txt")" = x86_64
"$adb" -s emulator-5554 shell pm list packages "$package" > "$evidence/prior-package.txt"
if (mode === 'fresh') {
  if rg -q -x -F "package:$package" "$evidence/prior-package.txt" { echo 'FAIL fresh install target already has package' >&2; exit 1 }
  "$adb" -s emulator-5554 install "$apk" > "$evidence/install.txt" 2>&1
} else {
  rg -q -x -F "package:$package" "$evidence/prior-package.txt"
  var prior_path = $("$adb" -s emulator-5554 shell pm path "$package" | tr -d '\r' | sed 's/^package://')
  if (not prior_path.startsWith('/data/app/') or not prior_path.endsWith('/base.apk')) { exit 1 }
  "$adb" -s emulator-5554 pull "$prior_path" "$evidence/prior.apk" > "$evidence/prior-pull.txt" 2>&1
  "$sdk/build-tools/35.0.0/apksigner" verify --print-certs "$evidence/prior.apk" > "$evidence/prior-signature.txt"
  rg -q -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/prior-signature.txt"
  "$adb" -s emulator-5554 install -r "$apk" > "$evidence/install.txt" 2>&1
}
rg -q -x -F Success "$evidence/install.txt"
var installed_path = $("$adb" -s emulator-5554 shell pm path "$package" | tr -d '\r' | sed 's/^package://')
if (not installed_path.startsWith('/data/app/') or not installed_path.endsWith('/base.apk')) { exit 1 }
"$adb" -s emulator-5554 pull "$installed_path" "$evidence/installed.apk" > "$evidence/installed-pull.txt" 2>&1
cmp "$apk" "$evidence/installed.apk"
printf '%s\n' "$mode" > "$evidence/install-mode.txt"
"$adb" -s emulator-5554 shell wm density 160 > "$evidence/density.txt"
"$adb" -s emulator-5554 shell wm size 320x640 > "$evidence/narrow-size.txt"
"$adb" -s emulator-5554 shell am start -W -n "$package/Idric.Generated" > "$evidence/launch.txt" 2>&1
rg -q -x -F 'Status: ok' "$evidence/launch.txt"
sleep 3
"$adb" -s emulator-5554 shell pidof "$package" > "$evidence/process.txt"
test -s "$evidence/process.txt"
visible_reader narrow
rg -q -F 'text="Open source"' "$evidence/narrow.xml"
rg -q -F 'Architecture and ownership' "$evidence/narrow.xml"
rg -q -F 'An experimental personal browser' "$evidence/narrow.xml"
"$adb" -s emulator-5554 exec-out screencap -p > "$evidence/narrow.png"
"$adb" -s emulator-5554 shell input swipe 160 530 160 180 800
sleep 2
"$adb" -s emulator-5554 shell uiautomator dump /data/local/tmp/ib-reader-scroll.xml > "$evidence/scroll-dump.txt" 2>&1
"$adb" -s emulator-5554 pull /data/local/tmp/ib-reader-scroll.xml "$evidence/scroll.xml" > "$evidence/scroll-pull.txt" 2>&1
if cmp -s "$evidence/narrow.xml" "$evidence/scroll.xml" { echo 'FAIL scroll did not change the visible hierarchy' >&2; exit 1 }
"$adb" -s emulator-5554 exec-out screencap -p > "$evidence/scroll.png"
"$adb" -s emulator-5554 shell wm size 720x640 > "$evidence/wide-size.txt"
"$adb" -s emulator-5554 shell am force-stop "$package"
"$adb" -s emulator-5554 shell am start -W -n "$package/Idric.Generated" > "$evidence/wide-launch.txt" 2>&1
sleep 3
visible_reader wide
rg -q -F 'An experimental personal browser' "$evidence/wide.xml"
"$adb" -s emulator-5554 exec-out screencap -p > "$evidence/wide.png"
# Coordinates come from the observed source button, rather than a guessed tap.
observe_bounds 'Open source' "$evidence/wide.xml"
sleep 3
"$adb" -s emulator-5554 shell dumpsys activity activities > "$evidence/source-action.txt"
rg -q -F 'ChooserActivity' "$evidence/source-action.txt"
"$adb" -s emulator-5554 exec-out screencap -p > "$evidence/source-chooser.png"
"$adb" -s emulator-5554 shell dumpsys package "$package" > "$evidence/installed-package.txt"
"$adb" -s emulator-5554 logcat -b all -d > "$evidence/logcat.txt"
echo 'PASS Android native reader fresh install, launch, visible source text, scrolling, two widths and source chooser' > "$evidence/result.txt"
echo 'Exact text/selection/reflow oracle, update, physical devices and live source/store wiring remain separate' >> "$evidence/result.txt"
cat "$evidence/result.txt"
