#!/usr/bin/env grease
# Emulator and ADB must share the same execution session on this build host.
set -eu -o pipefail
if (len(ARGV) !== 8) {
  echo 'usage: grease run-android.grease SDK AVD_ROOT USER_ROOT IB TEXT_EVIDENCE SMALI_JAR APK FRESH_EVIDENCE' >&2
  exit 2
}
var sdk = ARGV[0]
var avd_root = ARGV[1]
var user_root = ARGV[2]
var repository = ARGV[3]
var text_evidence = ARGV[4]
var smali = ARGV[5]
var apk = ARGV[6]
var evidence = ARGV[7]
for path in "$sdk" "$avd_root" "$user_root" "$repository" "$text_evidence" "$smali" "$apk" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute build-host path required' >&2; exit 2 }
}
test "$(uname -s)" = Linux
test "$(uname -m)" = x86_64
if test -e "$evidence" { echo 'FAIL refusing reused emulator evidence' >&2; exit 1 }
mkdir -p "$evidence" "$user_root"
var adb = "$sdk/platform-tools/adb"
test -x "$adb"
test -x "$sdk/emulator/emulator"
test -s "$avd_root/ib-reader-34.ini"
test -s "$apk"
if ! test -s "$user_root/adbkey" { "$adb" keygen "$user_root/adbkey" > "$evidence/keygen.txt" 2>&1 }
setglobal ENV.ANDROID_HOME = sdk
setglobal ENV.ANDROID_USER_HOME = user_root
setglobal ENV.ANDROID_AVD_HOME = avd_root
setglobal ENV.ADB_VENDOR_KEYS = "$user_root/adbkey"
"$adb" start-server > "$evidence/adb-server.txt" 2>&1
fork {
  "$sdk/emulator/emulator" -avd ib-reader-34 -no-window -no-audio -no-boot-anim \
    -no-snapshot -no-metrics -read-only -accel off -gpu swiftshader -memory 2048 -cores 2 -port 5554 \
    > "$evidence/emulator.txt" 2>&1
}
var emulator_pid = "$!"
trap --add EXIT {
  try { "$adb" -s emulator-5554 emu kill > "$evidence/shutdown.txt" 2>&1 }
  try { kill "$emulator_pid" }
  try { wait "$emulator_pid" }
}
var booted = false
for attempt in @(seq 1 360) {
  try { "$adb" -s emulator-5554 shell getprop sys.boot_completed > "$evidence/boot-state.txt" 2>&1 }
  if (_error.code === 0) {
    var state = $(tr -d '\r' < "$evidence/boot-state.txt")
    if (state === '1') { setvar booted = true; break }
  }
  if ! kill -0 "$emulator_pid" { echo 'FAIL emulator exited before boot' >&2; exit 1 }
  sleep 2
}
if (not booted) { echo 'FAIL Android boot timed out before reader acceptance' >&2; exit 1 }
# Software emulation on this host keeps provisioning services busy after the
# boot property changes. Retain this settling period; it is not app timing.
for settling in @(seq 1 12) { sleep 5 }
"$adb" -s emulator-5554 shell settings put global window_animation_scale 0
"$adb" -s emulator-5554 shell settings put global transition_animation_scale 0
"$adb" -s emulator-5554 shell settings put global animator_duration_scale 0
"$adb" -s emulator-5554 emu avd name > "$evidence/avd.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$evidence/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$evidence/abi.txt"
date -u '+%Y-%m-%dT%H:%M:%SZ' > "$evidence/boot-completed-at.txt"
try {
  grease "$repository/examples/autogenerated/material-reader-text/verify-art.grease" \
    "$repository" "$text_evidence" "$smali" "$adb" > "$evidence/text-art.txt" 2>&1
}
var text_status = _error.code
printf '%s\n' "$text_status" > "$evidence/text-art.status"
cat "$evidence/text-art.txt"
try {
  grease "$repository/examples/autogenerated/material-reader-screen/verify-screen.grease" \
    "$sdk" "$apk" "$adb" "$evidence/screen" > "$evidence/screen.txt" 2>&1
}
var screen_status = _error.code
printf '%s\n' "$screen_status" > "$evidence/screen.status"
cat "$evidence/screen.txt"
# An explicit, bounded follow-up stage lets this disposable host investigate a
# failed observer while keeping ADB and the emulator in one execution session.
echo 'READY follow-up stage' > "$evidence/followup-ready.txt"
for attempt in @(seq 1 36) {
  if test -s "$evidence/followup.grease" {
    sha256sum "$evidence/followup.grease" > "$evidence/followup-sha256.txt"
    try { grease "$evidence/followup.grease" "$sdk" "$adb" "$repository" "$evidence" > "$evidence/followup.txt" 2>&1 }
    var followup_status = _error.code
    printf '%s\n' "$followup_status" > "$evidence/followup.status"
    cat "$evidence/followup.txt"
    break
  }
  if test -e "$evidence/finish" { break }
  sleep 5
}
"$adb" -s emulator-5554 logcat -b all -d > "$evidence/final-logcat.txt"
cat /sys/fs/cgroup/memory.events > "$evidence/host-memory-events.txt"
if (text_status !== 0 or screen_status !== 0) { echo 'FAIL native reader acceptance; inspect separate stage receipts' >&2; exit 1 }
echo 'PASS native reader text/reflow and screen launch on Android 14 x86_64' > "$evidence/result.txt"
echo 'Physical targets and live retained-source wiring remain separate' >> "$evidence/result.txt"
cat "$evidence/result.txt"
