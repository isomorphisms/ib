#!/usr/bin/env grease
# Only the checked Idriç backend produces classes.dex. Resources are app-owned.
set -eu -o pipefail
if (len(ARGV) !== 9) {
  echo 'usage: grease build.grease IB BACKEND CORE DRIVER MODULES SDK TEST_KEYSTORE BAKSMALI FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var backend = ARGV[1]
var core = ARGV[2]
var driver = ARGV[3]
var modules = ARGV[4]
var sdk = ARGV[5]
var keystore = ARGV[6]
var baksmali = ARGV[7]
var evidence = ARGV[8]
var driver_object = "${driver}_app/idric-dex.so"
for path in "$repository" "$backend" "$core" "$driver" "$modules" "$sdk" "$keystore" "$baksmali" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
test -x "$driver"
test -s "$modules/2025081600/Backend/DEX/Callback.ttc"
printf '37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f  %s\n' "$baksmali" | sha256sum -c -
if test -e "$evidence" { echo 'FAIL refusing reused reader screen output' >&2; exit 1 }
mkdir -p "$evidence/source/IB/Android"
cp "$repository/src/IB/Android/ReaderText.idric" "$repository/src/IB/Android/ReaderScreen.idric" "$evidence/source/IB/Android/"
cp "$repository/examples/autogenerated/material-reader-screen/ReaderActivity.idric" "$evidence/source/"
git -C "$repository" rev-parse HEAD > "$evidence/ib-base.txt"
git -C "$repository" diff --binary HEAD > "$evidence/ib.patch"
git -C "$backend" rev-parse HEAD > "$evidence/backend-base.txt"
git -C "$backend" diff --binary HEAD > "$evidence/backend.patch"
git -C "$core" rev-parse HEAD > "$evidence/compiler.txt"
sha256sum "$evidence/source/IB/Android/ReaderText.idric" "$evidence/source/IB/Android/ReaderScreen.idric" \
  "$evidence/source/ReaderActivity.idric" "$driver" "$driver_object" \
  "$core/_/build/exec/idris2_app/idris2.so" "$baksmali" > "$evidence/input-sha256.txt"
for name in positive recovery {
  var output = "$evidence/$name"
  mkdir -p "$output"
  env IDRIS2_PREFIX="$core/_/bootstrap-build" IDRIS2_PATH="$modules" CHEZ="$core/_/.tools/bin/scheme" \
    "$driver" --cg dex --source-dir "$evidence/source" --build-dir "$output/build" \
    --output-dir "$output" "$evidence/source/ReaderActivity.idric" -o classes > "$output/compile.txt" 2>&1
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" }
  if (_error.code !== 1) { cat "$output/compile.txt"; exit 1 }
  for suffix in dex dex.plan smali checked.anf { test -s "$output/classes.$suffix" }
  java -jar "$baksmali" disassemble "$output/classes.dex" -o "$output/decoded"
  var decoded = "$output/decoded/Idric/Generated.smali"
  rg -q -x -F '.super Landroid/app/Activity;' "$decoded"
  rg -q -F '.method public onCreate(Landroid/os/Bundle;)V' "$decoded"
  rg -q -F 'Landroid/app/Activity;->onCreate(Landroid/os/Bundle;)V' "$decoded"
  rg -q -F 'invoke-super' "$decoded"
  rg -q -F 'new-instance' "$decoded"
  rg -q -F 'Landroid/widget/TextView;->setText(Ljava/lang/CharSequence;)V' "$decoded"
  rg -q -F 'Landroid/content/Intent;->createChooser' "$decoded"
  sha256sum "$output/classes.dex" > "$output/sha256.txt"
}
cmp "$evidence/positive/classes.dex" "$evidence/recovery/classes.dex"
grease "$backend/apk/build-direct-dex-activity.grease" "$sdk" \
  "$repository/android-material-reader/AndroidManifest.xml" "$repository/android-material-reader/res" \
  "$evidence/positive/classes.dex" "$keystore" org.isomorphisms.ib.material3 \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 "$evidence/package"
echo 'PASS source-generated native reader Activity, independent decoding, deterministic DEX recovery and test-signed APK' > "$evidence/result.txt"
echo 'Android behavior, independent build-policy promotion, update and physical acceptance remain separate' >> "$evidence/result.txt"
cat "$evidence/result.txt"
