#!/usr/bin/env grease
if (len(ARGV) !== 4) {
  echo 'usage: grease verify-receiver.grease IB BACKEND FRONTEND NEW_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$backend" "$frontend" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 2 }
mkdir -p "$evidence/source/IB"
cp "$repository/src/IB/WebSearch.idric" "$evidence/source/IB/"
cp "$repository/examples/autogenerated/chordsearch/SearchIntentRequest.idric" "$evidence/source/"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
var driver = "$backend/dex/idric/build/exec/idric-dex"
sha256sum "$driver" "${driver}_app/idric-dex.so" "$evidence/source/SearchIntentRequest.idric" \
  "$evidence/source/IB/WebSearch.idric" > "$evidence/input.sha256"
"$driver" --source-dir "$evidence/source" --build-dir "$evidence/check" \
  --check "$evidence/source/SearchIntentRequest.idric" > "$evidence/typecheck.txt" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/typecheck.txt" {
  echo 'FAIL receiver source typecheck' >&2; exit 1
}
try {
  "$driver" --cg dex --source-dir "$evidence/source" --build-dir "$evidence/build" \
    --output-dir "$evidence" "$evidence/source/SearchIntentRequest.idric" -o receiver \
    > "$evidence/compiler.txt" 2>&1
}
var status = _error.code
printf '%s\n' "$status" > "$evidence/compiler.exit"
cat "$evidence/compiler.txt"
if (status !== 0) {
  test ! -e "$evidence/receiver.dex"
  printf 'source_typecheck\tPASS\nsource_to_dex\tBLOCKED\ncompiler_exit\t%s\nART\tNOT_RUN\nphysical_C67\tNOT_RUN\n' "$status" > "$evidence/result.tsv"
  exit 1
}
test -s "$evidence/receiver.dex"
sha256sum "$evidence/receiver.dex" > "$evidence/output.sha256"
printf 'source_typecheck\tPASS\nsource_to_dex\tPASS\nART\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/result.tsv"
