#!/usr/bin/env grease
# Build/parse controls only. Android execution is separately required.
set -eu -o pipefail
if (len(ARGV) !== 6) {
  echo 'usage: grease verify.grease IB CORE DRIVER BACKEND_MODULES BAKSMALI FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var core = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var baksmali = ARGV[4]
var evidence = ARGV[5]
for path in "$repository" "$core" "$driver" "$modules" "$baksmali" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
test -x "$driver"
test -x "$core/_/build/exec/idris2"
test -s "$baksmali"
printf '37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f  %s\n' "$baksmali" | sha256sum -c -
if test -e "$evidence" { echo 'FAIL refusing reused reader evidence' >&2; exit 1 }
mkdir -p "$evidence"
var source = "$repository/examples/autogenerated/material-reader-text"
var original = "$repository/src/IB/Android/ReaderText.idric"
var prefix = "$core/_/bootstrap-build"
var scheme = "$core/_/.tools/bin/scheme"
git -C "$repository" rev-parse HEAD > "$evidence/source-revision.txt"
git -C "$repository" diff --binary HEAD > "$evidence/local.patch"
git -C "$core" rev-parse HEAD > "$evidence/compiler-revision.txt"
"$core/_/build/exec/idris2" --version > "$evidence/compiler-version.txt"
sha256sum "$original" "$source/MaterialReaderText.idric" "$source/ReaderTextObserver.smali" "$driver" \
  "$core/_/build/exec/idris2_app/idris2.so" "$baksmali" > "$evidence/input-sha256.txt"

proc compile_candidate(directory, name) {
  var output = "$evidence/$name"
  mkdir -p "$output"
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules" CHEZ="$scheme" \
    "$driver" --cg dex --source-dir "$directory" --build-dir "$output/build" \
    --output-dir "$output" "$directory/MaterialReaderText.idric" -o candidate \
    > "$output/compile.txt" 2>&1
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" }
  if (_error.code !== 1) { cat "$output/compile.txt"; exit 1 }
  for suffix in dex dex.plan checked.anf smali { test -s "$output/candidate.$suffix" }
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded" \
    > "$output/parse.txt" 2>&1
  var decoded = "$output/decoded/Idric/Generated.smali"
  rg -q -F '.method public static reader_text(Landroid/widget/TextView;Ljava/lang/String;)V' "$decoded"
  rg -q -F 'Landroid/widget/TextView;->setText(Ljava/lang/CharSequence;)V' "$decoded"
  rg -q -F 'Ljava/lang/String;->subSequence(II)Ljava/lang/CharSequence;' "$decoded"
  rg -q -F 'Landroid/widget/TextView;->getText()Ljava/lang/CharSequence;' "$decoded"
  sha256sum "$output/candidate.dex" > "$output/sha256.txt"
}
for mutation in positive text reflow selection recovery {
  var directory = "$evidence/$mutation-source"
  mkdir -p "$directory/IB/Android"
  cp "$source/MaterialReaderText.idric" "$directory/"
  var target = "$directory/IB/Android/ReaderText.idric"
  if (mutation === 'text') {
    sed 's/platform_characters text 0 character_units/platform_characters text 0 0/' "$original" > "$target"
  } elif (mutation === 'reflow') {
    sed 's/set_reader_horizontal_scrolling view 0/set_reader_horizontal_scrolling view 1/' "$original" > "$target"
  } elif (mutation === 'selection') {
    sed 's/set_reader_selection view 1/set_reader_selection view 0/' "$original" > "$target"
  } else {
    cp "$original" "$target"
  }
  if (mutation === 'positive' or mutation === 'recovery') {
    compile_candidate "$directory" "$mutation"
  } else {
    if cmp -s "$original" "$target" { echo 'FAIL unchanged mutant' >&2; exit 1 }
    compile_candidate "$directory" "$mutation-mutant"
    if cmp -s "$evidence/positive/candidate.dex" "$evidence/$mutation-mutant/candidate.dex" { echo 'FAIL mutant did not change DEX' >&2; exit 1 }
  }
}
cmp "$evidence/positive/candidate.dex" "$evidence/recovery/candidate.dex"
echo 'PASS reader checked-source emission, independent DEX decoding and deterministic recovery' > "$evidence/result.txt"
echo 'Three production mutants emitted distinct DEX; Android rejection NOT_RUN' >> "$evidence/result.txt"
cat "$evidence/result.txt"
