#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) {
  echo 'usage: grease verify-art.grease IB EVIDENCE SMALI_JAR ADB' >&2
  exit 2
}
var repository = ARGV[0]
var evidence = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
for path in "$repository" "$evidence" "$smali" "$adb" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
test -x "$adb"
printf '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a  %s\n' "$smali" | sha256sum -c -
rg -q -x -F 'PASS reader checked-source emission, independent DEX decoding and deterministic recovery' "$evidence/result.txt"
sha256sum -c "$evidence/input-sha256.txt"
if test -e "$evidence/art" { echo 'FAIL refusing reused reader ART evidence' >&2; exit 1 }
mkdir -p "$evidence/art"
"$adb" -s emulator-5554 get-state > "$evidence/art/connection.txt"
rg -q -x -F device "$evidence/art/connection.txt"
"$adb" -s emulator-5554 emu avd name > "$evidence/art/emulator.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$evidence/art/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$evidence/art/abi.txt"
test "$(tr -d '\r' < "$evidence/art/sdk.txt")" = 34
test "$(tr -d '\r' < "$evidence/art/abi.txt")" = x86_64
var source = "$repository/examples/autogenerated/material-reader-text/ReaderTextObserver.smali"
java -jar "$smali" assemble "$source" -o "$evidence/art/observer.dex" > "$evidence/art/observer-compile.txt" 2>&1
test -s "$evidence/art/observer.dex"
sha256sum "$source" "$evidence/art/observer.dex" > "$evidence/art/observer-sha256.txt"
var remote_base = $("$adb" -s emulator-5554 shell mktemp -d /data/local/tmp/ib-reader-XXXXXXXX)
if (not remote_base.startsWith('/data/local/tmp/ib-reader-')) { echo 'FAIL unexpected scratch directory' >&2; exit 1 }
for name in positive text-mutant reflow-mutant selection-mutant recovery {
  var remote = "$remote_base/$name"
  var candidate = "$evidence/$name/candidate.dex"
  test -s "$candidate"
  sha256sum -c "$evidence/$name/sha256.txt"
  "$adb" -s emulator-5554 shell mkdir "$remote"
  "$adb" -s emulator-5554 push "$candidate" "$remote/candidate.dex" > "$evidence/art/$name-push.txt" 2>&1
  "$adb" -s emulator-5554 push "$evidence/art/observer.dex" "$remote/observer.dex" >> "$evidence/art/$name-push.txt" 2>&1
  "$adb" -s emulator-5554 shell chmod 444 "$remote/candidate.dex" "$remote/observer.dex"
  "$adb" -s emulator-5554 pull "$remote/candidate.dex" "$evidence/art/$name-received.dex" > "$evidence/art/$name-pull.txt" 2>&1
  "$adb" -s emulator-5554 pull "$remote/observer.dex" "$evidence/art/$name-observer-received.dex" >> "$evidence/art/$name-pull.txt" 2>&1
  cmp "$candidate" "$evidence/art/$name-received.dex"
  cmp "$evidence/art/observer.dex" "$evidence/art/$name-observer-received.dex"
  try {
    "$adb" -s emulator-5554 shell app_process -cp "$remote/candidate.dex:$remote/observer.dex" \
      /system/bin ReaderTextObserver > "$evidence/art/$name.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/art/$name.status"
  cat "$evidence/art/$name.txt"
  if (name === 'positive' or name === 'recovery') {
    test "$status" = 0
    rg -q -x -F 'PASS exact native reader text, selection, empty replacement and width reflow' "$evidence/art/$name.txt"
  } else {
    test "$status" = 73
    if (name === 'text-mutant') { rg -q -x -F 'FAIL exact native reader text' "$evidence/art/$name.txt" }
    if (name === 'reflow-mutant') { rg -q -x -F 'FAIL native reader width reflow' "$evidence/art/$name.txt" }
    if (name === 'selection-mutant') { rg -q -x -F 'FAIL native reader selection' "$evidence/art/$name.txt" }
  }
}
echo 'PASS Android reader text, selection and width reflow; three production mutants rejected; recovery passed' > "$evidence/art/result.txt"
echo 'External framework observer; Material resources, app construction, source/store wiring, APK and physical device NOT_RUN' >> "$evidence/art/result.txt"
cat "$evidence/art/result.txt"
