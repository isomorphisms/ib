module SourceResultAcceptance

import Data.Text
import IB.LongViewTask
import IB.WorkerLifecycle
import IB.StorageAdmission
import IB.SourceResult

record TestBoundary where
  constructor Boundary
  context : AcquisitionContext
  worker : WorkerTask
  attempt : ProcessAttachment
  admission : AdmittedPublication

boundary_for : Text → Maybe TestBoundary
boundary_for result_name = do
  event ← durable_identity "navigation-1"
  requested ← neutral_address "https://example.invalid/history"
  resolved ← neutral_address "https://example.invalid/history.txt"
  acquisition ← durable_identity "selected-public-source-v1"
  work ← durable_identity ("work-" ++ result_name)
  result ← durable_identity result_name
  launch ← durable_identity ("launch-" ++ result_name)
  boot ← durable_identity "boot-1"
  process ← durable_identity "ibworker"
  attempt_identity ← durable_identity ("attempt-" ++ result_name)
  planned ← plan_worker work result restartable_bounded_observation 2
  running ← attach_worker_process launch boot 2000 123 999 process 7 attempt_identity planned
  attempt ← running.attachment
  accepted ← publication_for (Ledger measured_writable (Just 5000) 100 0)
    (RequestedPublication result_name 1024 "ordinary" "card-a" "observation-1" "reservation-1")
    (ObservedPublicationLocation "ordinary" "card-a" "observation-1")
  pure (Boundary (SourceAcquisition event requested resolved acquisition) running attempt accepted)

-- Measured by unchanged PR46 intake/project programs under actual Grease.
-- first/second.urls and their exact manifests are retained beside this source.
first_identity : Text
first_identity = "2001ab879efaac563df10d85fc01e06865b08e9ea3f4a3cd44e66622d3a6713d"

second_identity : Text
second_identity = "f8b3c4f6f35fb44f65a3e68cd2c1d1324e045c185200bb83bcbbe38780466f27"

first_digest : Text
first_digest = "daea81cd90efbac68f89f0e2a0c410d036cefbaa45af6886f17c64e3a6488ec3"

second_digest : Text
second_digest = "0b3eba66b40134aeccdc0a2ff3ff4ab9da003c4e0007953b2c384539841e035d"

first_projection_digest : Text
first_projection_digest = "174be1f365a4b21864fd201508fa1ff41eb2ca8bca032c4f03ac2b3dc4c68c90"

second_projection_digest : Text
second_projection_digest = "bb522e70f6259ec4dd7f99457b5d140f80828bd81ad60e608539d26c95ebe36c"

retained_for : TestBoundary → Text → Text → Integer → RetainedSourceReadback
retained_for boundary identity digest count =
  ReadRetainedSource boundary.context identity digest count "raw_urls"
    "2026-10-08T00:00:00Z" True

published_for : TestBoundary → Text → Integer → PublishedSourceReadback
published_for boundary digest count =
  ReadPublishedSource boundary.worker.result_identity
    (ObservedPublicationLocation "ordinary" "card-a" "observation-1") digest count True 0

first_source : TestBoundary → Maybe SourceResult
first_source boundary = bind_source_result boundary.context boundary.worker boundary.attempt
  boundary.admission (retained_for boundary first_identity first_digest 143)
  (published_for boundary first_digest 143)

first_projection : RawUrlProjectionReadback
first_projection = ReadRawUrlProjection first_identity first_digest "raw-urls-v1"
  first_projection_digest 84 True 0

with_boundary : (TestBoundary → Bool) → Bool
with_boundary test = case boundary_for "result-1" of
  Nothing ⇒ False
  Just boundary ⇒ test boundary

with_source : (SourceResult → Bool) → Bool
with_source test = with_boundary $ \boundary ⇒ case first_source boundary of
  Nothing ⇒ False
  Just source ⇒ test source

source_refused : (RetainedSourceReadback → RetainedSourceReadback) → Bool
source_refused change = with_boundary $ \boundary ⇒
  case bind_source_result boundary.context boundary.worker boundary.attempt boundary.admission
    (change (retained_for boundary first_identity first_digest 143))
    (published_for boundary first_digest 143) of
    Nothing ⇒ True
    Just _ ⇒ False

publication_refused : (PublishedSourceReadback → PublishedSourceReadback) → Bool
publication_refused change = with_boundary $ \boundary ⇒
  case bind_source_result boundary.context boundary.worker boundary.attempt boundary.admission
    (retained_for boundary first_identity first_digest 143)
    (change (published_for boundary first_digest 143)) of
    Nothing ⇒ True
    Just _ ⇒ False

projection_refused : (RawUrlProjectionReadback → RawUrlProjectionReadback) → Bool
projection_refused change = with_source $ \source ⇒
  case bind_raw_url_projection source (change first_projection) of
    Left _ ⇒ True
    Right _ ⇒ False

two_changed_bodies : Bool
two_changed_bodies = case (boundary_for "result-1", boundary_for "result-2") of
  (Just first_boundary, Just second_boundary) ⇒
    case (first_source first_boundary,
          bind_source_result second_boundary.context second_boundary.worker second_boundary.attempt
            second_boundary.admission (retained_for second_boundary second_identity second_digest 116)
            (published_for second_boundary second_digest 116)) of
      (Just first, Just second) ⇒
        source_result_identity first ≟ first_identity &&
        source_result_identity second ≟ second_identity &&
        source_result_sha256 first ≟ first_digest && source_result_sha256 second ≟ second_digest &&
        not (source_result_identity first ≟ source_result_identity second) &&
        case bind_raw_url_projection second
          (ReadRawUrlProjection second_identity second_digest "raw-urls-v1"
            second_projection_digest 59 True 0) of
          Left _ ⇒ False
          Right projected ⇒ projection_sha256 projected ≟ second_projection_digest
      _ ⇒ False
  _ ⇒ False

stale_attempt_refused : Bool
stale_attempt_refused = with_boundary $ \boundary ⇒
  let stale = { attempt_number := 2 } boundary.attempt in
  case bind_source_result boundary.context boundary.worker stale boundary.admission
    (retained_for boundary first_identity first_digest 143) (published_for boundary first_digest 143) of
    Nothing ⇒ True
    Just _ ⇒ False

committed_survives_authority_loss : Bool
committed_survives_authority_loss = with_source $ \source ⇒
  let worker = source_result_worker source in
  case worker.attachment of
    Nothing ⇒ False
    Just attempt ⇒ case worker_authority_was_lost attempt worker of
      Nothing ⇒ False
      Just lost ⇒ lost.committed_result && case recovery_for lost of
        no_restart_needed ⇒ True
        _ ⇒ False

failed_replacement_keeps_prior : Bool
failed_replacement_keeps_prior = with_source $ \source ⇒
  case bind_raw_url_projection source first_projection of
    Left _ ⇒ False
    Right previous ⇒
      let recovery = recover_raw_url_projection source
            ({ producer_exit := 7 } first_projection) (Just previous) in
      case (recovery.last_complete, recovery.replacement_refusal) of
        (Just kept, Just projection_producer_failed) ⇒
          projection_sha256 kept ≟ first_projection_digest &&
          projection_source_identity kept ≟ first_identity
        _ ⇒ False

refusal_stays_distinct : Bool
refusal_stays_distinct = with_source $ \source ⇒
  case (bind_raw_url_projection source ({ producer_exit := 7 } first_projection),
        bind_raw_url_projection source ({ complete := False } first_projection),
        bind_raw_url_projection source ({ decoder_revision := "opaque" } first_projection),
        bind_raw_url_projection source ({ projection_bytes := 0 } first_projection)) of
    (Left projection_producer_failed, Left projection_not_complete,
     Left projection_decoder_unsupported, Left projection_invalid_content) ⇒ True
    _ ⇒ False

acceptance_results : List (Text, Bool)
acceptance_results =
  [ ("two-changed-bodies-bind", two_changed_bodies)
  , ("stale-attempt-refused", stale_attempt_refused)
  , ("partial-source-refused", source_refused ({ complete := False }))
  , ("unsupported-source-refused", source_refused ({ source_kind := "opaque" }))
  , ("empty-source-refused", source_refused ({ byte_count := 0 }))
  , ("source-outside-intake-refused", source_refused ({ byte_count := 16777217 }))
  , ("source-over-admission-refused", source_refused ({ byte_count := 1025 }))
  , ("malformed-source-id-refused", source_refused ({ source_identity := "fixture" }))
  , ("missing-acquisition-time-refused", source_refused ({ acquired_at := "" }))
  , ("changed-event-refused", source_refused $ \retained ⇒
      { context := { event_identity := retained.context.acquisition_revision } retained.context } retained)
  , ("changed-request-refused", source_refused $ \retained ⇒
      { context := { requested := retained.context.resolved } retained.context } retained)
  , ("changed-resolved-refused", source_refused $ \retained ⇒
      { context := { resolved := retained.context.requested } retained.context } retained)
  , ("changed-acquisition-revision-refused", source_refused $ \retained ⇒
      { context := { acquisition_revision := retained.context.event_identity } retained.context } retained)
  , ("source-hash-change-refused", source_refused ({ source_sha256 := second_digest }))
  , ("published-short-write-refused", publication_refused ({ payload_bytes := 142 }))
  , ("completion-marker-refused", publication_refused ({ payload_sha256 := first_projection_digest }))
  , ("producer-nonzero-refused", publication_refused ({ producer_exit := 7 }))
  , ("incomplete-publication-refused", publication_refused ({ complete := False }))
  , ("changed-media-refused", publication_refused
      ({ location := ObservedPublicationLocation "ordinary" "card-b" "observation-1" }))
  , ("changed-observation-refused", publication_refused
      ({ location := ObservedPublicationLocation "ordinary" "card-a" "observation-2" }))
  , ("projection-prior-revision-refused", projection_refused ({ source_identity := second_identity }))
  , ("projection-changed-source-hash-refused", projection_refused ({ source_sha256 := second_digest }))
  , ("unsupported-decoder-refused", projection_refused ({ decoder_revision := "other-v1" }))
  , ("partial-projection-refused", projection_refused ({ complete := False }))
  , ("projection-parser-failure-refused", projection_refused ({ producer_exit := 7 }))
  , ("empty-projection-refused", projection_refused ({ projection_bytes := 0 }))
  , ("invalid-projection-hash-refused", projection_refused ({ projection_sha256 := "unverified" }))
  , ("authority-loss-no-network-restart", committed_survives_authority_loss)
  , ("failed-replacement-keeps-prior", failed_replacement_keeps_prior)
  , ("distinct-decoder-failures", refusal_stays_distinct)
  ]
