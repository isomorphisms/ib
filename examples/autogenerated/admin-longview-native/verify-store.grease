#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease verify-store.grease IB ICK NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var compiler = ARGV[1]
var evidence = ARGV[2]
for path in "$repository" "$compiler" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused kernel evidence' >&2; exit 2 }
mkdir -p "$evidence"
sha256sum "$compiler" "$repository/native/android/ib_longview_store.c" \
  "$repository/native/android/ib_longview_store.h" \
  "$repository/examples/autogenerated/admin-longview-native/store_test.c" > "$evidence/source.sha256"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "-I$repository/native/android" "$repository/native/android/ib_longview_store.c" \
  "$repository/examples/autogenerated/admin-longview-native/store_test.c" -o "$evidence/store-test"
"$evidence/store-test" "$evidence" > "$evidence/test.txt"
cat "$evidence/test.txt"
sha256sum "$evidence/store-test" > "$evidence/output.sha256"
printf 'actual_kernel_store\tPASS\ntrusted_Android_alias\tPASS\nIB_descendant_link\tREFUSED\nlinked_nonprivate_record\tREFUSED\ntorn_selector_history\tREFUSED\nfailed_publication_preserves_previous_selection\tPASS\nIdric_record_semantics\tSEPARATE\nAndroid_kernel_execution\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/receipt.tsv"
