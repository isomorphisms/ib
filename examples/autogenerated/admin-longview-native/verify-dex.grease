#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify-dex.grease IB FRONTEND BACKEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var backend = ARGV[2]
var baksmali = ARGV[3]
var evidence = ARGV[4]
for path in "$repository" "$frontend" "$backend" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused native integration evidence' >&2; exit 2 }
test "$(git -C "$frontend" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(git -C "$backend" rev-parse HEAD)" = 153e7fc8053ba4072954a5e77d4efa3609d829e4
mkdir -p "$evidence/source"
cp -R "$repository/src/." "$evidence/source/"
cp "$repository/examples/autogenerated/native-reader/NativeReader.idric" "$evidence/source/"
git -C "$repository" rev-parse HEAD > "$evidence/base.txt"
sha256sum "$repository/examples/autogenerated/native-reader/NativeReader.idric" \
  "$repository/examples/autogenerated/native-shizuku/ParcelableBoundary.idric" \
  "$repository/src/IB/LongViewTask.idric" "$repository/src/IB/LongViewLifecycle.idric" \
  "$repository/src/IB/LongViewNative.idric" > "$evidence/changed-source.sha256"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
# Exercise emitted platform fields first: a checked generator can still refuse
# a DEX field shape when it runs. This is separate from compiling that generator.
try {
  "$frontend/_/build/exec/idris2" -p idris2 \
    --source-dir "$repository/examples/autogenerated/native-shizuku" \
    --build-dir "$evidence/platform-build" --output-dir "$evidence" \
    "$repository/examples/autogenerated/native-shizuku/ParcelableBoundary.idric" -o platform > "$evidence/platform-compiler.txt" 2>&1
}
var platform_status = _error.code
if (platform_status !== 0) { cat "$evidence/platform-compiler.txt"; exit "$platform_status" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/platform-compiler.txt" { cat "$evidence/platform-compiler.txt"; exit 1 }
try { "$evidence/platform" --client "$evidence/platform.dex" > "$evidence/platform-generation.txt" 2>&1 }
var generation_status = _error.code
cat "$evidence/platform-generation.txt"
if (generation_status !== 0) { exit "$generation_status" }
java -jar "$baksmali" disassemble "$evidence/platform.dex" -o "$evidence/platform-decoded"
for type in LongViewBridge LongViewClient LongViewTimingCallback LongViewRecoveryTask {
  test -s "$evidence/platform-decoded/org/isomorphisms/ib/$type.smali"
}
rg -q -F '.method public native onRenderProcessGone(Landroid/webkit/WebView;Landroid/webkit/RenderProcessGoneDetail;)Z' \
  "$evidence/platform-decoded/org/isomorphisms/ib/LongViewClient.smali"
for type in LongViewClient LongViewTimingCallback LongViewRecoveryTask {
  rg -q -x -F '.field private documentEpoch:Ljava/lang/Integer;' "$evidence/platform-decoded/org/isomorphisms/ib/$type.smali"
}
try {
  "$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
    --source-dir "$evidence/source" --build-dir "$evidence/activity-build" --output-dir "$evidence" \
    "$evidence/source/NativeReader.idric" -o activity > "$evidence/activity-compiler.txt" 2>&1
}
var activity_status = _error.code
if (activity_status !== 0) { cat "$evidence/activity-compiler.txt"; exit "$activity_status" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/activity-compiler.txt" { cat "$evidence/activity-compiler.txt"; exit 1 }
test -s "$evidence/activity.dex"
java -jar "$baksmali" disassemble "$evidence/activity.dex" -o "$evidence/activity-decoded"
for declaration in longview_start longview_open longview_attach longview_observe longview_field longview_counter {
  rg -q -F ".method public static $declaration(" "$evidence/activity-decoded/Idric/Generated.smali"
}
rg -q -F 'Lorg/isomorphisms/ib/LongViewBridge;->open(' "$evidence/activity-decoded/Idric/Generated.smali"
rg -q -F 'Lorg/isomorphisms/ib/LongViewBridge;->resume(' "$evidence/activity-decoded/Idric/Generated.smali"
rg -q -F 'Lorg/isomorphisms/ib/LongViewBridge;->detach(' "$evidence/activity-decoded/Idric/Generated.smali"
sha256sum "$evidence/activity.dex" "$evidence/platform.dex" > "$evidence/outputs.sha256"
printf 'actual_NativeReader_DEX\tPASS\nactual_platform_classes_DEX\tPASS\nindependent_disassembly\tPASS\ninstalled_Android\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m actual native reader and protected framework bridge source-to-DEX\n'
