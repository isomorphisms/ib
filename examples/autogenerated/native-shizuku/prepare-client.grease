#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) {
  echo 'usage: grease prepare-client.grease IB BACKEND FRONTEND NDK SDK KEYSTORE BAKSMALI WORKER_TOOLCHAINS NEW_EVIDENCE' >&2; exit 2
}
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var ndk = ARGV[3]
var sdk = ARGV[4]
var keystore = ARGV[5]
var baksmali = ARGV[6]
var worker_toolchains = ARGV[7]
var evidence = ARGV[8]
var icu = "$repository/.tools/icu"
var net = "$repository/.tools/Idric-Net"
var openssl = "$repository/.tools/OpenSSL"
var appendfat = "$repository/.tools/appendfat"
var acceptance = "$repository/.tools/reader-acceptance"
var grease = ENV.IB_GREASE
setglobal ENV.PATH = $(dirname "$grease") ++ ':' ++ ENV.PATH
for path in "$repository" "$backend" "$frontend" "$ndk" "$sdk" "$keystore" "$baksmali" "$worker_toolchains" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute client build path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused Shizuku client evidence' >&2; exit 2 }
var declared = $(git -C "$repository" ls-tree HEAD vendor/android-NDK | cut -f 1 | cut -d ' ' -f 3)
if (declared !== $(git -C "$backend" rev-parse HEAD)) { echo 'FAIL native client compiler differs from dependency pin' >&2; exit 1 }
test "$(git -C "$icu" rev-parse HEAD)" = 5b0ab280c3f2613ab933ed230b5cc50f50b9613f
test "$(git -C "$net" rev-parse HEAD)" = b21801b72acb8ab835c297bbe298af8599550134
test "$(git -C "$openssl" rev-parse HEAD)" = f4dc4d58b48d346a8270183f89acf826d459b0ca
rg -x -F 'Pkg.Revision = 27.2.12479018' "$ndk/source.properties"
mkdir -p "$evidence"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
setglobal ENV.IDRIS2_CG = 'chez'
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
var source = "$repository/examples/autogenerated/native-shizuku"
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$source" \
  --build-dir "$evidence/platform-build" --output-dir "$evidence" \
  "$source/ParcelableBoundary.idric" -o platform-classes > "$evidence/platform-compiler.txt" 2>&1
cat "$evidence/platform-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/platform-compiler.txt" { exit 1 }
"$evidence/platform-classes" --client "$evidence/platform.dex"
"$evidence/platform-classes" --client "$evidence/platform-repeat.dex"
cmp "$evidence/platform.dex" "$evidence/platform-repeat.dex"
java -jar "$baksmali" disassemble "$evidence/platform.dex" -o "$evidence/platform-decoded"
for type in ShizukuProvider ShizukuApplicationCallback ShizukuClient {
  if rg -q '^\.implements ' "$evidence/platform-decoded/org/isomorphisms/ib/$type.smali" {
    echo 'FAIL unrelated platform class inherited an interface' >&2; exit 1
  }
}
rg -x -F '.implements Landroid/os/IBinder$DeathRecipient;' "$evidence/platform-decoded/org/isomorphisms/ib/ShizukuDeathRecipient.smali"
mkdir -p "$evidence/maintained-source"
cp -R "$repository/src/." "$evidence/maintained-source/"
cp "$repository/examples/autogenerated/native-reader/NativeReader.idric" "$evidence/maintained-source/NativeReader.idric"
"$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
  --source-dir "$evidence/maintained-source" \
  --build-dir "$evidence/activity-build" --output-dir "$evidence" \
  "$evidence/maintained-source/NativeReader.idric" -o activity > "$evidence/activity-compiler.txt" 2>&1
cat "$evidence/activity-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/activity-compiler.txt" { exit 1 }
test -s "$evidence/activity.dex"
java -jar "$baksmali" disassemble "$evidence/activity.dex" -o "$evidence/activity-decoded"
rg -q -F 'Lorg/isomorphisms/ib/ShizukuClient;->state()I' "$evidence/activity-decoded/Idric/Generated.smali"
rg -q -F 'Lorg/isomorphisms/ib/ReaderBridge;->navigate(' "$evidence/activity-decoded/Idric/Generated.smali"
"$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
  --source-dir "$evidence/maintained-source" \
  --build-dir "$evidence/activity-repeat-build" --output-dir "$evidence" \
  "$evidence/maintained-source/NativeReader.idric" -o activity-repeat > "$evidence/activity-repeat-compiler.txt" 2>&1
cmp "$evidence/activity.dex" "$evidence/activity-repeat.dex"
cd "$net"
"$frontend/_/build/exec/idris2" --install idric-net.ipkg > "$evidence/net-install.txt" 2>&1
cd "$repository"
"$backend/dex/idric/build/exec/idric-dex" --cg dex -p idric_net \
  --directive "jni-map=$backend/examples/autogenerated/icu-runtime/icu-jni.tsv" \
  --source-dir "$icu/src" --build-dir "$evidence/icu-build" --output-dir "$evidence" \
  "$icu/src/Main.idric" -o icu-worker > "$evidence/icu-compiler.txt" 2>&1
cat "$evidence/icu-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/icu-compiler.txt" { exit 1 }
test -s "$evidence/icu-worker.dex"
java -jar "$baksmali" disassemble "$evidence/icu-worker.dex" -o "$evidence/icu-decoded"
for abi in x86_64 armeabi-v7a arm64-v8a {
  mkdir -p "$evidence/icu-native/$abi"
  try {
    make -f "$icu/android/Makefile" all "ANDROID_ABI=$abi" ANDROID_API=29 \
      "ANDROID_NDK_HOME=$ndk" "OPENSSL_SOURCE=$openssl" "WORK=$evidence/icu-native-build-$abi" \
      "OUTPUT=$evidence/icu-native/$abi/libicu_transport.so" > "$evidence/icu-$abi-build.txt" 2>&1
  }
  if (_error.code !== 0) { cat "$evidence/icu-$abi-build.txt" >&2; exit 1 }
}
"$grease" "$source/stage-worker.grease" "$evidence/icu-worker.dex" "$evidence/icu-native" \
  "$worker_toolchains/grease/_temp/grease-native" "$repository/bin/ib_android_icu_frame.grease" "$evidence/payload"
cp "$evidence/platform.dex" "$evidence/payload/classes2.dex"
var tools = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
for abi in x86_64 armeabi-v7a arm64-v8a {
  try {
    make -f "$repository/android-native/Makefile" reader-native "ABI=$abi" "NDK=$ndk" \
      "AICI_ROOT=$acceptance" "APPENDFAT=$appendfat" "ICK_STAGE=$worker_toolchains/ick/$abi" \
      "READER_BUILD=$evidence/native-$abi" "READER_OUTPUT=$evidence/payload/lib/$abi/libib_reader.so" \
      > "$evidence/native-$abi-build.txt" 2>&1
  }
  if (_error.code !== 0) { cat "$evidence/native-$abi-build.txt" >&2; exit 1 }
}
"$grease" "$backend/apk/build-direct-dex-activity.grease" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$keystore" org.isomorphisms.ib.prepaint \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 \
  "$evidence/package" "$evidence/payload"
cp "$evidence/package/ib-material-reader.apk" "$evidence/ib-native-boundary.apk"
sed 's/(uid != 0 \&\& uid != 2000)/0/' "$repository/native/android/ib_shizuku_client.c" > "$evidence/uid-bypass.c"
sed 's/if (current) (void)invalidate_at(e, IB_SHIZUKU_UNAVAILABLE, 1, before);/(void)current; (void)before;/' \
  "$repository/native/android/ib_shizuku_client.c" > "$evidence/death-noop.c"
# Preserve the isolated missing callback as a positive for failed-RPC
# revocation. A genuinely unsafe mutant must disable both revocation paths.
awk '
  /int invalidated = invalidate_at\(e, rejected, 1, before\);/ {
    print "    (void)rejected; (void)before;"
    print "    return IB_SHIZUKU_AUTHORIZED;"
    print "}"
    skipping=1
    next
  }
  skipping { if ($0=="}") skipping=0; next }
  { print }
' "$evidence/death-noop.c" > "$evidence/stale-authorization.c"

sed 's/ib_binder_oneway(flags)/(flags == 1)/' \
  "$repository/native/android/ib_shizuku_client.c" > "$evidence/strict-flags.c"
for control in uid-bypass death-noop strict-flags stale-authorization {
  if cmp -s "$repository/native/android/ib_shizuku_client.c" "$evidence/$control.c" { echo 'FAIL unchanged client mutant' >&2; exit 1 }
  cp -R "$evidence/payload" "$evidence/$control-payload"
  try {
    make -f "$repository/android-native/Makefile" reader-native ABI=x86_64 "NDK=$ndk" \
      "AICI_ROOT=$acceptance" "APPENDFAT=$appendfat" "ICK_STAGE=$worker_toolchains/ick/x86_64" \
      "READER_BUILD=$evidence/native-$control" "READER_CLIENT_SOURCE=$evidence/$control.c" \
      "READER_OUTPUT=$evidence/$control-payload/lib/x86_64/libib_reader.so" > "$evidence/native-$control-build.txt" 2>&1
  }
  if (_error.code !== 0) { cat "$evidence/native-$control-build.txt" >&2; exit 1 }
  "$grease" "$backend/apk/build-direct-dex-activity.grease" "$sdk" \
    "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
    "$evidence/activity.dex" "$keystore" org.isomorphisms.ib.prepaint \
    de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 \
    "$evidence/$control-package" "$evidence/$control-payload"
  cp "$evidence/$control-package/ib-material-reader.apk" "$evidence/ib-native-$control.apk"
}
# A real compiled view mutant preserves source admission and document text,
# but replaces every requested anchor point with zero. Only the independent
# native viewport observer can reject this missing behavior.
sed 's/NewObject(e, integer_type, box, point)/NewObject(e, integer_type, box, 0)/' \
  "$repository/native/android/ib_reader_view.c" > "$evidence/anchor-zero.c"
if cmp -s "$repository/native/android/ib_reader_view.c" "$evidence/anchor-zero.c" {
  echo 'FAIL unchanged native anchor mutant' >&2; exit 1
}
cp -R "$evidence/payload" "$evidence/anchor-zero-payload"
try {
  make -f "$repository/android-native/Makefile" reader-native ABI=x86_64 "NDK=$ndk" \
    "AICI_ROOT=$acceptance" "APPENDFAT=$appendfat" "ICK_STAGE=$worker_toolchains/ick/x86_64" \
    "READER_BUILD=$evidence/native-anchor-zero" "READER_VIEW_SOURCE=$evidence/anchor-zero.c" \
    "READER_OUTPUT=$evidence/anchor-zero-payload/lib/x86_64/libib_reader.so" > "$evidence/native-anchor-zero-build.txt" 2>&1
}
if (_error.code !== 0) { cat "$evidence/native-anchor-zero-build.txt" >&2; exit 1 }
"$grease" "$backend/apk/build-direct-dex-activity.grease" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$keystore" org.isomorphisms.ib.prepaint \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 \
  "$evidence/anchor-zero-package" "$evidence/anchor-zero-payload"
cp "$evidence/anchor-zero-package/ib-material-reader.apk" "$evidence/ib-native-anchor-zero.apk"
"$grease" "$backend/examples/autogenerated/native-apk-payload/verify.grease" "$backend" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$evidence/platform.dex" "$evidence/payload/lib/x86_64/libib_reader.so" \
  "$keystore" org.isomorphisms.ib.prepaint \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 "$evidence/package-controls"
"$grease" "$backend/examples/autogenerated/framework-construction/verify-package.grease" "$backend" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$keystore" "$evidence/identity-controls"
git -C "$repository" rev-parse HEAD > "$evidence/ib-commit.txt"
git -C "$backend" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
git -C "$icu" rev-parse HEAD > "$evidence/icu-commit.txt"
git -C "$net" rev-parse HEAD > "$evidence/Idric-Net-commit.txt"
git -C "$appendfat" rev-parse HEAD > "$evidence/appendfat-commit.txt"
git -C "$acceptance" rev-parse HEAD > "$evidence/observer-commit.txt"
cp "$worker_toolchains/grease/_temp/grease-native/packaging-commit.txt" "$evidence/Grease-packaging-commit.txt"
cp "$ndk/source.properties" "$evidence/ndk.properties"
sha256sum "$source/ParcelableBoundary.idric" "$repository/examples/autogenerated/native-reader/NativeReader.idric" \
  "$repository/native/android/ib_shizuku_client.c" "$repository/native/android/ib_shizuku_client.h" \
  "$repository/native/android/ib_shizuku_parcelable.c" "$evidence/activity.dex" "$evidence/platform.dex" \
  "$evidence/payload/lib/x86_64/libib_reader.so" "$evidence/payload/lib/armeabi-v7a/libib_reader.so" \
  "$evidence/payload/lib/arm64-v8a/libib_reader.so" "$evidence/ib-native-boundary.apk" \
  "$evidence/uid-bypass.c" "$evidence/death-noop.c" "$evidence/strict-flags.c" \
  "$evidence/ib-native-uid-bypass.apk" "$evidence/ib-native-death-noop.apk" \
  "$evidence/ib-native-strict-flags.apk" "$evidence/stale-authorization.c" \
  "$evidence/ib-native-stale-authorization.apk" "$repository/native/android/ib_reader_view.c" \
  "$evidence/anchor-zero.c" "$evidence/ib-native-anchor-zero.apk" > "$evidence/sha256.txt"
printf 'schema\tib-native-reader-worker-build-v1\nchecked_maintained_Activity\tPASS\nchecked_ICU_Main\tPASS\nplatform_declarations\tPASS\nindependent_decode\tPASS\nActivity_and_platform_determinism\tPASS\nICK_NDK_ELF_x86_64_ARM32_ARM64\tPASS\nexisting_public_test_signer\tPASS\npayload_controls\tPASS\nreal_Shizuku\tNOT_RUN\nworker_launch\tNOT_RUN\nworking_URL_reader\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
