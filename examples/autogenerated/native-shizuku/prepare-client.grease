#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) {
  echo 'usage: grease prepare-client.grease IB BACKEND FRONTEND NDK SDK KEYSTORE BAKSMALI NEW_EVIDENCE' >&2; exit 2
}
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var ndk = ARGV[3]
var sdk = ARGV[4]
var keystore = ARGV[5]
var baksmali = ARGV[6]
var evidence = ARGV[7]
var grease = ENV.IB_GREASE
setglobal ENV.PATH = $(dirname "$grease") ++ ':' ++ ENV.PATH
for path in "$repository" "$backend" "$frontend" "$ndk" "$sdk" "$keystore" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute client build path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused Shizuku client evidence' >&2; exit 2 }
var declared = $(git -C "$repository" ls-tree HEAD vendor/android-NDK | cut -f 1 | cut -d ' ' -f 3)
if (declared !== $(git -C "$backend" rev-parse HEAD)) { echo 'FAIL native client compiler differs from dependency pin' >&2; exit 1 }
rg -x -F 'Pkg.Revision = 27.2.12479018' "$ndk/source.properties"
mkdir -p "$evidence"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
var source = "$repository/examples/autogenerated/native-shizuku"
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$source" \
  --build-dir "$evidence/platform-build" --output-dir "$evidence" \
  "$source/ParcelableBoundary.idric" -o platform-classes > "$evidence/platform-compiler.txt" 2>&1
cat "$evidence/platform-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/platform-compiler.txt" { exit 1 }
"$evidence/platform-classes" --client "$evidence/platform.dex"
"$evidence/platform-classes" --client "$evidence/platform-repeat.dex"
cmp "$evidence/platform.dex" "$evidence/platform-repeat.dex"
java -jar "$baksmali" disassemble "$evidence/platform.dex" -o "$evidence/platform-decoded"
for type in ShizukuProvider ShizukuApplicationCallback ShizukuClient {
  if rg -q '^\.implements ' "$evidence/platform-decoded/org/isomorphisms/ib/$type.smali" {
    echo 'FAIL unrelated platform class inherited an interface' >&2; exit 1
  }
}
rg -x -F '.implements Landroid/os/IBinder$DeathRecipient;' "$evidence/platform-decoded/org/isomorphisms/ib/ShizukuDeathRecipient.smali"
"$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
  --source-dir "$repository/examples/autogenerated/native-reader" \
  --build-dir "$evidence/activity-build" --output-dir "$evidence" \
  "$repository/examples/autogenerated/native-reader/NativeReader.idric" -o activity > "$evidence/activity-compiler.txt" 2>&1
cat "$evidence/activity-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/activity-compiler.txt" { exit 1 }
test -s "$evidence/activity.dex"
java -jar "$baksmali" disassemble "$evidence/activity.dex" -o "$evidence/activity-decoded"
rg -q -F 'Lorg/isomorphisms/ib/ShizukuClient;->state()I' "$evidence/activity-decoded/Idric/Generated.smali"
mkdir -p "$evidence/payload"
cp "$evidence/platform.dex" "$evidence/payload/classes2.dex"
var tools = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
for abi in x86_64 armeabi-v7a arm64-v8a {
  var target = 'x86_64-linux-android29'
  if (abi === 'armeabi-v7a') { setvar target = 'armv7a-linux-androideabi29' }
  if (abi === 'arm64-v8a') { setvar target = 'aarch64-linux-android29' }
  mkdir -p "$evidence/payload/lib/$abi"
  "$tools/$target-clang" -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -fPIC -shared \
    -Wl,--no-undefined -Wl,-z,max-page-size=16384 \
    "$repository/native/android/ib_shizuku_parcelable.c" "$repository/native/android/ib_shizuku_client.c" \
    -o "$evidence/payload/lib/$abi/libib_reader.so"
  "$tools/llvm-readelf" -h -l -d "$evidence/payload/lib/$abi/libib_reader.so" > "$evidence/$abi.elf.txt"
  "$tools/$target-clang" --version > "$evidence/$abi.compiler.txt"
}
"$grease" "$backend/apk/build-direct-dex-activity.grease" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$keystore" org.isomorphisms.ib.prepaint \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 \
  "$evidence/package" "$evidence/payload"
cp "$evidence/package/ib-material-reader.apk" "$evidence/ib-native-boundary.apk"
sed 's/(uid != 0 \&\& uid != 2000)/0/' "$repository/native/android/ib_shizuku_client.c" > "$evidence/uid-bypass.c"
sed 's/if (current) (void)invalidate_at(e, IB_SHIZUKU_UNAVAILABLE, 1, before);/(void)current; (void)before;/' \
  "$repository/native/android/ib_shizuku_client.c" > "$evidence/death-noop.c"
sed 's/ib_binder_oneway(flags)/(flags == 1)/' \
  "$repository/native/android/ib_shizuku_client.c" > "$evidence/strict-flags.c"
for control in uid-bypass death-noop strict-flags {
  if cmp -s "$repository/native/android/ib_shizuku_client.c" "$evidence/$control.c" { echo 'FAIL unchanged client mutant' >&2; exit 1 }
  cp -R "$evidence/payload" "$evidence/$control-payload"
  "$tools/x86_64-linux-android29-clang" -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -fPIC -shared \
    -I "$repository/native/android" -Wl,--no-undefined -Wl,-z,max-page-size=16384 \
    "$repository/native/android/ib_shizuku_parcelable.c" "$evidence/$control.c" \
    -o "$evidence/$control-payload/lib/x86_64/libib_reader.so"
  "$grease" "$backend/apk/build-direct-dex-activity.grease" "$sdk" \
    "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
    "$evidence/activity.dex" "$keystore" org.isomorphisms.ib.prepaint \
    de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 \
    "$evidence/$control-package" "$evidence/$control-payload"
  cp "$evidence/$control-package/ib-material-reader.apk" "$evidence/ib-native-$control.apk"
}
"$grease" "$backend/examples/autogenerated/native-apk-payload/verify.grease" "$backend" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$evidence/platform.dex" "$evidence/payload/lib/x86_64/libib_reader.so" \
  "$keystore" org.isomorphisms.ib.prepaint \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 "$evidence/package-controls"
"$grease" "$backend/examples/autogenerated/framework-construction/verify-package.grease" "$backend" "$sdk" \
  "$repository/android-native/AndroidManifest.xml" "$repository/android-native/res" \
  "$evidence/activity.dex" "$keystore" "$evidence/identity-controls"
git -C "$repository" rev-parse HEAD > "$evidence/ib-commit.txt"
git -C "$backend" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
cp "$ndk/source.properties" "$evidence/ndk.properties"
sha256sum "$source/ParcelableBoundary.idric" "$repository/examples/autogenerated/native-reader/NativeReader.idric" \
  "$repository/native/android/ib_shizuku_client.c" "$repository/native/android/ib_shizuku_client.h" \
  "$repository/native/android/ib_shizuku_parcelable.c" "$evidence/activity.dex" "$evidence/platform.dex" \
  "$evidence/payload/lib/x86_64/libib_reader.so" "$evidence/payload/lib/armeabi-v7a/libib_reader.so" \
  "$evidence/payload/lib/arm64-v8a/libib_reader.so" "$evidence/ib-native-boundary.apk" \
  "$evidence/uid-bypass.c" "$evidence/death-noop.c" "$evidence/strict-flags.c" \
  "$evidence/ib-native-uid-bypass.apk" "$evidence/ib-native-death-noop.apk" \
  "$evidence/ib-native-strict-flags.apk" > "$evidence/sha256.txt"
printf 'schema\tib-native-shizuku-client-build-v1\nchecked_Activity\tPASS\nplatform_declarations\tPASS\nindependent_decode\tPASS\nplatform_determinism\tPASS\nNDK_ELF_x86_64_ARM32_ARM64\tPASS\nexplicit_persistent_test_signer\tPASS\npayload_controls\tPASS\nreal_Shizuku\tNOT_RUN\nworker_launch\tNOT_RUN\nworking_URL_reader\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
