#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease prepare-parcelable.grease IB BACKEND FRONTEND NDK BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var ndk = ARGV[3]
var baksmali = ARGV[4]
var evidence = ARGV[5]
for path in "$repository" "$backend" "$frontend" "$ndk" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused Parcelable evidence' >&2; exit 2 }
var declared = $(git -C "$repository" ls-tree HEAD vendor/android-NDK | cut -f 1 | cut -d ' ' -f 3)
var observed = $(git -C "$backend" rev-parse HEAD)
if (declared !== observed) { echo 'FAIL declared backend differs from Parcelable compiler checkout' >&2; exit 1 }
test -s "$ndk/source.properties"
rg -x -F 'Pkg.Revision = 27.2.12479018' "$ndk/source.properties"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
mkdir -p "$evidence"
var source = "$repository/examples/autogenerated/native-shizuku"
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$source" \
  --build-dir "$evidence/build" --output-dir "$evidence" \
  "$source/ParcelableBoundary.idric" -o parcelable-boundary > "$evidence/compiler.txt" 2>&1
cat "$evidence/compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/compiler.txt" {
  echo 'FAIL invalid Parcelable boundary source' >&2; exit 1
}
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
"$evidence/parcelable-boundary" "$evidence/parcelable.dex" > "$evidence/generation.txt" 2>&1
cat "$evidence/generation.txt"
cp "$evidence/parcelable.dex" "$evidence/first.dex"
"$evidence/parcelable-boundary" "$evidence/parcelable.dex" > "$evidence/repeat.txt" 2>&1
cmp "$evidence/first.dex" "$evidence/parcelable.dex"
java -jar "$baksmali" disassemble "$evidence/parcelable.dex" -o "$evidence/decoded"
rg -x -F '.field public binder:Landroid/os/IBinder;' "$evidence/decoded/moe/shizuku/api/BinderContainer.smali"
rg -x -F '.field public static CREATOR:Landroid/os/Parcelable$Creator;' "$evidence/decoded/moe/shizuku/api/BinderContainer.smali"
var tools = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
for abi in x86_64 armeabi-v7a arm64-v8a {
  var target = 'x86_64-linux-android29'
  var machine = 'Advanced Micro Devices X86-64'
  if (abi === 'armeabi-v7a') { setvar target = 'armv7a-linux-androideabi29'; setvar machine = 'ARM' }
  if (abi === 'arm64-v8a') { setvar target = 'aarch64-linux-android29'; setvar machine = 'AArch64' }
  mkdir -p "$evidence/$abi"
  "$tools/$target-clang" -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -fPIC -shared \
    -Wl,--no-undefined -Wl,-z,max-page-size=16384 \
    "$repository/native/android/ib_shizuku_parcelable.c" -o "$evidence/$abi/libib_reader.so"
  "$tools/llvm-readelf" -h -l -d "$evidence/$abi/libib_reader.so" > "$evidence/$abi/elf.txt"
  rg -F "Machine:                           $machine" "$evidence/$abi/elf.txt"
  "$tools/$target-clang" --version > "$evidence/$abi/compiler.txt"
}
sed 's/SetObjectField(environment, result, binder_field, binder)/SetObjectField(environment, result, binder_field, binder ? NULL : binder)/' \
  "$repository/native/android/ib_shizuku_parcelable.c" > "$evidence/lost-binder.c"
if cmp -s "$repository/native/android/ib_shizuku_parcelable.c" "$evidence/lost-binder.c" {
  echo 'FAIL unchanged native Binder identity mutant' >&2; exit 1
}
mkdir -p "$evidence/x86_64-mutant"
"$tools/x86_64-linux-android29-clang" -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -fPIC -shared \
  -Wl,--no-undefined -Wl,-z,max-page-size=16384 \
  "$evidence/lost-binder.c" -o "$evidence/x86_64-mutant/libib_reader.so"
git -C "$repository" rev-parse HEAD > "$evidence/ib-commit.txt"
git -C "$backend" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
cp "$ndk/source.properties" "$evidence/ndk.properties"
sha256sum "$source/ParcelableBoundary.idric" "$repository/native/android/ib_shizuku_parcelable.c" \
  "$evidence/parcelable.dex" "$evidence/x86_64/libib_reader.so" \
  "$evidence/armeabi-v7a/libib_reader.so" "$evidence/arm64-v8a/libib_reader.so" \
  "$evidence/x86_64-mutant/libib_reader.so" > "$evidence/sha256.txt"
printf 'typed_declarations\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nNDK_ELF_x86_64_ARM32_ARM64\tPASS\nART\tNOT_RUN\nShizuku_Binder\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
