module GoogleBrowserProbe

import Data.Text
import Data.List

-- Bounded first-party framework qualification. This grants no ICU identity,
-- original HTTP offsets, canonical admission or production browser history.
data ActivityReference : Type where [external]
data ContextReference : Type where [external]
data SavedStateReference : Type where [external]
data ObjectReference : Type where [external]
data WebViewReference : Type where [external]
data ViewReference : Type where [external]
data SettingsReference : Type where [external]
data ClientReference : Type where [external]
data WebClientReference : Type where [external]
data SnapshotReference : Type where [external]
data ValueCallbackReference : Type where [external]
data TickReference : Type where [external]
data RunnableReference : Type where [external]
data RequestReference : Type where [external]
data UriReference : Type where [external]
data FileReference : Type where [external]
data StreamReference : Type where [external]
data OutputReference : Type where [external]
data WriterReference : Type where [external]
data CounterReference : Type where [external]
data JsonReference : Type where [external]
data CharsetReference : Type where [external]
data EncoderReference : Type where [external]
data CharactersReference : Type where [external]
data EncodedReference : Type where [external]

