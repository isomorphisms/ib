#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease build.grease IB BACKEND FRONTEND SDK NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var sdk = ARGV[3]
var evidence = ARGV[4]
var grease = ENV.IB_GREASE
for path in "$repository" "$backend" "$frontend" "$sdk" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused probe build evidence' >&2; exit 2 }
mkdir -p "$evidence/payload/lib/x86_64" "$evidence/resources/values"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_CG = 'chez'
var source = "$repository/examples/autogenerated/google-browser"
"$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
  --source-dir "$source" --build-dir "$evidence/activity-build" --output-dir "$evidence" \
  "$source/GoogleBrowserProbe.idric" -o activity > "$evidence/activity-compiler.txt" 2>&1
cat "$evidence/activity-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/activity-compiler.txt" { exit 1 }
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$source" \
  --build-dir "$evidence/boundary-build" --output-dir "$evidence" \
  "$source/GoogleBrowserBoundary.idric" -o boundary > "$evidence/boundary-compiler.txt" 2>&1
cat "$evidence/boundary-compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/boundary-compiler.txt" { exit 1 }
"$evidence/boundary" "$evidence/payload/classes2.dex"
java -jar "$evidence/../compiler/oracles/baksmali.jar" disassemble "$evidence/activity.dex" -o "$evidence/activity-decoded"
java -jar "$evidence/../compiler/oracles/baksmali.jar" disassemble "$evidence/payload/classes2.dex" -o "$evidence/boundary-decoded"
rg -x -F '.super Landroid/app/Activity;' "$evidence/activity-decoded/Idric/Generated.smali"
rg -x -F '.super Landroid/webkit/WebViewClient;' "$evidence/boundary-decoded/org/isomorphisms/ib/googleprobe/Client.smali"
var tools = "$sdk/ndk/27.2.12479018/toolchains/llvm/prebuilt/linux-x86_64/bin"
"$tools/x86_64-linux-android29-clang" -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -fPIC -shared \
  -Wl,--no-undefined -Wl,-z,max-page-size=16384 "$source/probe.c" \
  -o "$evidence/payload/lib/x86_64/libgoogle_probe.so"
wget -q -O "$evidence/public-test-keystore" \
  https://raw.githubusercontent.com/isomorphismes/wegert/89dcfb840cec1a66ee04c7f7404954cbd6c09839/_/build/app/wegert-debug.keystore
printf '%s  %s\n' d83f7a36a205e49b4c755f37d27a0ded02779acc0da82a22e19d458dc6e5a89a "$evidence/public-test-keystore" | sha256sum -c -
printf '<resources><string name="app_name">IB Google adapter qualification</string></resources>\n' > "$evidence/resources/values/strings.xml"
"$grease" "$backend/apk/build-direct-dex-activity.grease" "$sdk" "$source/AndroidManifest.xml" \
  "$evidence/resources" "$evidence/activity.dex" "$evidence/public-test-keystore" org.isomorphisms.ib.googleprobe \
  de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9 \
  "$evidence/package" "$evidence/payload"
git -C "$repository" rev-parse HEAD > "$evidence/ib-commit.txt"
sha256sum "$source/GoogleBrowserProbe.idric" "$source/GoogleBrowserBoundary.idric" "$source/probe.c" \
  "$evidence/activity.dex" "$evidence/payload/classes2.dex" "$evidence/package/ib-material-reader.apk" > "$evidence/sha256.txt"
