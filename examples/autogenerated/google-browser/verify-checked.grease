#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify-checked.grease IB BACKEND FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var baksmali = ARGV[3]
var evidence = ARGV[4]
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_CG = 'chez'
var source = "$repository/examples/autogenerated/google-browser"
"$backend/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports \
  --source-dir "$source" --build-dir "$evidence/build" --output-dir "$evidence" \
  "$source/GoogleBrowserProbe.idric" -o probe > "$evidence/compiler.txt" 2>&1
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/compiler.txt" { cat "$evidence/compiler.txt"; exit 1 }
java -jar "$baksmali" disassemble "$evidence/probe.dex" -o "$evidence/decoded"
rg -q -F 'Ljava/lang/String;->startsWith(Ljava/lang/String;)Z' "$evidence/decoded/Idric/Generated.smali"
sha256sum "$source/GoogleBrowserProbe.idric" "$evidence/probe.dex" > "$evidence/sha256.txt"
printf 'checked_framework_probe_DEX\tPASS\nindependent_disassembly\tPASS\nART\tNOT_RUN\nGoogle_results\tNOT_RUN\n' > "$evidence/receipt.tsv"
