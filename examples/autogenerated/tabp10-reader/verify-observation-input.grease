#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'requires IB SOURCE_SHA ARTIFACT_ID ARCHIVE_SHA256 NEW_INPUT NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var source = ARGV[1]
var artifact = ARGV[2]
var digest = ARGV[3]
var input = ARGV[4]
var evidence = ARGV[5]
printf '%s\n' "$source" | rg -x '[0-9a-f]{40}'
printf '%s\n' "$artifact" | rg -x '[1-9][0-9]{0,19}'
if (digest.startsWith('sha256:')) { setvar digest = digest[7:] }
printf '%s\n' "$digest" | rg -x '[0-9a-f]{64}'
if test -e "$input" { echo 'FAIL reused Android candidate input' >&2; exit 2 }
if test -e "$evidence" { echo 'FAIL reused Android input evidence' >&2; exit 2 }
for path in "$repository" "$input" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
mkdir -p "$evidence" "$input"
var authorization = ENV.GITHUB_TOKEN
# The scheduler supplies the same run's upload id and digest. Authorization is
# sent only to the fixed GitHub endpoint and is never printed.
curl --fail --location --silent --show-error --max-time 300 --max-filesize 2147483648 \
  --header "Authorization: Bearer $authorization" \
  "https://api.github.com/repos/isomorphisms/ib/actions/artifacts/$artifact/zip" --output "$evidence/candidate.zip"
printf '%s  %s\n' "$digest" "$evidence/candidate.zip" | sha256sum -c -
var archive_bytes = $(wc -c < "$evidence/candidate.zip")
unzip -Z1 "$evidence/candidate.zip" > "$evidence/entries.txt"
awk 'substr($0,1,1)=="/" || $0~/(^|\/)\.\.(\/|$)/ {exit 1}' "$evidence/entries.txt"
unzip -q "$evidence/candidate.zip" -d "$input"
test "$(git -C "$repository" rev-parse HEAD)" = "$source"
test "$(cat "$input/ib-commit.txt")" = "$source"
test "$(cat "$input/native-client/ib-commit.txt")" = "$source"
test "$(cat "$input/native-client/backend-commit.txt")" = 9861b303a7e6d989125d80cee552a46cb2503555
test "$(cat "$input/native-client/frontend-commit.txt")" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(cat "$input/native-client/observer-commit.txt")" = 210e6a013691986674a6259f91d1f786e68734de
test "$(git -C "$repository/.tools/reader-acceptance" rev-parse HEAD)" = 210e6a013691986674a6259f91d1f786e68734de
for name in ib-native-boundary.apk ib-native-uid-bypass.apk ib-native-death-noop.apk \
  ib-native-strict-flags.apk ib-native-stale-authorization.apk ib-native-anchor-zero.apk \
  ib-native-resume-noop.apk ib-native-detach-any.apk {
  var expected = $(awk -v name="$name" '{n=split($2,p,"/"); if(p[n]==name)print $1}' "$input/native-client/sha256.txt")
  printf '%s\n' "$expected" | rg -x '[0-9a-f]{64}'
  printf '%s  %s\n' "$expected" "$input/native-client/$name" | sha256sum -c -
}
printf 'schema\tib-same-run-Android-input-v1\nsource\t%s\nartifact\t%s\narchive_sha256\t%s\narchive_bytes\t%s\nsource_identity\tPASS\nproducer_APK_digests\tPASS\nrecompilation\tNONE\nAndroid\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' \
  "$source" "$artifact" "$digest" "$archive_bytes" > "$evidence/receipt.tsv"
sha256sum "$input/native-client/ib-native-boundary.apk" "$input/native-client/activity.dex" \
  "$input/native-client/platform.dex" "$input/native-client/payload/lib/x86_64/libib_reader.so" \
  "$input/native-client/payload/lib/armeabi-v7a/libib_reader.so" \
  "$input/native-client/payload/lib/arm64-v8a/libib_reader.so" > "$evidence/candidate.sha256"
df -PB1 "$evidence" > "$evidence/host-capacity.txt"
cat "$evidence/receipt.tsv"
