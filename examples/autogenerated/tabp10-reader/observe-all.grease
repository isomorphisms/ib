#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease observe-all.grease IB INPUT SDK API NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var api = ARGV[3]
var evidence = ARGV[4]
var grease = ENV.IB_GREASE
var compiler = ENV.AICI_FIXTURE_ICK
if (api !== '29' and api !== '34') { exit 2 }
if (api !== ENV.AICI_EXPECTED_ANDROID_API) { exit 2 }
if test -e "$evidence" { echo 'FAIL reused observation evidence' >&2; exit 2 }
mkdir -p "$evidence"
var adb = "$sdk/platform-tools/adb"
var acceptance = "$repository/.tools/reader-acceptance"
# Keep the component, parcel, installed-reader and navigation observers required. A semantic refusal/ART crash must not
# suppress independent diagnostics of the installed application's real path.
var failed = false
try {
  "$grease" "$repository/examples/autogenerated/tabp10-reader/observe.grease" \
    "$repository" "$input" "$adb" "$evidence/core"
}
var core_status = _error.code
try {
  "$grease" "$repository/examples/autogenerated/tabp10-reader/observe-reflow.grease" \
    "$adb" emulator-5554 "$input" "$evidence/source-reflow"
}
var reflow_status = _error.code
if (reflow_status !== 0) { setglobal failed = true }
try {
  "$grease" "$repository/.tools/reader-acceptance/ib-source/reader/observe-large-source.grease" \
    "$repository/.tools/reader-acceptance" "$input" "$input/oracles/smali.jar" \
    "$adb" emulator-5554 "$evidence/large-source"
}
var large_status = _error.code
if (large_status !== 0) { setglobal failed = true }
if (core_status !== 0) { setglobal failed = true }
try {
  "$grease" "$acceptance/ib-source/shizuku/observe-parcelable.grease" \
    "$acceptance" "$input/parcelable" "$input/oracles/smali.jar" \
    "$adb" emulator-5554 "$evidence/parcelable"
}
var parcel_status = _error.code
if (parcel_status !== 0) { setglobal failed = true }
try {
  "$grease" "$acceptance/ib-source/shizuku/observe-installed.grease" \
    "$acceptance" "$input/native-client" "$input/oracles/smali.jar" "$sdk" \
    "$input/platform-inputs/public-test-keystore" "$input/platform-inputs/shizuku-official.apk" \
    "$adb" emulator-5554 "$evidence/installed" reader-v2
}
var reader_status = _error.code
if (reader_status !== 0) { setglobal failed = true }
var navigation_status = 125
if (reader_status === 0) {
  try {
    "$grease" "$acceptance/ib-source/shizuku/observe-navigation.grease" \
      "$acceptance" "$input" "$sdk" "$compiler" "$adb" emulator-5554 \
      "$evidence/installed" "$evidence/navigation" reader-v4
  }
  setvar navigation_status = _error.code
}
if (navigation_status !== 0) { setglobal failed = true }
printf 'schema\tib-required-observers-v2\napi\t%s\ncore_exit\t%s\nsource_reflow_exit\t%s\nlarge_source_exit\t%s\nparcelable_exit\t%s\ninstalled_exit\t%s\nnavigation_exit\t%s\n' \
  "$api" "$core_status" "$reflow_status" "$large_status" "$parcel_status" "$reader_status" "$navigation_status" > "$evidence/required.tsv"
if (failed) { exit 1 }
