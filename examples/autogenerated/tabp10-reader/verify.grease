#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease verify.grease IB BACKEND FRONTEND PREPARED_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var backend = ARGV[1]
var frontend = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$backend" "$frontend" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
test -s "$evidence/compiler.sha256"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
var driver = "$backend/dex/idric/build/exec/idric-dex"
var acceptance = "$repository/.tools/presentation-acceptance"
var contrast = "$acceptance/examples/autogenerated/charcoal-contrast"
var shared_theme = "$repository/.tools/charcoal/native/presentation"
"$IB_GREASE" "$acceptance/charcoal/test-tokens.grease" "$IB_GREASE" "$shared_theme" "$evidence/charcoal-tokens"
mkdir -p "$evidence/charcoal-contrast"
try {
  "$frontend/_/build/exec/idris2" --source-dir "$contrast" \
    --build-dir "$evidence/charcoal-contrast/build" --output-dir "$evidence/charcoal-contrast" \
    "$contrast/CharcoalContrast.idric" -o contrast > "$evidence/charcoal-contrast/compiler.txt" 2>&1
}
if (_error.code !== 0) { cat "$evidence/charcoal-contrast/compiler.txt"; exit 1 }
"$evidence/charcoal-contrast/contrast" > "$evidence/charcoal-contrast/actual.txt"
rg -x -F 'PASS conservative integer WCAG AA charcoal text contrast and targeted negatives' "$evidence/charcoal-contrast/actual.txt"
mkdir -p "$evidence/source"
cp -R "$repository/src/IB" "$evidence/source/IB"
cp "$repository/examples/autogenerated/native-source-projection/NativeSourceProjection.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/chordsearch/SearchIntentRequest.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/native-reader/NativeReader.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/tabp10-reader/ReaderProjection.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/tabp10-reader/HistoryProjection.idric" "$evidence/source/"
cp "$repository/examples/autogenerated/tabp10-reader/SelectionProjection.idric" "$evidence/source/"
cp "$repository/src/SourceReflowSmoke.idric" "$evidence/source/"
cp "$repository/src/HtmlAnchorSmoke.idric" "$evidence/source/"
# The actual maintained program first supplies its literal semantic result
# under the canonical frontend runtime. DEX compilation is a distinct check.
mkdir -p "$evidence/host-anchors"
try {
  "$frontend/_/build/exec/idris2" --source-dir "$evidence/source" \
    --build-dir "$evidence/host-anchors/build" --output-dir "$evidence/host-anchors" \
    "$evidence/source/HtmlAnchorSmoke.idric" -o anchor-check > "$evidence/host-anchors/compiler.txt" 2>&1
}
var anchor_host_compile = _error.code
if (anchor_host_compile !== 0) { cat "$evidence/host-anchors/compiler.txt"; exit "$anchor_host_compile" }
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/host-anchors/compiler.txt" { exit 1 }
try { "$evidence/host-anchors/anchor-check" > "$evidence/host-anchors/actual.txt" 2> "$evidence/host-anchors/stderr.txt" }
var anchor_host_run = _error.code
cat "$evidence/host-anchors/actual.txt"
cat "$evidence/host-anchors/stderr.txt"
printf 'compile_exit\t%s\nrun_exit\t%s\n' "$anchor_host_compile" "$anchor_host_run" > "$evidence/host-anchors/receipt.tsv"
if (anchor_host_run !== 0) { echo 'FAIL maintained anchor host semantics' >&2; exit 1 }
printf 'True\n' > "$evidence/host-anchors/expected.txt"
cmp "$evidence/host-anchors/expected.txt" "$evidence/host-anchors/actual.txt"
proc emit(module, lane, mode, source) {
  var destination = "$evidence/$lane"
  if test -e "$destination" { echo "FAIL reused consumer output: $lane" >&2; exit 2 }
  mkdir -p "$destination"
  var directives = []
  if (mode !== 'command') { setvar directives = ['--directive', mode] }
  try {
    "$driver" --cg dex @directives --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/$module.idric" -o reader > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf 'compiler_exit\t%s\n' "$status" > "$destination/result.tsv"
  cat "$destination/compiler.txt"
  if (status !== 0) {
    test ! -e "$destination/reader.dex"
    printf '%s\tFAIL\n' "$lane" >> "$evidence/stages.tsv"
    echo "FAIL maintained IB consumer: $lane" >&2
    exit 1
  }
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$destination/compiler.txt" {
    echo 'FAIL compiler diagnostics despite zero status' >&2; exit 1
  }
  test -s "$destination/reader.dex"
  java -jar "$evidence/oracles/baksmali.jar" disassemble "$destination/reader.dex" -o "$destination/decoded"
  sha256sum "$destination/reader.dex" > "$destination/output.sha256"
  printf '%s\tPASS\n' "$lane" >> "$evidence/stages.tsv"
}
emit HtmlAnchorSmoke html-anchors command "$evidence/source"
emit HtmlAnchorSmoke html-anchors-repeat command "$evidence/source"
cmp "$evidence/html-anchors/reader.dex" "$evidence/html-anchors-repeat/reader.dex"
for mutation in offset percent {
  var changed = "$evidence/html-anchors-$mutation-source"
  cp -R "$evidence/source" "$changed"
  if (mutation === 'offset') {
    sed 's/Right (block, anchor.within_item)/Right (block, 0)/' \
      "$evidence/source/IB/HtmlAnchors.idric" > "$changed/IB/HtmlAnchors.idric"
  } else {
    sed 's/Just characters ⇒ Right (pack characters)/Just characters ⇒ Right encoded/' \
      "$evidence/source/IB/HtmlAnchors.idric" > "$changed/IB/HtmlAnchors.idric"
  }
  if cmp -s "$evidence/source/IB/HtmlAnchors.idric" "$changed/IB/HtmlAnchors.idric" {
    echo 'FAIL unchanged fragment source mutant' >&2; exit 1
  }
  emit HtmlAnchorSmoke "html-anchors-$mutation-mutant" command "$changed"
  if cmp -s "$evidence/html-anchors/reader.dex" "$evidence/html-anchors-$mutation-mutant/reader.dex" {
    echo 'FAIL fragment mutation emitted unchanged DEX' >&2; exit 1
  }
}
emit SourceReflowSmoke source-reflow command "$evidence/source"
emit SourceReflowSmoke source-reflow-repeat command "$evidence/source"
cmp "$evidence/source-reflow/reader.dex" "$evidence/source-reflow-repeat/reader.dex"
for mutation in boundary generation pruning coordinates {
  var changed = "$evidence/source-reflow-$mutation-source"
  cp -R "$evidence/source" "$changed"
  var original = "$evidence/source/IB/Reflow/Source.idric"
  var destination = "$changed/IB/Reflow/Source.idric"
  if (mutation === 'boundary') {
    setvar original = "$evidence/source/IB/Reflow/SourceBreaks.idric"
    setvar destination = "$changed/IB/Reflow/SourceBreaks.idric"
    sed 's/else not (hard_line_end previous rest) \&\&/else True \&\&/' "$original" > "$destination"
  } elif (mutation === 'generation') {
    setvar original = "$evidence/source/IB/Reflow/SourceBreaks.idric"
    setvar destination = "$changed/IB/Reflow/SourceBreaks.idric"
    sed 's/if safe_boundary value rest kind/if True/' "$original" > "$destination"
  } elif (mutation === 'pruning') {
    sed 's/if terminal candidate.cut.break_kind || base_advance start candidate > width/if True/' "$original" > "$destination"
  } else {
    sed 's/FromSource start finish (display_break_mark/FromSource 0 finish (display_break_mark/' "$original" > "$destination"
  }
  if cmp -s "$original" "$destination" { echo 'FAIL unchanged source reflow mutation' >&2; exit 1 }
  emit SourceReflowSmoke "source-reflow-$mutation-mutant" command "$changed"
  if cmp -s "$evidence/source-reflow/reader.dex" "$evidence/source-reflow-$mutation-mutant/reader.dex" {
    echo 'FAIL reflow mutation emitted positive DEX' >&2; exit 1
  }
}
emit NativeSourceProjection projection managed-exports "$evidence/source"
emit SearchIntentRequest search managed-exports "$evidence/source"
emit NativeReader activity managed-exports "$evidence/source"
emit TextNumberCast number-casts managed-exports "$backend/examples/autogenerated/text-number-casts"
emit ReaderProjection prepaint managed-exports "$evidence/source"
emit ReaderProjection prepaint-repeat managed-exports "$evidence/source"
emit HistoryProjection history managed-exports "$evidence/source"
emit HistoryProjection history-repeat managed-exports "$evidence/source"
emit SelectionProjection selection managed-exports "$evidence/source"
emit SelectionProjection selection-repeat managed-exports "$evidence/source"
cmp "$evidence/selection/reader.dex" "$evidence/selection-repeat/reader.dex"
cmp "$evidence/history/reader.dex" "$evidence/history-repeat/reader.dex"
cmp "$evidence/prepaint/reader.dex" "$evidence/prepaint-repeat/reader.dex"
rg -q '^\.super Landroid/app/Activity;' "$evidence/activity/decoded/Idric/Generated.smali"
cp -R "$evidence/source" "$evidence/selector-source"
cp -R "$evidence/source" "$evidence/admission-source"
cp -R "$evidence/source" "$evidence/title-source"
mkdir -p "$evidence/number-mutant-source"
sed 's/integer_text supplied = show (cast {to = Integer} supplied)/integer_text supplied = "0"/' \
  "$backend/examples/autogenerated/text-number-casts/TextNumberCast.idric" > "$evidence/number-mutant-source/TextNumberCast.idric"
if cmp -s "$backend/examples/autogenerated/text-number-casts/TextNumberCast.idric" "$evidence/number-mutant-source/TextNumberCast.idric" {
  echo 'FAIL unchanged numeric source mutation' >&2; exit 1
}
emit TextNumberCast number-casts-mutant managed-exports "$evidence/number-mutant-source"
if cmp -s "$evidence/number-casts/reader.dex" "$evidence/number-casts-mutant/reader.dex" {
  echo 'FAIL numeric mutation emitted positive DEX' >&2; exit 1
}
sed 's/(if algorithm ≟ 0 then promptly else evenly)/promptly/' \
  "$evidence/source/ReaderProjection.idric" > "$evidence/selector-source/ReaderProjection.idric"
sed 's/case source_admission_reason admission of/case the (Maybe String) Nothing of/' \
  "$evidence/source/IB/HtmlPrepaint.idric" > "$evidence/admission-source/IB/HtmlPrepaint.idric"
sed 's/source_title source = view_title/source_title source = const ""/' \
  "$evidence/source/NativeSourceProjection.idric" > "$evidence/title-source/NativeSourceProjection.idric"
for mutation in selector admission title {
  var original = "$evidence/source/ReaderProjection.idric"
  var changed = "$evidence/$mutation-source/ReaderProjection.idric"
  if (mutation === 'admission') {
    setvar original = "$evidence/source/IB/HtmlPrepaint.idric"
    setvar changed = "$evidence/admission-source/IB/HtmlPrepaint.idric"
  }
  if (mutation === 'title') {
    setvar original = "$evidence/source/NativeSourceProjection.idric"
    setvar changed = "$evidence/title-source/NativeSourceProjection.idric"
  }
  if cmp -s "$original" "$changed" { echo "FAIL unchanged source mutation: $mutation" >&2; exit 1 }
}
emit ReaderProjection prepaint-selector-mutant managed-exports "$evidence/selector-source"
emit ReaderProjection prepaint-admission-mutant managed-exports "$evidence/admission-source"
emit NativeSourceProjection title-mutant managed-exports "$evidence/title-source"
for lane in prepaint-selector-mutant prepaint-admission-mutant {
  if cmp -s "$evidence/prepaint/reader.dex" "$evidence/$lane/reader.dex" {
    echo "FAIL semantic mutation emitted positive DEX: $lane" >&2; exit 1
  }
}
for mutation in branch cursor generation {
  var changed = "$evidence/history-$mutation-source"
  cp -R "$evidence/source" "$changed"
  var original = "$evidence/source/IB/Reader/Navigation.idric"
  var destination = "$changed/IB/Reader/Navigation.idric"
  if (mutation === 'branch') {
    sed 's/take (S cursor) visits ++ \[source\]/visits ++ [source]/' "$original" > "$destination"
  } elif (mutation === 'cursor') {
    sed 's/if (null visits && cursor ≟ 0) || cursor < length visits/if True/' "$original" > "$destination"
  } else {
    sed 's/text <= "2147483647"/text <= "4294967295"/' "$original" > "$destination"
  }
  if cmp -s "$original" "$destination" { echo 'FAIL unchanged history mutation' >&2; exit 1 }
  emit HistoryProjection "history-$mutation-mutant" managed-exports "$changed"
  if cmp -s "$evidence/history/reader.dex" "$evidence/history-$mutation-mutant/reader.dex" {
    echo 'FAIL history mutation emitted the positive candidate' >&2; exit 1
  }
}
for mutation in surrogate verification {
  var changed = "$evidence/selection-$mutation-source"
  cp -R "$evidence/source" "$changed"
  var original = "$evidence/source/IB/Reader/Selection.idric"
  var destination = "$changed/IB/Reader/Selection.idric"
  if (mutation === 'surrogate') {
    sed 's/ord character > 65535/ord character > 1114111/' "$original" > "$destination"
  } else {
    sed 's/not (verify_rows 0 0 (unpack source) (unpack displayed) rows)/False/' "$original" > "$destination"
  }
  if cmp -s "$original" "$destination" { echo 'FAIL unchanged selection mutation' >&2; exit 1 }
  emit SelectionProjection "selection-$mutation-mutant" managed-exports "$changed"
  if cmp -s "$evidence/selection/reader.dex" "$evidence/selection-$mutation-mutant/reader.dex" {
    echo 'FAIL selection mutation emitted the positive candidate' >&2; exit 1
  }
}
cp -R "$evidence/source" "$evidence/activity-copy-source"
sed 's/copy_reader_selection = copy_source_selection/copy_reader_selection source displayed coordinates first after = displayed/' \
  "$evidence/source/NativeReader.idric" > "$evidence/activity-copy-source/NativeReader.idric"
if cmp -s "$evidence/source/NativeReader.idric" "$evidence/activity-copy-source/NativeReader.idric" {
  echo 'FAIL unchanged actual Activity copy mutation' >&2; exit 1
}
emit NativeReader activity-copy-mutant managed-exports "$evidence/activity-copy-source"
if cmp -s "$evidence/activity/reader.dex" "$evidence/activity-copy-mutant/reader.dex" {
  echo 'FAIL actual Activity copy mutation emitted the positive candidate' >&2; exit 1
}

cp -R "$evidence/source" "$evidence/activity-journal-source"
sed 's/Left _ ⇒ 0/Left _ ⇒ 1/g' "$evidence/source/NativeReader.idric" > "$evidence/activity-journal-source/NativeReader.idric"
if cmp -s "$evidence/source/NativeReader.idric" "$evidence/activity-journal-source/NativeReader.idric" {
  echo 'FAIL unchanged checked journal source mutation' >&2; exit 1
}
emit NativeReader activity-journal-mutant managed-exports "$evidence/activity-journal-source"
if cmp -s "$evidence/activity/reader.dex" "$evidence/activity-journal-mutant/reader.dex" {
  echo 'FAIL journal mutation emitted positive Activity DEX' >&2; exit 1
}
for mutation in limit unicode {
  var changed = "$evidence/query-$mutation-source"
  cp -R "$evidence/source" "$changed"
  var original = "$evidence/source/NativeReader.idric"
  var destination = "$changed/NativeReader.idric"
  if (mutation === 'limit') {
    sed 's/if units > 1024/if units > 4096/' "$original" > "$destination"
  } else {
    sed 's/if valid_unicode ≟ 0/if False/' "$original" > "$destination"
  }
  if cmp -s "$original" "$destination" { echo 'FAIL unchanged actual query mutation' >&2; exit 1 }
  emit NativeReader "activity-query-$mutation-mutant" managed-exports "$changed"
  if cmp -s "$evidence/activity/reader.dex" "$evidence/activity-query-$mutation-mutant/reader.dex" {
    echo 'FAIL actual query mutation emitted positive DEX' >&2; exit 1
  }
}
for mutation in gate mapping count carrier {
  var changed = "$evidence/decoding-$mutation-source"
  cp -R "$evidence/source" "$changed"
  var original = "$evidence/source/IB/HtmlPrepaint.idric"
  var destination = "$changed/IB/HtmlPrepaint.idric"
  if (mutation === 'gate') {
    sed 's/case source_identity_reason admission of/case the (Maybe String) Nothing of/' "$original" > "$destination"
  } elif (mutation === 'count') {
    sed 's/if cast decoded.original_byte_count \/= admission.reopened_bytes/if False/' "$original" > "$destination"
  } else {
    setvar original = "$evidence/source/IB/SourceDecoding.idric"
    setvar destination = "$changed/IB/SourceDecoding.idric"
    if (mutation === 'mapping') {
      sed 's/128 ⇒ 0x20AC/128 ⇒ 0x0080/' "$original" > "$destination"
    } else {
      sed 's/if ord character <= 255/if True/' "$original" > "$destination"
    }
  }
  if cmp -s "$original" "$destination" { echo 'FAIL unchanged decoded-source mutation' >&2; exit 1 }
  emit ReaderProjection "prepaint-decoding-$mutation-mutant" managed-exports "$changed"
  if cmp -s "$evidence/prepaint/reader.dex" "$evidence/prepaint-decoding-$mutation-mutant/reader.dex" {
    echo 'FAIL decoded-source mutation emitted positive bytes' >&2; exit 1
  }
}
printf 'determinism\tPASS\nindependent_decode\tPASS\nART\tNOT_RUN\nBinder\tNOT_RUN\nAPK\tNOT_RUN\nphysical_TAB_P10\tBLOCKED\n' >> "$evidence/stages.tsv"
cat "$evidence/stages.tsv"
