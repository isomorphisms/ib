#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'requires IB OBSERVER_CHECKOUT NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var checkout = ARGV[1]
var evidence = ARGV[2]
var grease = ENV.IB_GREASE
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence"
var actual = $(git -C "$checkout" rev-parse HEAD)
printf '%s\n' "$actual" > "$evidence/metadata"
"$grease" "$repository/examples/autogenerated/tabp10-reader/verify-observer-pin.grease" \
  "$evidence/metadata" "$checkout" "$actual" > "$evidence/positive.txt"
printf '0000000000000000000000000000000000000000\n' > "$evidence/changed-metadata"
try {
  "$grease" "$repository/examples/autogenerated/tabp10-reader/verify-observer-pin.grease" \
    "$evidence/changed-metadata" "$checkout" "$actual" > "$evidence/changed-metadata.txt" 2>&1
}
if (_error.code !== 1) { exit 1 }
rg -x -F 'FAIL candidate build observer differs from the immutable qualification pin' "$evidence/changed-metadata.txt"
try {
  "$grease" "$repository/examples/autogenerated/tabp10-reader/verify-observer-pin.grease" \
    "$evidence/metadata" "$repository" "$actual" > "$evidence/changed-checkout.txt" 2>&1
}
if (_error.code !== 1) { exit 1 }
rg -x -F 'FAIL independent Android observer checkout differs from the immutable qualification pin' "$evidence/changed-checkout.txt"
printf 'runtime_matching_observer_pin\tPASS\nchanged_build_metadata\tREJECTED\nchanged_observer_checkout\tREJECTED\n' > "$evidence/receipt.tsv"
