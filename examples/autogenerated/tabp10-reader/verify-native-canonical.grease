#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify-native-canonical.grease IB APPENDFAT QUALIFIED_ICK NATIVE_EVIDENCE NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var appendfat = ARGV[1]
var compiler = ARGV[2]
var native = ARGV[3]
var evidence = ARGV[4]
for path in "$repository" "$appendfat" "$compiler" "$native" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused canonical evidence' >&2; exit 2 }
test "$(git -C "$appendfat" rev-parse HEAD)" = 05a0cb7246c5a9f46abfbe92925812e7b607f454
test -s "$native/stages.tsv"
test -x "$native/source-owner-test"
test -x "$native/wrong-generation-test"
mkdir -p "$evidence"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "$appendfat/lib/appendfat_arena.c" "$appendfat/tools/appendfat_arena.c" \
  -o "$evidence/appendfat-arena"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "$repository/native/android/ib_arena_slice.c" -o "$evidence/arena-slice"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -pthread \
  -I "$appendfat/lib" "$appendfat/lib/appendfat_arena.c" \
  "$repository/native/android/ib_reader_pfd.c" \
  "$repository/native/android/ib_shizuku_arena_ingress.c" \
  "$repository/native/android/ib_shizuku_arena_publish.c" \
  "$repository/native/android/ib_arena_source_owner.c" \
  "$repository/tests/test_shizuku_frame_canonical.c" -o "$evidence/frame-test"
env IB_APPEND_ARENA="$evidence/appendfat-arena" IB_INGRESS_CANONICAL_TEST="$evidence/frame-test" \
  sh "$repository/tests/test_shizuku_ingress_canonical.sh" > "$evidence/frame.txt" 2>&1
cat "$evidence/frame.txt"
rg -F 'PASS: ordered response-owner redirect chain' "$evidence/frame.txt"
rg -F 'PASS: immutable receipt collision refuses replacement and preserves previous source' "$evidence/frame.txt"
sed 's/#define IB_RECEIPT_NOREPLACE 1U/#define IB_RECEIPT_NOREPLACE 0U/' \
  "$repository/native/android/ib_shizuku_arena_publish.c" > "$evidence/receipt-replace-mutant.c"
if cmp -s "$repository/native/android/ib_shizuku_arena_publish.c" "$evidence/receipt-replace-mutant.c" {
  echo 'FAIL unchanged immutable receipt mutation' >&2; exit 1
}
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -pthread \
  -I "$appendfat/lib" -I "$repository/native/android" "$appendfat/lib/appendfat_arena.c" \
  "$repository/native/android/ib_reader_pfd.c" "$repository/native/android/ib_shizuku_arena_ingress.c" \
  "$evidence/receipt-replace-mutant.c" "$repository/native/android/ib_arena_source_owner.c" \
  "$repository/tests/test_shizuku_frame_canonical.c" -o "$evidence/receipt-replace-mutant"
ulimit -c 0
try {
  env IB_APPEND_ARENA="$evidence/appendfat-arena" IB_INGRESS_CANONICAL_TEST="$evidence/receipt-replace-mutant" \
    sh "$repository/tests/test_shizuku_ingress_canonical.sh" > "$evidence/receipt-replace-mutant.txt" 2>&1
}
if (_error.code !== 134) { echo 'FAIL receipt replacement mutant missed its intended assertion' >&2; exit 1 }
rg -x -F 'STAGE immutable receipt no-replace preserves previous bytes' "$evidence/receipt-replace-mutant.txt"
rg -F 'Assertion' "$evidence/receipt-replace-mutant.txt" | rg -F 'publication != 0'
var oracle = "$repository/.tools/reader-acceptance/ib-source/verify.sh"
test -s "$oracle"
env IB_APPEND_ARENA="$evidence/appendfat-arena" IB_ARENA_SLICE="$evidence/arena-slice" \
  IB_TEST_VERIFIED_ARENA_PIPE="$native/source-owner-test" IB_AICI_SOURCE_VERIFY="$oracle" \
  sh "$repository/tests/test_android_arena_source_owner.sh" > "$evidence/readback.txt" 2>&1
cat "$evidence/readback.txt"
rg -x -F 'checked_arena=actual_appends' "$evidence/readback.txt"
rg -F 'PASS: retained source generation stays immutable' "$evidence/readback.txt"
ulimit -c 0
try {
  env IB_APPEND_ARENA="$evidence/appendfat-arena" IB_ARENA_SLICE="$evidence/arena-slice" \
    IB_TEST_VERIFIED_ARENA_PIPE="$native/wrong-generation-test" IB_AICI_SOURCE_VERIFY="$oracle" \
    sh "$repository/tests/test_android_arena_source_owner.sh" > "$evidence/wrong-generation.txt" 2>&1
}
if (_error.code !== 134) { echo 'FAIL canonical retained-generation mutant was not rejected' >&2; exit 1 }
rg -x -F 'STAGE retained source generation 1 at navigation generation 3' "$evidence/wrong-generation.txt"
rg -F 'Assertion' "$evidence/wrong-generation.txt" | rg -F 'ib_arena_source_owner_open_retained'
git -C "$appendfat" rev-parse HEAD > "$evidence/appendfat-commit.txt"
sha256sum "$compiler" "$evidence/appendfat-arena" "$evidence/arena-slice" \
  "$repository/native/android/ib_shizuku_arena_publish.c" "$repository/tests/test_shizuku_frame_canonical.c" \
  "$evidence/frame-test" "$evidence/receipt-replace-mutant" "$native/source-owner-test" "$native/wrong-generation-test" > "$evidence/sha256.txt"
printf 'host_canonical_userspace_append\tPASS\nhost_redirect_chain_boundary\tPASS\nimmutable_receipt_no_replace\tPASS\ncompiled_receipt_replacement_mutant\tREJECTED\nindependent_source_oracle\tPASS\nretained_source_readback\tPASS\ncompiled_generation_mutant\tREJECTED\nreal_response_metadata\tNOT_RUN\nAndroid_Binder\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/stages.tsv"
