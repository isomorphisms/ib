#!/usr/bin/env grease

# IB owns this source acceptance step. The pinned dependency owns the emitter
# and the external ART runners; neither is reimplemented here.
proc usage() {
  echo 'usage: grease verify.grease host IB_REPOSITORY IDRIC_REPOSITORY DEXDUMP UPSTREAM_EVIDENCE IB_EVIDENCE EXPECTED_IB_HEAD'
  echo '   or: grease verify.grease art IB_REPOSITORY UPSTREAM_EVIDENCE IB_EVIDENCE'
  exit 2
}

proc require_file(path) {
  if ! test -s "$path" {
    echo "FAIL required artifact is absent or empty: $path"
    exit 1
  }
}

proc require_absolute(path) {
  if (path[0] !== '/') {
    echo "FAIL absolute path required: $path"
    exit 2
  }
}

proc require_clean_log(path) {
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$path" {
    echo "FAIL compiler reported an error: $path"
    exit 1
  }
}

if (len(ARGV) < 1) {
  usage
}

if (ARGV[0] === 'host') {
  if (len(ARGV) !== 7) {
    usage
  }
  var repository = ARGV[1]
  var compiler_repository = ARGV[2]
  var dexdump = ARGV[3]
  var upstream_evidence = ARGV[4]
  var evidence = ARGV[5]
  var expected_head = ARGV[6]
  for path in "$repository" "$compiler_repository" "$dexdump" "$upstream_evidence" "$evidence" {
    require_absolute "$path"
  }
  if test -e "$evidence" {
    echo "FAIL evidence directory already exists: $evidence"
    exit 1
  }
  mkdir -p "$evidence"
  var upstream = "$repository/vendor/android-NDK"
  var source_directory = "$repository/examples/autogenerated/quick-settings-runtime"
  var source = "$source_directory/PensieveQuickSettingsRuntime.idric"
  var compiler = "$compiler_repository/_/build/exec/idris2"
  var compiler_prefix = "$compiler_repository/_/bootstrap-build"
  var driver = "$upstream_evidence/backend/exec/idric-dex"
  var base_modules = "$compiler_repository/_/libs/base/build/ttc"
  var prelude_modules = "$compiler_repository/_/libs/prelude/build/ttc"

  test "$(git -C "$repository" rev-parse HEAD)" = "$expected_head"
  test "$(git -C "$repository" config --file .gitmodules --get submodule.vendor/android-NDK.url)" = 'https://github.com/isomorphisms/android-NDK.git'
  test "$(git -C "$upstream" remote get-url origin)" = 'https://github.com/isomorphisms/android-NDK.git'
  test "$(git -C "$upstream" rev-parse HEAD)" = "$(git -C "$repository" rev-parse HEAD:vendor/android-NDK)"
  test "$(git -C "$compiler_repository" rev-parse HEAD)" = 'ff4d852862a3942592f8ade9afde8d409d9803be'
  git -C "$repository" diff --exit-code HEAD -- .gitmodules vendor/android-NDK examples/autogenerated/quick-settings-runtime .github/workflows/pensieve-quick-settings.yml > "$evidence/ib-clean.txt"
  git -C "$upstream" diff --exit-code HEAD > "$evidence/dependency-clean.txt"
  git -C "$compiler_repository" diff --exit-code HEAD > "$evidence/compiler-clean.txt"
  test -x "$driver"
  test -x "$compiler"
  test -x "$dexdump"
  require_file "$compiler_prefix/idris2-0.8.0/idris2-0.8.0/idris2.ipkg"
  require_file "$source"
  require_file "$upstream_evidence/quick-settings.dex"
  rg -q -x -F 'PASS checked source emitted independently parsed DEX' "$upstream_evidence/host-result.txt"
  sha256sum -c "$upstream_evidence/dex-sha256.txt" > "$evidence/upstream-hashes.txt"

  git -C "$repository" rev-parse HEAD 'HEAD^{tree}' > "$evidence/ib-revision.txt"
  git -C "$upstream" rev-parse HEAD 'HEAD^{tree}' > "$evidence/dependency-revision.txt"
  git -C "$compiler_repository" rev-parse HEAD 'HEAD^{tree}' > "$evidence/compiler-revision.txt"
  "$compiler" --version > "$evidence/compiler-version.txt"
  env IDRIS2_PREFIX="$compiler_prefix" "$driver" --version > "$evidence/driver-version.txt"
  printf '%s\n' "$repository" "$compiler_repository" "$dexdump" "$upstream_evidence" "$evidence" "$expected_head" > "$evidence/host-arguments.txt"
  cp "$source" "$evidence/PensieveQuickSettingsRuntime.idric"
  sha256sum "$source" "$source_directory/verify.grease" \
    "$upstream/examples/autogenerated/quick-settings-runtime/QuickSettingsRuntime.idric" \
    "$upstream/examples/autogenerated/quick-settings-runtime/QuickSettingsRunner.smali" \
    "$upstream/quick-settings/idric/src/Android/QuickSettings.idric" \
    "$upstream/quick-settings/idric/src/Android/QuickSettings/References.idric" \
    "$upstream/quick-settings/idric/src/Android/QuickSettings/Foreign.idric" \
    "$compiler" "$compiler_repository/_/build/exec/idris2_app/idris2.so" \
    "$driver" "$upstream_evidence/backend/exec/idric-dex_app/idric-dex.so" \
    "$evidence/PensieveQuickSettingsRuntime.idric" > "$evidence/input-sha256.txt"

  # A zero compiler exit alone is insufficient: historical rejection paths
  # exited zero. Require clean diagnostics and all fresh emitted artifacts.
  env IDRIS2_PREFIX="$compiler_prefix" \
    IDRIS2_PATH="$upstream_evidence/backend/ttc:$upstream_evidence/bindings/ttc:$base_modules:$prelude_modules" \
    "$driver" --cg dex --source-dir "$source_directory" \
    --build-dir "$evidence/source" --output-dir "$evidence" \
    --dumpanf "$evidence/pensieve-quick-settings.anf" "$source" -o pensieve-quick-settings \
    > "$evidence/pensieve-quick-settings.compile.txt" 2>&1
  require_clean_log "$evidence/pensieve-quick-settings.compile.txt"
  require_file "$evidence/pensieve-quick-settings.dex"
  require_file "$evidence/pensieve-quick-settings.dex.plan"
  require_file "$evidence/pensieve-quick-settings.checked.anf"
  require_file "$evidence/pensieve-quick-settings.smali"
  "$dexdump" -c "$evidence/pensieve-quick-settings.dex" > "$evidence/pensieve-quick-settings.checksum.txt" 2>&1
  "$dexdump" -d "$evidence/pensieve-quick-settings.dex" > "$evidence/pensieve-quick-settings.disassembly.txt" 2>&1
  cmp "$evidence/pensieve-quick-settings.dex" "$upstream_evidence/quick-settings.dex"

  sha256sum "$evidence/pensieve-quick-settings.dex" "$evidence/pensieve-quick-settings.dex.plan" \
    "$evidence/pensieve-quick-settings.checked.anf" "$evidence/pensieve-quick-settings.smali" \
    "$upstream_evidence/quick-settings.dex" > "$evidence/artifact-sha256.txt"
  cat "$evidence/input-sha256.txt" "$evidence/artifact-sha256.txt" > "$evidence/sha256.txt"
  echo 'PASS IB-owned source emitted checked DEX and passed independent dexdump parsing' > "$evidence/host-result.txt"
  echo 'PASS IB DEX is byte-identical to upstream quick-settings.dex' >> "$evidence/host-result.txt"
  echo 'NOT_RUN ART execution by this host stage' >> "$evidence/host-result.txt"
  cat "$evidence/host-result.txt"
} elif (ARGV[0] === 'art') {
  if (len(ARGV) !== 4) {
    usage
  }
  var repository = ARGV[1]
  var upstream_evidence = ARGV[2]
  var evidence = ARGV[3]
  for path in "$repository" "$upstream_evidence" "$evidence" {
    require_absolute "$path"
  }
  if test -e "$evidence/art" {
    echo "FAIL runtime evidence directory already exists: $evidence/art"
    exit 1
  }
  mkdir -p "$evidence/art"
  sha256sum -c "$evidence/sha256.txt" > "$evidence/art/host-hashes.txt"
  sha256sum -c "$upstream_evidence/dex-sha256.txt" > "$evidence/art/upstream-hashes.txt"
  rg -q -x -F 'PASS IB DEX is byte-identical to upstream quick-settings.dex' "$evidence/host-result.txt"
  rg -q -x -F 'PASS ART executed checked reference/effect/branch/range candidates on this emulator' "$upstream_evidence/art/result.txt"
  rg -q -x -F 'quick-settings source effects PASS' "$upstream_evidence/art/effects.txt"
  rg -q -x -F 'quick-settings callback payload PASS' "$upstream_evidence/art/quick-settings.txt"
  rg -q -x -F 'DEX invoke range PASS' "$upstream_evidence/art/invoke-range.txt"
  rg -q -x -F 'DEX Boolean ABI PASS' "$upstream_evidence/art/boolean.txt"
  cmp "$evidence/pensieve-quick-settings.dex" "$upstream_evidence/quick-settings.dex"
  cmp "$evidence/pensieve-quick-settings.dex" "$upstream_evidence/art/quick-settings-received.dex"
  cp "$upstream_evidence/art/fingerprint.txt" "$upstream_evidence/art/abi.txt" "$upstream_evidence/art/sdk.txt" "$upstream_evidence/art/quick-settings.txt" "$evidence/art/"
  sha256sum "$evidence/pensieve-quick-settings.dex" "$upstream_evidence/quick-settings.dex" \
    "$upstream_evidence/art/quick-settings-received.dex" \
    "$upstream_evidence/art/quick-settings-runner.dex" \
    "$upstream_evidence/art/quick-settings-runner-received.dex" > "$evidence/art/sha256.txt"
  echo 'PASS IB DEX bytes match the upstream Quick Settings candidate executed by the shared ART runner' > "$evidence/art/result.txt"
  echo 'Scope: byte identity plus upstream runner execution; no separate IB Android lifecycle was exercised' >> "$evidence/art/result.txt"
  echo 'NOT_RUN TileService lifecycle, tile registration, SystemUI, asynchronous callback dispatch, physical device' >> "$evidence/art/result.txt"
  cat "$evidence/art/result.txt"
} else {
  usage
}
