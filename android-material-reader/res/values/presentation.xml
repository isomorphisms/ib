<resources>
  <!-- Application-owned Material 3 baseline dark roles. The platform parent
       supplies Activity/window compatibility, not a Material 3 claim. -->
  <color name="reader_surface">#141218</color>
  <color name="reader_on_surface">#E6E0E9</color>
  <color name="reader_on_surface_variant">#CAC4D0</color>
  <color name="reader_primary">#D0BCFF</color>
  <color name="reader_on_primary">#381E72</color>
  <dimen name="reader_page_padding">16dp</dimen>
  <dimen name="reader_paragraph_spacing">16dp</dimen>
  <dimen name="reader_touch_height">48dp</dimen>
  <dimen name="reader_title_line_height">28sp</dimen>
  <dimen name="reader_body_line_height">24sp</dimen>
  <dimen name="reader_label_line_height">20sp</dimen>
  <style name="Theme.IB.Material3" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/reader_surface</item>
    <item name="android:colorAccent">@color/reader_primary</item>
    <item name="android:statusBarColor">@color/reader_surface</item>
    <item name="android:navigationBarColor">@color/reader_surface</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:buttonStyle">@style/ReaderSourceButton</item>
  </style>
  <style name="ReaderTitleLarge">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textFontWeight">400</item>
    <item name="android:textSize">22sp</item>
    <item name="android:letterSpacing">0</item>
    <item name="android:textColor">@color/reader_on_surface</item>
  </style>
  <style name="ReaderBodyLarge">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textFontWeight">400</item>
    <item name="android:textSize">16sp</item>
    <item name="android:letterSpacing">0.03125</item>
    <item name="android:textColor">@color/reader_on_surface</item>
  </style>
  <style name="ReaderLabelLarge">
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textFontWeight">500</item>
    <item name="android:textSize">14sp</item>
    <item name="android:letterSpacing">0.00714286</item>
    <item name="android:textColor">@color/reader_on_surface_variant</item>
  </style>
  <style name="ReaderButtonLabel" parent="ReaderLabelLarge">
    <item name="android:textColor">@color/reader_on_primary</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="ReaderSourceButton" parent="android:style/Widget.Material.Button">
    <item name="android:onClick">onClick</item>
    <item name="android:background">@drawable/reader_source_button</item>
    <item name="android:textAppearance">@style/ReaderButtonLabel</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:minWidth">64dp</item>
  </style>
</resources>
