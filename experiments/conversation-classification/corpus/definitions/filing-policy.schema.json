{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ib/conversation-filing-policy.schema.json",
  "title": "IB experimental conversation filing policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "version",
    "created_at",
    "provenance",
    "minimum_support",
    "ambiguity_gap",
    "destinations"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "string", "minLength": 1},
    "minimum_support": {"type": "number", "exclusiveMinimum": 0},
    "ambiguity_gap": {"type": "number", "minimum": 0},
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destination_id",
          "chatgpt_location",
          "concept_weights",
          "existing_location_weights"
        ],
        "properties": {
          "destination_id": {"type": "string", "minLength": 1},
          "chatgpt_location": {"type": "string", "minLength": 1},
          "concept_weights": {
            "type": "object",
            "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
          },
          "existing_location_weights": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
