#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)
. "$repository_root/lib/android_shizuku_host.grease"
. "$repository_root/lib/android_shizuku_worker_provider.grease"
. "$repository_root/lib/android_binder_host.grease"
. "$repository_root/lib/android_longview_worker.grease"

usage() {
  printf 'usage: %s start WORK RESULT LAUNCH HOST_GEN ATTEMPT ATTEMPT_NO immediate|delayed | status|read|observe WORK RESULT LAUNCH BOOT UID PID START NAME HOST_GEN ATTEMPT ATTEMPT_NO | signal WORK RESULT LAUNCH BOOT UID PID START NAME HOST_GEN ATTEMPT ATTEMPT_NO [SIGNAL]\n' "$0" >&2
}

command=${1:-}
test -n "$command" || {
  usage
  exit 2
}
shift

case "$command" in
  start)
    test "$#" -eq 7 || { usage; exit 2; }
    ib_longview_worker_start "$@"
    ;;
  status)
    test "$#" -eq 11 || { usage; exit 2; }
    ib_longview_worker_status "$@"
    ;;
  read)
    test "$#" -eq 11 || { usage; exit 2; }
    ib_longview_worker_read_result "$@"
    ;;
  observe)
    test "$#" -eq 11 || { usage; exit 2; }
    ib_longview_worker_observe "$@"
    ;;
  signal)
    if test "$#" -ne 11 && test "$#" -ne 12; then usage; exit 2; fi
    ib_longview_worker_signal_owned "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
